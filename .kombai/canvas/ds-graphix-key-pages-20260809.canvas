13l4 4L19 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                                </path>\n                            </svg>\n                        </div>\n                        <div data-kid=\"2-2-3-2-2-1-2\" data-name=\"feed item content\">\n                            <p class=\"text-sm font-medium text-black/70 leading-relaxed\" data-kid=\"2-2-3-2-2-1-2-1\" data-name=\"feed text\">\n                                <span class=\"font-bold text-black\" data-kid=\"2-2-3-2-2-1-2-1-1\" data-name=\"feed actor name\">\n                                    FinStream CEO\n                                </span>\n                                approved the final dashboard orchestration for production.\n                            </p>\n                            <p class=\"text-[9px] font-bold text-black/20 uppercase mt-2 tracking-widest\" data-kid=\"2-2-3-2-2-1-2-2\" data-name=\"timestamp\">\n                                2 Hours ago • verified\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-6\" data-kid=\"2-2-3-2-2-2\" data-name=\"activity feed item\">\n                        <div class=\"shrink-0 w-12 h-12 rounded-2xl bg-[var(--color-bg)] flex items-center justify-center border border-black/5\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"feed item indicator wrapper\">\n                            <div class=\"w-3 h-3 rounded-full bg-[var(--color-orange)] shadow-[0_0_10px_rgba(255,102,54,0.4)]\" data-kid=\"2-2-3-2-2-2-1-1\" data-name=\"activity status dot\">\n                            </div>\n                        </div>\n                        <div class=\"flex-1 pb-8 border-b border-black/5\" data-kid=\"2-2-3-2-2-2-2\" data-name=\"feed item content\">\n                            <p class=\"text-base text-[var(--color-dark)] font-medium leading-relaxed\" data-kid=\"2-2-3-2-2-2-2-1\" data-name=\"feed text\">\n                                <span class=\"font-extrabold\" data-kid=\"2-2-3-2-2-2-2-1-1\" data-name=\"feed bold prefix\">\n                                    Project Launched\n                                </span>\n                                : Quantum Social campaign reached 2M+ impressions.\n                            </p>\n                            <span class=\"text-[9px] font-black text-[var(--color-dark)]/30 uppercase tracking-widest mt-2 block\" data-kid=\"2-2-3-2-2-2-2-2\" data-name=\"timestamp label\">\n                                YESTERDAY • CAMPAIGN ENGINE\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-6\" data-kid=\"2-2-3-2-2-3\" data-name=\"activity feed item\">\n                        <div class=\"shrink-0 w-12 h-12 rounded-2xl bg-[var(--color-bg)] flex items-center justify-center border border-black/5\" data-kid=\"2-2-3-2-2-3-1\" data-name=\"feed item indicator wrapper\">\n                            <div class=\"w-3 h-3 rounded-full bg-blue-500 shadow-[0_0_10px_rgba(59,130,246,0.4)]\" data-kid=\"2-2-3-2-2-3-1-1\" data-name=\"activity status dot\">\n                            </div>\n                        </div>\n                        <div class=\"flex-1\" data-kid=\"2-2-3-2-2-3-2\" data-name=\"feed item content\">\n                            <p class=\"text-base text-[var(--color-dark)] font-medium leading-relaxed\" data-kid=\"2-2-3-2-2-3-2-1\" data-name=\"feed text\">\n                                <span class=\"font-extrabold\" data-kid=\"2-2-3-2-2-3-2-1-1\" data-name=\"feed bold prefix\">\n                                    New Testimonial\n                                </span>\n                                : \"DS-Graphix understood our business logic before drawing a single pixel.\"\n                            </p>\n                            <span class=\"text-[9px] font-black text-[var(--color-dark)]/30 uppercase tracking-widest mt-2 block\" data-kid=\"2-2-3-2-2-3-2-2\" data-name=\"timestamp label\">\n                                3 DAYS AGO • CLUTCH VERIFIED\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Compact Lower Gallery of Related Projects -->\n        <section class=\"mb-24 reveal\" data-kid=\"2-2-4\" data-name=\"gallery section\">\n            <div class=\"flex items-center justify-between mb-10\" data-kid=\"2-2-4-1\" data-name=\"section header container\">\n                <h3 class=\"text-2xl font-extrabold text-[var(--color-dark)] tracking-tight\" data-kid=\"2-2-4-1-1\" data-name=\"section title\">\n                    More notably crafted\n                </h3>\n                <a class=\"text-xs font-black text-[var(--color-orange)] uppercase tracking-widest border-b-2 border-[var(--color-orange)]/20 hover:border-[var(--color-orange)] transition-all pb-1\" data-kid=\"2-2-4-1-2\" data-name=\"all work navigation link\" href=\"#\">\n                    All Work\n                </a>\n            </div>\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\" data-kid=\"2-2-4-2\" data-name=\"project grid\">\n                <!-- Gallery Item 1 -->\n                <div class=\"group cursor-pointer\" data-kid=\"2-2-4-2-1\" data-name=\"gallery item\">\n                    <div class=\"relative aspect-square rounded-2xl overflow-hidden mb-4 bg-white border border-black/5 shadow-xs\" data-kid=\"2-2-4-2-1-1\" data-name=\"image container\">\n                        <img alt=\"1981 Digital on Unsplash\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100\" data-kid=\"2-2-4-2-1-1-1\" data-name=\"project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1686061592689-312bbfb5c055?auto=format&w=600&q=80&fit=crop\"/>\n                        <div class=\"absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-all\" data-kid=\"2-2-4-2-1-1-2\" data-name=\"image overlay\">\n                        </div>\n                    </div>\n                    <p class=\"text-[9px] font-black text-[var(--color-orange)] uppercase tracking-widest mb-1\" data-kid=\"2-2-4-2-1-2\" data-name=\"category label\">\n                        Fintech\n                    </p>\n                    <h4 class=\"font-extrabold text-[var(--color-dark)]\" data-kid=\"2-2-4-2-1-3\" data-name=\"project title\">\n                        PayWise V4\n                    </h4>\n                </div>\n                <!-- Gallery Item 2 -->\n                <div class=\"group cursor-pointer\" data-kid=\"2-2-4-2-2\" data-name=\"gallery item\">\n                    <div class=\"relative aspect-square rounded-2xl overflow-hidden mb-4 bg-white border border-black/5 shadow-xs\" data-kid=\"2-2-4-2-2-1\" data-name=\"image container\">\n                        <img alt=\"prashant hiremath on Unsplash\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100\" data-kid=\"2-2-4-2-2-1-1\" data-name=\"project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1763718528755-4bca23f82ac3?auto=format&w=600&q=80&fit=crop\"/>\n                        <div class=\"absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-all\" data-kid=\"2-2-4-2-2-1-2\" data-name=\"image overlay\">\n                        </div>\n                    </div>\n                    <p class=\"text-[9px] font-black text-[var(--color-orange)] uppercase tracking-widest mb-1\" data-kid=\"2-2-4-2-2-2\" data-name=\"category label\">\n                        Enterprise\n                    </p>\n                    <h4 class=\"font-extrabold text-[var(--color-dark)]\" data-kid=\"2-2-4-2-2-3\" data-name=\"project title\">\n                        HR-One Ops\n                    </h4>\n                </div>\n                <!-- Gallery Item 3 -->\n                <div class=\"group cursor-pointer\" data-kid=\"2-2-4-2-3\" data-name=\"gallery item\">\n                    <div class=\"relative aspect-square rounded-2xl overflow-hidden mb-4 bg-white border border-black/5 shadow-xs\" data-kid=\"2-2-4-2-3-1\" data-name=\"image container\">\n                        <img alt=\"Vladimir Srajber on Pexels\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100\" data-kid=\"2-2-4-2-3-1-1\" data-name=\"project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18977345/pexels-photo-18977345.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\"/>\n                        <div class=\"absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-all\" data-kid=\"2-2-4-2-3-1-2\" data-name=\"image overlay\">\n                        </div>\n                    </div>\n                    <p class=\"text-[9px] font-black text-[var(--color-orange)] uppercase tracking-widest mb-1\" data-kid=\"2-2-4-2-3-2\" data-name=\"category label\">\n                        Automobile\n                    </p>\n                    <h4 class=\"font-extrabold text-[var(--color-dark)]\" data-kid=\"2-2-4-2-3-3\" data-name=\"project title\">\n                        Tesla OS Mod\n                    </h4>\n                </div>\n                <!-- Gallery Item 4 -->\n                <div class=\"group cursor-pointer\" data-kid=\"2-2-4-2-4\" data-name=\"gallery item\">\n                    <div class=\"relative aspect-square rounded-2xl overflow-hidden mb-4 bg-white border border-black/5 shadow-xs\" data-kid=\"2-2-4-2-4-1\" data-name=\"image container\">\n                        <img alt=\"Mike Bird on Pexels\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100\" data-kid=\"2-2-4-2-4-1-1\" data-name=\"project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/241188/pexels-photo-241188.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\"/>\n                        <div class=\"absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-all\" data-kid=\"2-2-4-2-4-1-2\" data-name=\"image overlay\">\n                        </div>\n                    </div>\n                    <p class=\"text-[9px] font-black text-[var(--color-orange)] uppercase tracking-widest mb-1\" data-kid=\"2-2-4-2-4-2\" data-name=\"category label\">\n                        Luxury\n                    </p>\n                    <h4 class=\"font-extrabold text-[var(--color-dark)]\" data-kid=\"2-2-4-2-4-3\" data-name=\"project title\">\n                        Audi Q8 HUD\n                    </h4>\n                </div>\n            </div>\n        </section>\n        <!-- Final CTA: Structured Approach -->\n        <section class=\"mb-32 reveal\" data-kid=\"2-2-5\" data-name=\"final cta section\">\n            <div class=\"bg-[var(--color-dark)] rounded-3xl p-16 lg:p-32 relative overflow-hidden text-white\" data-kid=\"2-2-5-1\" data-name=\"cta container\">\n                <!-- Grid Overlay Background -->\n                <div class=\"absolute inset-0 opacity-10\" data-kid=\"2-2-5-1-1\" data-name=\"background decorative grid\" style=\"background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;\">\n                </div>\n                <div class=\"relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\" data-kid=\"2-2-5-1-2\" data-name=\"cta content grid\">\n                    <div data-kid=\"2-2-5-1-2-1\" data-name=\"cta headline container\">\n                        <h2 class=\"text-5xl lg:text-7xl font-extrabold tracking-tighter leading-tight mb-8\" data-kid=\"2-2-5-1-2-1-1\" data-name=\"cta headline\">\n                            Start building\n                            <br data-kid=\"2-2-5-1-2-1-1-1\" data-name=\"line break\"/>\n                            for results.\n                        </h2>\n                        <p class=\"text-white/50 text-xl leading-relaxed max-w-md\" data-kid=\"2-2-5-1-2-1-2\" data-name=\"cta description\">\n                            Our next strategic opening begins in October 2026. Secure your session today.\n                        </p>\n                    </div>\n                    <div class=\"flex flex-col gap-4\" data-kid=\"2-2-5-1-2-2\" data-name=\"button stack\">\n                        <button class=\"bg-[var(--color-orange)] text-white py-6 rounded-2xl font-black text-sm uppercase tracking-[0.2em] hover:brightness-110 transition-all\" data-kid=\"2-2-5-1-2-2-1\" data-name=\"discovery call button\">\n                            Book Discovery Call\n                        </button>\n                        <button class=\"bg-white/5 border border-white/10 text-white py-6 rounded-2xl font-black text-sm uppercase tracking-[0.2em] hover:bg-white/10 transition-all\" data-kid=\"2-2-5-1-2-2-2\" data-name=\"download deck button\">\n                            Download Process Deck\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <!-- Simple Systems Footer -->\n    <footer class=\"bg-white border-t border-black/5 py-12 px-6\" data-kid=\"2-3\" data-name=\"footer section\">\n        <div class=\"max-w-[1440px] mx-auto flex flex-col lg:flex-row justify-between items-start lg:items-center gap-12\" data-kid=\"2-3-1\" data-name=\"footer grid container\">\n            <div class=\"flex flex-col gap-4\" data-kid=\"2-3-1-1\" data-name=\"footer branding\">\n                <div class=\"flex items-center gap-2\" data-kid=\"2-3-1-1-1\" data-name=\"brand identity container\">\n                    <div class=\"w-6 h-6 bg-[var(--color-orange)] rounded flex items-center justify-center\" data-kid=\"2-3-1-1-1-1\" data-name=\"brand icon\">\n                        <span class=\"text-white font-black text-sm italic\" data-kid=\"2-3-1-1-1-1-1\" data-name=\"brand logo text\">\n                            DS\n                        </span>\n                    </div>\n                    <span class=\"font-bold text-base tracking-tight\" data-kid=\"2-3-1-1-1-2\" data-name=\"brand name\">\n                        Graphix\n                    </span>\n                </div>\n                <p class=\"text-xs text-[var(--color-dark)]/40 max-w-xs font-medium\" data-kid=\"2-3-1-1-2\" data-name=\"brand mission statement\">\n                    Full-service digital agency building scalable solutions for high-growth enterprises.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap gap-x-12 gap-y-6\" data-kid=\"2-3-1-2\" data-name=\"footer links grid\">\n                <div class=\"flex flex-col gap-3\" data-kid=\"2-3-1-2-1\" data-name=\"inquiries section\">\n                    <h5 class=\"text-[10px] font-black text-[var(--color-dark)]/30 uppercase tracking-widest\" data-kid=\"2-3-1-2-1-1\" data-name=\"inquiries section heading\">\n                        Inquiries\n                    </h5>\n                    <a class=\"text-sm font-bold hover:text-[var(--color-orange)] transition-colors\" data-kid=\"2-3-1-2-1-2\" data-name=\"contact email link\" href=\"mailto:hello@ds-graphix.com\">\n                        hello@ds-graphix.com\n                    </a>\n                </div>\n                <div class=\"flex flex-col gap-3\" data-kid=\"2-3-1-2-2\" data-name=\"offices section\">\n                    <h5 class=\"text-[10px] font-black text-[var(--color-dark)]/30 uppercase tracking-widest\" data-kid=\"2-3-1-2-2-1\" data-name=\"offices section heading\">\n                        Offices\n                    </h5>\n                    <p class=\"text-sm font-bold\" data-kid=\"2-3-1-2-2-2\" data-name=\"office locations text\">\n                        Pune, India / SF, USA\n                    </p>\n                </div>\n                <div class=\"flex flex-col gap-3\" data-kid=\"2-3-1-2-3\" data-name=\"follow section\">\n                    <h5 class=\"text-[10px] font-black text-[var(--color-dark)]/30 uppercase tracking-widest\" data-kid=\"2-3-1-2-3-1\" data-name=\"follow section heading\">\n                        Follow\n                    </h5>\n                    <div class=\"flex gap-4\" data-kid=\"2-3-1-2-3-2\" data-name=\"follow links container\">\n                        <a class=\"text-sm font-bold hover:text-[var(--color-orange)] transition-colors\" data-kid=\"2-3-1-2-3-2-1\" data-name=\"linkedin link\" href=\"#\">\n                            LinkedIn\n                        </a>\n                        <a class=\"text-sm font-bold hover:text-[var(--color-orange)] transition-colors\" data-kid=\"2-3-1-2-3-2-2\" data-name=\"behance link\" href=\"#\">\n                            Behance\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"lg:text-right\" data-kid=\"2-3-1-3\" data-name=\"direct contact container\">\n                <p class=\"text-xs text-[var(--color-dark)]/40 font-bold mb-2 uppercase tracking-widest\" data-kid=\"2-3-1-3-1\" data-name=\"direct contact header\">\n                    Direct Contact\n                </p>\n                <a class=\"flex items-center gap-2 bg-green-500/10 text-green-600 px-4 py-2 rounded-xl text-xs font-black hover:bg-green-500/20 transition-all\" data-kid=\"2-3-1-3-2\" data-name=\"whatsapp chat button\" href=\"https://wa.me/1234567890\">\n                    <svg class=\"w-4 h-4\" data-kid=\"2-3-1-3-2-1\" data-name=\"whatsapp icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\">\n                        </path>\n                    </svg>\n                    WhatsApp Chat\n                </a>\n            </div>\n        </div>\n    </footer>\n</div>\n<!-- JS Libraries -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import Snap from \"https://esm.sh/lenis@1/snap\"\n    \n    // Lenis Smooth Scroll\n    const lenis = new Lenis({\n        duration: 1.2,\n        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n    })\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n\n    // GSAP Animations\n    // Initial Reveals\n    gsap.utils.toArray('.reveal').forEach(el => {\n        gsap.from(el, {\n            scrollTrigger: {\n                trigger: el,\n                start: \"top 90%\",\n            },\n            y: 30,\n            opacity: 0,\n            duration: 1,\n            ease: \"power2.out\"\n        });\n    });\n\n    // Bar Fill Animation\n    gsap.utils.toArray('.bar-fill').forEach(bar => {\n        gsap.from(bar, {\n            scrollTrigger: {\n                trigger: bar,\n                start: \"top 90%\",\n            },\n            width: \"0%\",\n            duration: 1.5,\n            ease: \"power4.out\"\n        });\n    });\n\n    // List Hover / Active simulation\n    const rows = document.querySelectorAll('.project-row');\n    rows.forEach(row => {\n        row.addEventListener('click', () => {\n            rows.forEach(r => {\n                r.classList.remove('active', 'border-[var(--color-orange)]', 'shadow-sm');\n                r.classList.add('border-black/5', 'bg-white/50');\n            });\n            row.classList.add('active', 'border-[var(--color-orange)]', 'shadow-sm');\n            row.classList.remove('border-black/5', 'bg-white/50');\n            \n            // Re-animate detail panel content on \"change\"\n            gsap.fromTo('.sticky-top', { opacity: 0.5, y: 5 }, { opacity: 1, y: 0, duration: 0.5, ease: \"power2.out\" });\n        });\n    });\n</script>\n",
