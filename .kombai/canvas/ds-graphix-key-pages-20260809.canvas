ta-kid=\"1-3-1-1-2-2-4\" data-name=\"capabilities link 4\">\n                            <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-1-2-2-4-1\" data-name=\"capabilities link 4 anchor\" href=\"#\">\n                                Social Creatives\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"md:col-span-2 space-y-8\" data-kid=\"1-3-1-1-3\" data-name=\"agency links column\">\n                    <p class=\"text-[10px] uppercase tracking-[0.3em] font-bold text-[#FF6636]\" data-kid=\"1-3-1-1-3-1\" data-name=\"agency heading\">\n                        Agency\n                    </p>\n                    <ul class=\"space-y-4 text-xs font-bold tracking-[0.2em] text-white/40 uppercase\" data-kid=\"1-3-1-1-3-2\" data-name=\"agency links list\">\n                        <li data-kid=\"1-3-1-1-3-2-1\" data-name=\"agency link 1\">\n                            <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-1-3-2-1-1\" data-name=\"agency link 1 anchor\" href=\"#\">\n                                Our Work\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-3-2-2\" data-name=\"agency link 2\">\n                            <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-1-3-2-2-1\" data-name=\"agency link 2 anchor\" href=\"#\">\n                                Process\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-3-2-3\" data-name=\"agency link 3\">\n                            <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-1-3-2-3-1\" data-name=\"agency link 3 anchor\" href=\"#\">\n                                Journal\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-3-2-4\" data-name=\"agency link 4\">\n                            <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-1-3-2-4-1\" data-name=\"agency link 4 anchor\" href=\"#\">\n                                Careers\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"md:col-span-2 space-y-8\" data-kid=\"1-3-1-1-4\" data-name=\"contact links column\">\n                    <p class=\"text-[10px] uppercase tracking-[0.3em] font-bold text-[#FF6636]\" data-kid=\"1-3-1-1-4-1\" data-name=\"contact heading\">\n                        Contact\n                    </p>\n                    <ul class=\"space-y-4 text-xs font-bold tracking-[0.2em] text-white/40 uppercase\" data-kid=\"1-3-1-1-4-2\" data-name=\"contact links list\">\n                        <li data-kid=\"1-3-1-1-4-2-1\" data-name=\"contact link 1\">\n                            <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-1-4-2-1-1\" data-name=\"contact link 1 anchor\" href=\"#\">\n                                LinkedIn\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-4-2-2\" data-name=\"contact link 2\">\n                            <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-1-4-2-2-1\" data-name=\"contact link 2 anchor\" href=\"#\">\n                                Behance\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-4-2-3\" data-name=\"contact link 3\">\n                            <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-1-4-2-3-1\" data-name=\"contact link 3 anchor\" href=\"#\">\n                                Twitter\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-4-2-4\" data-name=\"contact link 4\">\n                            <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-1-4-2-4-1\" data-name=\"contact link 4 anchor\" href=\"#\">\n                                Email\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"pt-12 flex flex-col md:flex-row justify-between items-center gap-10\" data-kid=\"1-3-1-2\" data-name=\"footer bottom bar\">\n                <div class=\"flex flex-wrap justify-center gap-x-12 gap-y-4 text-[9px] uppercase tracking-[0.3em] font-bold text-white/20\" data-kid=\"1-3-1-2-1\" data-name=\"legal links list\">\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-2-1-1\" data-name=\"privacy policy link\" href=\"#\">\n                        Privacy Policy\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-2-1-2\" data-name=\"terms conditions link\" href=\"#\">\n                        Terms & Conditions\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-2-1-3\" data-name=\"cookie policy link\" href=\"#\">\n                        Cookie Policy\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"1-3-1-2-1-4\" data-name=\"sitemap link\" href=\"#\">\n                        Sitemap\n                    </a>\n                </div>\n                <div class=\"text-right\" data-kid=\"1-3-1-2-2\" data-name=\"copyright container\">\n                    <p class=\"text-[9px] uppercase tracking-[0.3em] font-bold text-white/20 mb-2\" data-kid=\"1-3-1-2-2-1\" data-name=\"copyright notice\">\n                        © 2026 DS-GRAPHIX CREATIVE STUDIO. ALL RIGHTS RESERVED.\n                    </p>\n                    <p class=\"text-[8px] text-white/10 uppercase tracking-[0.1em]\" data-kid=\"1-3-1-2-2-2\" data-name=\"credits text\">\n                        Crafted with precision by DS-Graphix Lab.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </footer>\n    <!-- Floating WhatsApp FAB -->\n    <a aria-label=\"Chat on WhatsApp\" class=\"fixed bottom-8 right-8 bg-[#25D366] text-white w-14 h-14 flex items-center justify-center rounded-none shadow-2xl hover:scale-110 active:scale-95 transition-all duration-300 z-[200]\" data-kid=\"1-4\" data-name=\"floating whatsapp button\" href=\"https://wa.me/919890388405\">\n        <i class=\"ti ti-brand-whatsapp text-3xl\" data-kid=\"1-4-1\" data-name=\"whatsapp icon\">\n        </i>\n    </a>\n    <!-- Libraries -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script type=\"module\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n        import Snap from \"https://esm.sh/lenis@1/snap\"\n        \n        // Initialize Lenis Smooth Scroll\n        const lenis = new Lenis({\n            duration: 1.2,\n            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n            smoothWheel: true\n        })\n\n        function raf(time) {\n            lenis.raf(time)\n            requestAnimationFrame(raf)\n        }\n        requestAnimationFrame(raf)\n\n        // GSAP Animations\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Hero Reveal\n        gsap.from([\".hero-eyebrow\", \".hero-headline\", \".hero-line\"], {\n            y: 50,\n            opacity: 0,\n            duration: 1,\n            stagger: 0.2,\n            ease: \"power4.out\",\n            delay: 0.2\n        });\n\n        // Split Section Reveals\n        gsap.from(\".gsap-reveal-left\", {\n            scrollTrigger: {\n                trigger: \"#contact\",\n                start: \"top 70%\",\n            },\n            x: -50,\n            opacity: 0,\n            duration: 1.2,\n            ease: \"power3.out\"\n        });\n\n        gsap.from(\".gsap-reveal-right\", {\n            scrollTrigger: {\n                trigger: \"#contact\",\n                start: \"top 70%\",\n            },\n            x: 50,\n            opacity: 0,\n            duration: 1.2,\n            ease: \"power3.out\"\n        });\n\n        // Form Fields Stagger\n        gsap.from(\".form-group\", {\n            scrollTrigger: {\n                trigger: \"#quote-form\",\n                start: \"top 80%\",\n            },\n            y: 30,\n            opacity: 0,\n            duration: 0.8,\n            stagger: 0.1,\n            ease: \"power2.out\"\n        });\n    </script>\n</div>\n",
