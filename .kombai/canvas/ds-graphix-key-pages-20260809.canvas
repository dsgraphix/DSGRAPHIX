         <svg class=\"w-5 h-5\" data-kid=\"2-2-1-2-1-3-2-2-1-1\" data-name=\"video icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                            <path d=\"M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                                            </path>\n                                        </svg>\n                                    </div>\n                                    <div class=\"font-bold text-sm\" data-kid=\"2-2-1-2-1-3-2-2-2\" data-name=\"video title\">\n                                        Video Production\n                                    </div>\n                                </button>\n                                <button class=\"project-type-btn p-5 rounded-2xl border-2 border-black/5 bg-white text-[#2A2A29] flex flex-col gap-4 text-left transition-all cursor-pointer hover:border-black/10 group\" data-kid=\"2-2-1-2-1-3-2-3\" data-name=\"visual graphics option button\">\n                                    <div class=\"w-10 h-10 rounded-full border border-black/5 bg-[#F2F4F8] flex items-center justify-center shrink-0 group-hover:text-[#FF6636] transition-colors\" data-kid=\"2-2-1-2-1-3-2-3-1\" data-name=\"graphics icon wrapper\">\n                                        <svg class=\"w-5 h-5\" data-kid=\"2-2-1-2-1-3-2-3-1-1\" data-name=\"graphics icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                            <path d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h14a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                                            </path>\n                                        </svg>\n                                    </div>\