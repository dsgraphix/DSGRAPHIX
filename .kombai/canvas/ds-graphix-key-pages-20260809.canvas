ideo overflow-hidden animate-reveal bg-light-gray\" data-kid=\"2-5-2-2\" data-name=\"project card two\">\n                <img alt=\"Magazine mockup by Content Pixie\" class=\"w-full h-full object-cover grayscale brightness-90 group-hover:grayscale-0 transition-transform duration-1000 group-hover:scale-105\" data-kid=\"2-5-2-2-1\" data-name=\"project card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1592966719124-2ca2978ba325?auto=format&w=1200&q=80&fit=crop\"/>\n                <div class=\"absolute bottom-12 left-12 text-white z-10 translate-y-8 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500\" data-kid=\"2-5-2-2-2\" data-name=\"project card overlay info\">\n                    <span class=\"text-[10px] uppercase tracking-[0.3em] bg-orange px-5 py-2 mb-4 inline-block font-black\" data-kid=\"2-5-2-2-2-1\" data-name=\"project tag\">\n                        Brand Identity\n                    </span>\n                    <h3 class=\"text-5xl font-serif font-black leading-none\" data-kid=\"2-5-2-2-2-2\" data-name=\"project title\">\n                        Water Journal\n                        <br data-kid=\"2-5-2-2-2-2-1\" data-name=\"project title line break\"/>\n                        Annual Edition\n                    </h3>\n                </div>\n                <div class=\"absolute inset-0 bg-gradient-to-t from-dark/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"2-5-2-2-3\" data-name=\"hover gradient overlay\">\n                </div>\n            </div>\n            <!-- Item 3 -->\n            <div class=\"group relative aspect-video overflow-hidden animate-reveal bg-light-gray\" data-kid=\"2-5-2-3\" data-name=\"project card three\">\n                <img alt=\"Street mockup by BUENOS MOCKUPS\" class=\"w-full h-full object-cover grayscale brightness-90 group-hover:grayscale-0 transition-transform duration-1000 group-hover:scale-105\" data-k