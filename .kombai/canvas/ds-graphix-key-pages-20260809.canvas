" data-name=\"services link two\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-1-2-2-1\" data-name=\"services link text\" href=\"#\">\n                            Branding\n                        </a>\n                    </li>\n                    <li data-kid=\"7-1-3-1-2-3\" data-name=\"services link three\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-1-2-3-1\" data-name=\"services link text\" href=\"#\">\n                            Graphic Design\n                        </a>\n                    </li>\n                    <li data-kid=\"7-1-3-1-2-4\" data-name=\"services link four\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-1-2-4-1\" data-name=\"services link text\" href=\"#\">\n                            Video Production\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"7-1-3-2\" data-name=\"company links column\">\n                <p class=\"font-heading font-black uppercase tracking-widest mb-6 opacity-60\" data-kid=\"7-1-3-2-1\" data-name=\"company title text\">\n                    Company\n                </p>\n                <ul class=\"space-y-4 font-bold text-sm uppercase tracking-widest\" data-kid=\"7-1-3-2-2\" data-name=\"company navigation list\">\n                    <li data-kid=\"7-1-3-2-2-1\" data-name=\"company link one\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-2-2-1-1\" data-name=\"company link text\" href=\"#\">\n                            About Us\n                        </a>\n                    </li>\n                    <li data-kid=\"7-1-3-2-2-2\" data-name=\"company link two\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-2-2-2-1\" data-name=\"company link text\" href=\"#\">\n                            Our Process\n                        </a>\n                    </li>\n                    <li data-kid=\"7-1-3-2-2-3\" data-name=\"company link three\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-2-2-3-1\" data-name=\"company link text\" href=\"#\">\n                            Careers\n                        </a>\n                    </li>\n                    <li data-kid=\"7-1-3-2-2-4\" data-name=\"company link four\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-2-2-4-1\" data-name=\"company link text\" href=\"#\">\n                            Insights\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"7-1-3-3\" data-name=\"social links column\">\n                <p class=\"font-heading font-black uppercase tracking-widest mb-6 opacity-60\" data-kid=\"7-1-3-3-1\" data-name=\"social title text\">\n                    Social\n                </p>\n                <ul class=\"space-y-4 font-bold text-sm uppercase tracking-widest\" data-kid=\"7-1-3-3-2\" data-name=\"social navigation list\">\n                    <li data-kid=\"7-1-3-3-2-1\" data-name=\"social link one\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-3-2-1-1\" data-name=\"social link text\" href=\"#\">\n                            LinkedIn\n                        </a>\n                    </li>\n                    <li data-kid=\"7-1-3-3-2-2\" data-name=\"social link two\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-3-2-2-1\" data-name=\"social link text\" href=\"#\">\n                            Instagram\n                        </a>\n                    </li>\n                    <li data-kid=\"7-1-3-3-2-3\" data-name=\"social link three\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-3-2-3-1\" data-name=\"social link text\" href=\"#\">\n                            Behance\n                        </a>\n                    </li>\n                    <li data-kid=\"7-1-3-3-2-4\" data-name=\"social link four\">\n                        <a class=\"hover:underline\" data-kid=\"7-1-3-3-2-4-1\" data-name=\"social link text\" href=\"#\">\n                            Twitter\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"col-span-2 md:col-span-1\" data-kid=\"7-1-3-4\" data-name=\"copyright information column\">\n                <div class=\"flex items-center gap-2 mb-6\" data-kid=\"7-1-3-4-1\" data-name=\"footer brand container\">\n                    <div class=\"w-6 h-6 bg-white\" data-kid=\"7-1-3-4-1-1\" data-name=\"footer logo icon\">\n                    </div>\n                    <span class=\"font-heading font-black text-lg tracking-tighter uppercase\" data-kid=\"7-1-3-4-1-2\" data-name=\"footer brand name text\">\n                        DS-Graphix\n                    </span>\n                </div>\n                <p class=\"text-xs font-bold uppercase tracking-widest opacity-60 leading-relaxed\" data-kid=\"7-1-3-4-2\" data-name=\"copyright text\">\n                    © 2026 DS-Graphix Studio.\n                    <br data-kid=\"7-1-3-4-2-1\" data-name=\"copyright line break\"/>\n                    All Rights Reserved.\n                </p>\n            </div>\n        </div>\n    </div>\n    <!-- Large Background Text for Aesthetic -->\n    <div class=\"absolute -bottom-20 -left-20 opacity-10 pointer-events-none select-none\" data-kid=\"7-2\" data-name=\"footer background text container\">\n        <p class=\"font-heading font-black text-[30vw] leading-none uppercase tracking-tighter\" data-kid=\"7-2-1\" data-name=\"large background text\">\n            PROCESS\n        </p>\n    </div>\n</footer>\n<link data-kid=\"8\" data-name=\"lenis scroll css sheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n  \n  // Initialize GSAP ScrollTrigger and synchronize with Lenis\n  gsap.registerPlugin(ScrollTrigger);\n\n  const lenis = new Lenis({\n    duration: 1.2,\n    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n    smoothWheel: true,\n  });\n\n  lenis.on('scroll', ScrollTrigger.update);\n\n  gsap.ticker.add((time) => {\n    lenis.raf(time * 1000);\n  });\n\n  gsap.ticker.lagSmoothing(0);\n\n  // Hero Animations\n  const heroTl = gsap.timeline();\n  heroTl.from(\".hero-text\", {\n    y: 100,\n    rotateX: -30,\n    opacity: 0,\n    duration: 1.2,\n    ease: \"expo.out\"\n  });\n  heroTl.from(\".hero-subline\", {\n    x: -50,\n    opacity: 0,\n    duration: 1,\n    ease: \"power3.out\"\n  }, \"-=0.8\");\n\n  // Marquee Animation\n  gsap.to(\".marquee-container\", {\n    xPercent: -50,\n    repeat: -1,\n    duration: 20,\n    ease: \"none\"\n  });\n\n  // Process Step Animations\n  const steps = document.querySelectorAll(\".process-step\");\n  steps.forEach((step, index) => {\n    const content = step.querySelector(\".brutalist-border\");\n    const isLeft = index % 2 === 0;\n    \n    gsap.from(content, {\n      scrollTrigger: {\n        trigger: step,\n        start: \"top 85%\",\n        toggleActions: \"play none none none\"\n      },\n      x: isLeft ? -100 : 100,\n      opacity: 0,\n      duration: 1.2,\n      ease: \"power4.out\"\n    });\n\n    gsap.from(step.querySelector(\".step-num\"), {\n      scrollTrigger: {\n        trigger: step,\n        start: \"top 70%\",\n        toggleActions: \"play none none none\"\n      },\n      scale: 0.5,\n      y: 50,\n      opacity: 0,\n      duration: 1.2,\n      ease: \"back.out(1.7)\",\n      delay: 0.2\n    });\n  });\n\n  // Ticker Rotation on Scroll\n  gsap.to(\".diagonal-ticker\", {\n    scrollTrigger: {\n      trigger: \"#hero\",\n      start: \"bottom bottom\",\n      end: \"bottom top\",\n      scrub: 1\n    },\n    rotate: -4,\n    scale: 1.1\n  });\n</script>\n",
      "comments": [],
      "created": "2026-08-09T11:39:40.206761+00:00",
      "modified": "2026-08-09T11:39:40.206761+00:00",
      "id": "var_e06bf19d1ab0"
    },
    "var_847e5c5c98d4": {
      "type": "variant",
      "label": "Expressive — Services",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 12420,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"bg-[#2A2A29] text-[#FFFFFF] font-['Source_Sans_3'] selection:bg-[#FF6636] selection:text-white overflow-x-clip min-h-screen relative\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Noise Grain Overlay -->\n    <div class=\"fixed inset-0 pointer-events-none opacity-[0.03] z-[9999]\" data-kid=\"1-1\" data-name=\"noise grain overlay\" style=\"background-image: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');\">\n    </div>\n    <link data-kid=\"1-2\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n        .font-expressive { font-family: 'Bricolage+Grotesque', sans-serif; }\n        \n        .brutalist-border { border: 2px solid #FFFFFF; }\n        \n        @keyframes marquee {\n            0% { transform: translateX(0); }\n            100% { transform: translateX(-50%); }\n        }\n        .animate-marquee {\n            display: inline-flex;\n            animation: marquee 30s linear infinite;\n        }\n        \n        .diagonal-strip {\n            transform: rotate(-3deg) scale(1.1);\n        }\n        \n        @media (max-width: 768px) {\n            .diagonal-strip {\n                transform: rotate(0) scale(1);\n            }\n        }\n\n        /* Lenis and custom smooth scroll hooks */\n        html.lenis {\n            height: auto;\n        }\n        .lenis.lenis-smooth {\n            scroll-behavior: auto;\n        }\n        .lenis.lenis-smooth [data-lenis-prevent] {\n            overscroll-behavior: contain;\n        }\n        .lenis.lenis-stopped {\n            overflow: hidden;\n        }\n    </style>\n    <!-- Compact Header -->\n    <header class=\"fixed top-0 left-0 w-full z-[100] px-6 py-4 flex items-center justify-between mix-blend-difference\" data-kid=\"1-3\" data-name=\"header navigation bar\">\n        <div class=\"flex items-center gap-2 group cursor-pointer\" data-kid=\"1-3-1\" data-name=\"logo container\">\n            <div class=\"w-8 h-8 bg-[#FF6636] brutalist-border\" data-kid=\"1-3-1-1\" data-name=\"logo brand mark\">\n            </div>\n            <span class=\"font-expressive font-bold text-2xl tracking-tighter uppercase\" data-kid=\"1-3-1-2\" data-name=\"logo text\">\n                DS-Graphix\n            </span>\n        </div>\n        <nav class=\"hidden md:flex items-center gap-8 font-bold text-sm uppercase tracking-widest\" data-kid=\"1-3-2\" data-name=\"primary navigation links\">\n            <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-3-2-1\" data-name=\"work navigation link\" href=\"#\">\n                Work\n            </a>\n            <a class=\"text-[#FF6636]\" data-kid=\"1-3-2-2\" data-name=\"services navigation link\" href=\"#\">\n                Services\n            </a>\n            <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-3-2-3\" data-name=\"process navigation link\" href=\"#\">\n                Process\n            </a>\n            <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-3-2-4\" data-name=\"contact navigation link\" href=\"#\">\n                Contact\n            </a>\n        </nav>\n        <a class=\"bg-[#FF6636] text-[#2A2A29] px-6 py-2 brutalist-border font-bold uppercase text-sm hover:bg-white transition-colors\" data-kid=\"1-3-3\" data-name=\"start a project call-to-action button\" href=\"#\">\n            Start a project\n        </a>\n    </header>\n    <main data-kid=\"1-4\" data-name=\"main content area\">\n        <!-- Hero Section -->\n        <section class=\"min-h-screen pt-32 pb-20 px-6 md:px-12 flex flex-col justify-center relative overflow-hidden\" data-kid=\"1-4-1\" data-name=\"hero section\">\n            <div class=\"max-w-7xl mx-auto w-full relative\" data-kid=\"1-4-1-1\" data-name=\"hero inner content container\">\n                <div class=\"mb-4\" data-kid=\"1-4-1-1-1\" data-name=\"hero sub-heading container\">\n                    <span class=\"text-[#FF6636] font-bold uppercase tracking-[0.3em] text-sm\" data-kid=\"1-4-1-1-1-1\" data-name=\"capabilities overview label\">\n                        Capabilities Overview\n                    </span>\n                </div>\n                <div class=\"relative\" data-kid=\"1-4-1-1-2\" data-name=\"hero main headline section\">\n                    <h1 class=\"font-expressive text-[clamp(3.5rem,12.5vw,11rem)] font-extrabold leading-[0.8] uppercase tracking-tighter mb-12 scrub-text relative z-10\" data-kid=\"1-4-1-1-2-1\" data-name=\"hero main headline text\">\n                        One partner.\n                        <br data-kid=\"1-4-1-1-2-1-1\"/>\n                        <span class=\"text-[#FF6636]\" data-kid=\"1-4-1-1-2-1-2\">\n                            Every creative\n                        </span>\n                        <br data-kid=\"1-4-1-1-2-1-3\"/>\n                        surface.\n                    </h1>\n                    <div class=\"absolute -right-12 top-0 text-[clamp(10rem,25vw,22rem)] font-expressive font-black text-white/5 select-none leading-none z-0 translate-y-[-20%]\" data-kid=\"1-4-1-1-2-2\" data-name=\"hero decorative background number\">\n                        03\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-12 gap-12 items-start\" data-kid=\"1-4-1-1-3\" data-name=\"hero paragraph grid container\">\n                    <div class=\"md:col-span-7\" data-kid=\"1-4-1-1-3-1\" data-name=\"hero paragraph content column\">\n                        <p class=\"text-xl md:text-3xl text-[#F2F4F8] font-bold leading-tight max-w-2xl reveal-up border-l-8 border-[#FF6636] pl-8\" data-kid=\"1-4-1-1-3-1-1\" data-name=\"hero description text\">\n                            We operate at the intersection of high-fidelity design and aggressive business growth. DS-Graphix is the visual engine for brands that refuse to look like everyone else.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Diagonal Ticker -->\n        <div class=\"relative z-20 py-12 md:py-20 overflow-visible\" data-kid=\"1-4-2\" data-name=\"ticker section container\">\n            <section class=\"diagonal-strip bg-[#FF6636] border-y-4 border-white py-6 md:py-8\" data-kid=\"1-4-2-1\" data-name=\"diagonal ticker strip\">\n                <div class=\"flex whitespace-nowrap animate-marquee font-expressive font-black uppercase text-4xl md:text-7xl text-[#2A2A29]\" data-kid=\"1-4-2-1-1\" data-name=\"animated ticker content container\">\n                    <span class=\"mx-8\" data-kid=\"1-4-2-1-1-1\" data-name=\"ticker services list one\">\n                        UI/UX • BRAND IDENTITY • GRAPHIC DESIGN • SOCIAL CREATIVES • VIDEO PRODUCTION • REELS •\n                    </span>\n                    <span class=\"mx-8\" data-kid=\"1-4-2-1-1-2\" data-name=\"ticker services list two\">\n                        UI/UX • BRAND IDENTITY • GRAPHIC DESIGN • SOCIAL CREATIVES • VIDEO PRODUCTION • REELS •\n                    </span>\n                </div>\n            </section>\n        </div>\n        <!-- Giant Cluster Service Matrix -->\n        <section class=\"py-24 px-6 md:px-12\" data-kid=\"1-4-3\" data-name=\"service matrix section\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"1-4-3-1\" data-name=\"service matrix content container\">\n                <div class=\"flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8\" data-kid=\"1-4-3-1-1\" data-name=\"service matrix header section\">\n                    <h2 class=\"font-expressive text-5xl md:text-8xl font-bold uppercase tracking-tighter leading-[0.85]\" data-kid=\"1-4-3-1-1-1\" data-name=\"service matrix title\">\n                        The Service\n                        <br data-kid=\"1-4-3-1-1-1-1\"/>\n                        <span class=\"text-[#FF6636]\" data-kid=\"1-4-3-1-1-1-2\">\n                            Cluster\n                        </span>\n                    </h2>\n                    <p class=\"font-bold text-lg md:text-2xl text-[#FF6636] max-w-sm italic\" data-kid=\"1-4-3-1-1-2\" data-name=\"service matrix highlight text\">\n                        Tangible results for high-stakes digital products.\n                    </p>\n                </div>\n                <div class=\"flex flex-col gap-8\" data-kid=\"1-4-3-1-2\" data-name=\"services grid container\">\n                    <!-- Row 1: Giant UI/UX -->\n                    <div class=\"brutalist-border p-8 md:p-16 flex flex-col md:flex-row justify-between group relative overflow-hidden bg-[#2A2A29] min-h-[600px]\" data-kid=\"1-4-3-1-2-1\" data-name=\"ui ux service card\">\n                        <div class=\"relative z-10 md:w-1/2 flex flex-col justify-between h-full\" data-kid=\"1-4-3-1-2-1-1\" data-name=\"ui ux text content container\">\n                            <div data-kid=\"1-4-3-1-2-1-1-1\" data-name=\"ui ux service badge\">\n                                <span class=\"inline-block px-4 py-1 bg-[#FF6636] text-[#2A2A29] text-sm font-black uppercase mb-8\" data-kid=\"1-4-3-1-2-1-1-1-1\">\n                                    Service #01\n                                </span>\n                                <h3 class=\"font-expressive text-6xl md:text-9xl font-black leading-none uppercase mb-8 group-hover:text-[#FF6636] transition-colors duration-500\" data-kid=\"1-4-3-1-2-1-1-1-2\">\n                                    UI/UX\n                                    <br data-kid=\"1-4-3-1-2-1-1-1-2-1\"/>\n                                    SYSTEMS\n                                </h3>\n                                <p class=\"text-xl md:text-2xl text-[#F2F4F8] max-w-md font-bold mb-8\" data-kid=\"1-4-3-1-2-1-1-1-3\">\n                                    End-to-end product experiences designed to convert users into advocates.\n                                </p>\n                            </div>\n                            <div class=\"space-y-8\" data-kid=\"1-4-3-1-2-1-1-2\" data-name=\"ui ux service title\">\n                                <div class=\"flex flex-wrap gap-3\" data-kid=\"1-4-3-1-2-1-1-2-1\">\n                                    <span class=\"px-5 py-2 brutalist-border text-sm font-black uppercase hover:bg-white hover:text-[#2A2A29] transition-colors\" data-kid=\"1-4-3-1-2-1-1-2-1-1\">\n                                        Enterprise Dashboards\n                                    </span>\n                                    <span class=\"px-5 py-2 brutalist-border text-sm font-black uppercase hover:bg-white hover:text-[#2A2A29] transition-colors\" data-kid=\"1-4-3-1-2-1-1-2-1-2\">\n                                        Mobile Platforms\n                                    </span>\n                                    <span class=\"px-5 py-2 brutalist-border text-sm font-black uppercase hover:bg-white hover:text-[#2A2A29] transition-colors\" data-kid=\"1-4-3-1-2-1-1-2-1-3\">\n                                        Design Tokens\n                                    </span>\n                                </div>\n                                <div data-kid=\"1-4-3-1-2-1-1-2-2\">\n                                    <span class=\"block text-sm font-black uppercase text-[#FF6636] mb-2\" data-kid=\"1-4-3-1-2-1-1-2-2-1\">\n                                        Ideal Fit\n                                    </span>\n                                    <p class=\"text-3xl font-bold font-expressive uppercase italic\" data-kid=\"1-4-3-1-2-1-1-2-2-2\">\n                                        Growth-stage SaaS\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"relative z-10 md:w-1/2 flex flex-col justify-end items-end mt-12 md:mt-0\" data-kid=\"1-4-3-1-2-1-2\" data-name=\"ui ux action button container\">\n                            <button class=\"bg-white text-[#2A2A29] px-12 py-8 font-black uppercase text-2xl brutalist-border group-hover:bg-[#FF6636] group-hover:text-white transition-all duration-300\" data-kid=\"1-4-3-1-2-1-2-1\" data-name=\"start product call-to-action button\">\n                                START PRODUCT\n                            </button>\n                        </div>\n                        <!-- Video Background for UI/UX -->\n                        <div class=\"absolute inset-0 z-0 opacity-20 grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:opacity-40 scale-110 group-hover:scale-100 pointer-events-none\" data-kid=\"1-4-3-1-2-1-3\" data-name=\"ui ux video background container\">\n                            <video autoplay=\"\" class=\"w-full h-full object-cover\" data-kid=\"1-4-3-1-2-1-3-1\" data-name=\"ui ux background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/17599626/3d-arcadian-cgi-digital-17599626.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/17599626/17599626-sd_960_540_30fps.mp4\">\n                            </video>\n                        </div>\n                    </div>\n                    <!-- Row 2: Two Columns -->\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"1-4-3-1-2-2\" data-name=\"brand and video row container\">\n                        <!-- Brand Identity -->\n                        <div class=\"brutalist-border p-10 flex flex-col justify-between bg-[#2A2A29] hover:bg-white hover:text-[#2A2A29] transition-all duration-500 group relative min-h-[450px]\" data-kid=\"1-4-3-1-2-2-1\" data-name=\"brand identity card\">\n                            <div class=\"relative z-10\" data-kid=\"1-4-3-1-2-2-1-1\" data-name=\"brand identity icon container\">\n                                <i class=\"ti ti-brand-abstract text-7xl text-[#FF6636] mb-8\" data-kid=\"1-4-3-1-2-2-1-1-1\" data-name=\"abstract icon\">\n                                </i>\n                                <h3 class=\"font-expressive text-5xl font-black uppercase leading-[0.9] mb-6\" data-kid=\"1-4-3-1-2-2-1-1-2\" data-name=\"brand identity title\">\n                                    Brand\n                                    <br data-kid=\"1-4-3-1-2-2-1-1-2-1\"/>\n                                    Identity\n                                </h3>\n                                <p class=\"font-bold text-xl opacity-80 max-w-sm mb-12\" data-kid=\"1-4-3-1-2-2-1-1-3\" data-name=\"brand identity description\">\n                                    Logo strategy, typography systems, and visual guidelines that command authority in saturated markets.\n                                </p>\n                            </div>\n                            <a class=\"text-2xl font-black border-b-8 border-[#FF6636] pb-2 uppercase italic inline-block w-fit relative z-10\" data-kid=\"1-4-3-1-2-2-1-2\" data-name=\"brand identity link\" href=\"#\">\n                                THE BRAND LAB\n                            </a>\n                            <div class=\"absolute right-[-10%] bottom-[-10%] text-[12rem] font-black text-white/5 pointer-events-none z-0\" data-kid=\"1-4-3-1-2-2-1-3\" data-name=\"brand identity decorative text\">\n                                CORE\n                            </div>\n                        </div>\n                        <!-- Video & Reels -->\n                        <div class=\"brutalist-border p-10 flex flex-col justify-between bg-[#2A2A29] hover:bg-[#FF6636] hover:text-[#2A2A29] transition-all duration-500 group relative overflow-hidden min-h-[450px]\" data-kid=\"1-4-3-1-2-2-2\" data-name=\"video and reels card\">\n                            <div class=\"relative z-10\" data-kid=\"1-4-3-1-2-2-2-1\" data-name=\"video and reels content container\">\n                                <i class=\"ti ti-player-play text-7xl mb-8 group-hover:text-white transition-colors\" data-kid=\"1-4-3-1-2-2-2-1-1\" data-name=\"play icon\">\n                                </i>\n                                <h3 class=\"font-expressive text-5xl font-black uppercase leading-[0.9] mb-6\" data-kid=\"1-4-3-1-2-2-2-1-2\" data-name=\"video and reels title\">\n                                    Video\n                                    <br data-kid=\"1-4-3-1-2-2-2-1-2-1\"/>\n                                    & Reels\n                                </h3>\n                                <p class=\"font-bold text-xl opacity-80 max-w-sm\" data-kid=\"1-4-3-1-2-2-2-1-3\" data-name=\"video and reels description\">\n                                    High-retention storytelling for the vertical era. We build content loops that drive engagement.\n                                </p>\n                            </div>\n                            <div class=\"flex items-center gap-4 relative z-10\" data-kid=\"1-4-3-1-2-2-2-2\" data-name=\"featured reels container\">\n                                <span class=\"text-sm font-black uppercase tracking-widest\" data-kid=\"1-4-3-1-2-2-2-2-1\" data-name=\"featured reels label\">\n                                    Featured Reels\n                                </span>\n                                <div class=\"flex -space-x-4\" data-kid=\"1-4-3-1-2-2-2-2-2\" data-name=\"reels thumbnail stack\">\n                                    <div class=\"w-12 h-12 brutalist-border bg-gray-500 overflow-hidden\" data-kid=\"1-4-3-1-2-2-2-2-2-1\" data-name=\"first reel thumbnail\">\n                                        <img alt=\"reel\" class=\"w-full h-full object-cover\" data-kid=\"1-4-3-1-2-2-2-2-2-1-1\" data-name=\"first reel image\" src=\"https://images.unsplash.com/photo-1598897597103-06c91e18e03f?w=100&q=80\"/>\n                                    </div>\n                                    <div class=\"w-12 h-12 brutalist-border bg-gray-400 overflow-hidden\" data-kid=\"1-4-3-1-2-2-2-2-2-2\" data-name=\"second reel thumbnail\">\n                                        <img alt=\"reel\" class=\"w-full h-full object-cover\" data-kid=\"1-4-3-1-2-2-2-2-2-2-1\" data-name=\"second reel image\" src=\"https://images.unsplash.com/photo-1579546929518-9e396f3cc809?w=100&q=80\"/>\n                                    </div>\n                                </div>\n                            </div>\n                            <!-- Background Video -->\n                            <div class=\"absolute inset-0 z-0 opacity-10 grayscale group-hover:opacity-40 group-hover:grayscale-0 transition-all duration-700 pointer-events-none\" data-kid=\"1-4-3-1-2-2-2-3\" data-name=\"video and reels background video container\">\n                                <video autoplay=\"\" class=\"w-full h-full object-cover\" data-kid=\"1-4-3-1-2-2-2-3-1\" data-name=\"video and reels background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/33362112/pexels-photo-33362112.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/33362112/14204953_640_360_25fps.mp4\">\n                                </video>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Row 3: Smaller expressive blocks -->\n                    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"1-4-3-1-2-3\" data-name=\"secondary services grid container\">\n                        <div class=\"brutalist-border p-8 flex flex-col justify-between hover:bg-white hover:text-[#2A2A29] transition-all duration-300 group min-h-[300px]\" data-kid=\"1-4-3-1-2-3-1\" data-name=\"graphic design service card\">\n                            <h3 class=\"font-expressive text-3xl font-black uppercase leading-none\" data-kid=\"1-4-3-1-2-3-1-1\" data-name=\"graphic design title\">\n                                Graphic\n                                <br data-kid=\"1-4-3-1-2-3-1-1-1\"/>\n                                Design\n                            </h3>\n                            <div class=\"flex items-end justify-between\" data-kid=\"1-4-3-1-2-3-1-2\" data-name=\"graphic design info container\">\n                                <p class=\"text-sm font-bold opacity-60 max-w-[150px]\" data-kid=\"1-4-3-1-2-3-1-2-1\" data-name=\"graphic design description\">\n                                    Print, Digital, & Everything in between.\n                                </p>\n                                <i class=\"ti ti-palette text-5xl text-[#FF6636]\" data-kid=\"1-4-3-1-2-3-1-2-2\" data-name=\"graphic design icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div class=\"brutalist-border p-8 flex flex-col justify-between hover:bg-white hover:text-[#2A2A29] transition-all duration-300 group min-h-[300px]\" data-kid=\"1-4-3-1-2-3-2\" data-name=\"social creatives service card\">\n                            <h3 class=\"font-expressive text-3xl font-black uppercase leading-none\" data-kid=\"1-4-3-1-2-3-2-1\" data-name=\"social creatives title\">\n                                Social\n                                <br data-kid=\"1-4-3-1-2-3-2-1-1\"/>\n                                Creatives\n                            </h3>\n                            <div class=\"flex items-end justify-between\" data-kid=\"1-4-3-1-2-3-2-2\" data-name=\"social creatives info container\">\n                                <p class=\"text-sm font-bold opacity-60 max-w-[150px]\" data-kid=\"1-4-3-1-2-3-2-2-1\" data-name=\"social creatives description\">\n                                    High-fidelity static & motion assets.\n                                </p>\n                                <i class=\"ti ti-social text-5xl text-[#FF6636]\" data-kid=\"1-4-3-1-2-3-2-2-2\" data-name=\"social creatives icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div class=\"brutalist-border p-8 flex flex-col justify-between bg-[#FF6636] text-[#2A2A29] hover:bg-white transition-all duration-300 group min-h-[300px]\" data-kid=\"1-4-3-1-2-3-3\" data-name=\"creative strategy service card\">\n                            <h3 class=\"font-expressive text-3xl font-black uppercase leading-none italic underline decoration-4\" data-kid=\"1-4-3-1-2-3-3-1\" data-name=\"creative strategy title\">\n                                Creative\n                                <br data-kid=\"1-4-3-1-2-3-3-1-1\"/>\n                                Strategy\n                            </h3>\n                            <div class=\"flex items-end justify-between\" data-kid=\"1-4-3-1-2-3-3-2\" data-name=\"creative strategy info container\">\n                                <p class=\"text-sm font-black max-w-[150px]\" data-kid=\"1-4-3-1-2-3-3-2-1\" data-name=\"creative strategy description\">\n                                    The \"Why\" before the \"What\".\n                                </p>\n                                <i class=\"ti ti-bulb text-5xl\" data-kid=\"1-4-3-1-2-3-3-2-2\" data-name=\"creative strategy icon\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- What Ships & Proof Panel -->\n        <section class=\"py-24 px-6 md:px-12 bg-[#F2F4F8]\" data-kid=\"1-4-4\" data-name=\"deliverables and proof section\">\n            <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row gap-16 lg:gap-24 items-stretch\" data-kid=\"1-4-4-1\" data-name=\"deliverables content container\">\n                <div class=\"lg:w-1/2 flex flex-col justify-between\" data-kid=\"1-4-4-1-1\" data-name=\"deliverables info column\">\n                    <div data-kid=\"1-4-4-1-1-1\" data-name=\"deliverables header\">\n                        <h2 class=\"font-expressive text-6xl font-black text-[#2A2A29] uppercase tracking-tighter mb-12 italic underline decoration-8 decoration-[#FF6636] underline-offset-8\" data-kid=\"1-4-4-1-1-1-1\" data-name=\"deliverables title\">\n                            Deliverables\n                        </h2>\n                        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12\" data-kid=\"1-4-4-1-1-1-2\" data-name=\"deliverables grid\">\n                            <div class=\"border-b-2 border-[#2A2A29]/20 pb-4\" data-kid=\"1-4-4-1-1-1-2-1\" data-name=\"product deliverable item\">\n                                <span class=\"text-xs font-black uppercase text-[#FF6636] block mb-1\" data-kid=\"1-4-4-1-1-1-2-1-1\" data-name=\"product deliverable label\">\n                                    01 PRODUCT\n                                </span>\n                                <h4 class=\"text-2xl font-black text-[#2A2A29] uppercase\" data-kid=\"1-4-4-1-1-1-2-1-2\" data-name=\"product deliverable title\">\n                                    Figma Source & React UI\n                                </h4>\n                            </div>\n                            <div class=\"border-b-2 border-[#2A2A29]/20 pb-4\" data-kid=\"1-4-4-1-1-1-2-2\" data-name=\"motion deliverable item\">\n                                <span class=\"text-xs font-black uppercase text-[#FF6636] block mb-1\" data-kid=\"1-4-4-1-1-1-2-2-1\" data-name=\"motion deliverable label\">\n                                    02 MOTION\n                                </span>\n                                <h4 class=\"text-2xl font-black text-[#2A2A29] uppercase\" data-kid=\"1-4-4-1-1-1-2-2-2\" data-name=\"motion deliverable title\">\n                                    Lottie & MP4 Library\n                                </h4>\n                            </div>\n                            <div class=\"border-b-2 border-[#2A2A29]/20 pb-4\" data-kid=\"1-4-4-1-1-1-2-3\" data-name=\"brand deliverable item\">\n                                <span class=\"text-xs font-black uppercase text-[#FF6636] block mb-1\" data-kid=\"1-4-4-1-1-1-2-3-1\" data-name=\"brand deliverable label\">\n                                    03 BRAND\n                                </span>\n                                <h4 class=\"text-2xl font-black text-[#2A2A29] uppercase\" data-kid=\"1-4-4-1-1-1-2-3-2\" data-name=\"brand deliverable title\">\n                                    DLS & Brand Systems\n                                </h4>\n                            </div>\n                            <div class=\"border-b-2 border-[#2A2A29]/20 pb-4\" data-kid=\"1-4-4-1-1-1-2-4\" data-name=\"dev deliverable item\">\n                                <span class=\"text-xs font-black uppercase text-[#FF6636] block mb-1\" data-kid=\"1-4-4-1-1-1-2-4-1\" data-name=\"dev deliverable label\">\n                                    04 DEV\n                                </span>\n                                <h4 class=\"text-2xl font-black text-[#2A2A29] uppercase\" data-kid=\"1-4-4-1-1-1-2-4-2\" data-name=\"dev deliverable title\">\n                                    Webflow CMS & Deploy\n                                </h4>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-16 bg-[#2A2A29] p-8 text-white brutalist-border\" data-kid=\"1-4-4-1-1-2\" data-name=\"deliverables testimonial block\">\n                        <p class=\"text-2xl font-expressive font-bold leading-tight\" data-kid=\"1-4-4-1-1-2-1\" data-name=\"testimonial text\">\n                            We deliver clean, scalable, and documented assets that your engineering team will actually love.\n                        </p>\n                        <i class=\"ti ti-check text-[#FF6636] text-4xl mt-6 block\" data-kid=\"1-4-4-1-1-2-2\" data-name=\"testimonial check icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2 bg-[#FF6636] p-8 md:p-16 brutalist-border relative overflow-hidden group flex flex-col justify-center\" data-kid=\"1-4-4-1-2\" data-name=\"case proof card\">\n                    <div class=\"relative z-10\" data-kid=\"1-4-4-1-2-1\" data-name=\"case proof content\">\n                        <span class=\"block text-sm font-black uppercase text-[#2A2A29] mb-4\" data-kid=\"1-4-4-1-2-1-1\" data-name=\"case proof label\">\n                            Case Result // Proof\n                        </span>\n                        <div class=\"font-expressive text-7xl md:text-9xl font-black text-[#2A2A29] leading-none mb-8 tracking-tighter\" data-kid=\"1-4-4-1-2-1-2\" data-name=\"case proof statistic\">\n                            140%\n                            <br data-kid=\"1-4-4-1-2-1-2-1\"/>\n                            LIFT\n                        </div>\n                        <p class=\"text-xl md:text-2xl font-black text-[#2A2A29] leading-tight mb-12 max-w-sm\" data-kid=\"1-4-4-1-2-1-3\" data-name=\"case proof description\">\n                            Complete UI/UX overhaul for NexaFlow Enterprise led to a measurable spike in user retention and daily active sessions.\n                        </p>\n                        <a class=\"inline-flex items-center gap-4 text-2xl font-black text-[#2A2A29] hover:gap-8 transition-all duration-300 italic group\" data-kid=\"1-4-4-1-2-1-4\" data-name=\"view case study link\" href=\"#\">\n                            VIEW CASE STUDY\n                            <i class=\"ti ti-arrow-right text-3xl\" data-kid=\"1-4-4-1-2-1-4-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <!-- Background Flourish -->\n                    <div class=\"absolute -right-12 -bottom-12 text-[15rem] font-expressive font-black text-black/5 rotate-12 pointer-events-none group-hover:rotate-0 transition-transform duration-700\" data-kid=\"1-4-4-1-2-2\" data-name=\"case proof decorative text\">\n                        RESULT\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Project CTA Footer -->\n        <section class=\"py-32 px-6 md:px-12 border-t-2 border-white group cursor-pointer relative overflow-hidden bg-[#2A2A29]\" data-kid=\"1-4-5\" data-name=\"project call-to-action section\">\n            <div class=\"max-w-7xl mx-auto relative z-10\" data-kid=\"1-4-5-1\" data-name=\"cta content container\">\n                <div class=\"flex flex-col md:flex-row items-center justify-between gap-12\" data-kid=\"1-4-5-1-1\" data-name=\"cta header row\">\n                    <div class=\"text-center md:text-left\" data-kid=\"1-4-5-1-1-1\" data-name=\"cta title container\">\n                        <h2 class=\"font-expressive text-[clamp(2.5rem,10vw,9rem)] font-black uppercase leading-[0.8] tracking-tighter group-hover:text-[#2A2A29] transition-colors duration-700\" data-kid=\"1-4-5-1-1-1-1\" data-name=\"cta headline text\">\n                            Build your\n                            <br data-kid=\"1-4-5-1-1-1-1-1\"/>\n                            <span class=\"text-[#FF6636] group-hover:text-[#2A2A29]\" data-kid=\"1-4-5-1-1-1-1-2\">\n                                breakthrough.\n                            </span>\n                        </h2>\n                    </div>\n                    <div class=\"relative\" data-kid=\"1-4-5-1-1-2\" data-name=\"cta arrow button container\">\n                        <div class=\"w-48 h-48 md:w-72 md:h-72 bg-[#FF6636] flex items-center justify-center rounded-none brutalist-border rotate-3 group-hover:rotate-[363deg] transition-all duration-1000 ease-in-out\" data-kid=\"1-4-5-1-1-2-1\" data-name=\"cta arrow circle button\">\n                            <i class=\"ti ti-arrow-up-right text-6xl md:text-8xl text-[#2A2A29]\" data-kid=\"1-4-5-1-1-2-1-1\" data-name=\"cta arrow icon\">\n                            </i>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-20 flex flex-wrap justify-between items-end gap-8 border-t-2 border-white/20 pt-12 opacity-40 group-hover:opacity-100 transition-opacity\" data-kid=\"1-4-5-1-2\" data-name=\"cta footer information\">\n                    <div class=\"font-expressive text-3xl font-black uppercase group-hover:text-[#2A2A29]\" data-kid=\"1-4-5-1-2-1\" data-name=\"cta call-to-action title\">\n                        Let's talk scale\n                    </div>\n                    <div class=\"font-expressive text-xl font-bold italic group-hover:text-[#2A2A29]\" data-kid=\"1-4-5-1-2-2\" data-name=\"cta email link\">\n                        hello@dsgraphix.studio\n                    </div>\n                </div>\n            </div>\n            <!-- Interactive Background Reveal -->\n            <div class=\"absolute inset-0 bg-white translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-[cubic-bezier(0.9,0,0.1,1)]\" data-kid=\"1-4-5-2\" data-name=\"cta background reveal layer\">\n            </div>\n        </section>\n    </main>\n    <!-- Shared Compact Footer -->\n    <footer class=\"bg-[#2A2A29] py-12 px-6 md:px-12 border-t border-white/10\" data-kid=\"1-5\" data-name=\"footer\">\n        <div class=\"max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-12\" data-kid=\"1-5-1\" data-name=\"footer links container\">\n            <div data-kid=\"1-5-1-1\" data-name=\"offices section\">\n                <h4 class=\"font-expressive font-bold uppercase text-[#FF6636] mb-6\" data-kid=\"1-5-1-1-1\" data-name=\"offices header\">\n                    Offices\n                </h4>\n                <p class=\"text-sm font-bold opacity-60\" data-kid=\"1-5-1-1-2\" data-name=\"pune office address\">\n                    PUNE, INDIA\n                </p>\n                <p class=\"text-sm font-bold opacity-60 mt-1\" data-kid=\"1-5-1-1-3\" data-name=\"los angeles office address\">\n                    LOS ANGELES, USA\n                </p>\n            </div>\n            <div data-kid=\"1-5-1-2\" data-name=\"connect section\">\n                <h4 class=\"font-expressive font-bold uppercase text-[#FF6636] mb-6\" data-kid=\"1-5-1-2-1\" data-name=\"connect header\">\n                    Connect\n                </h4>\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-5-1-2-2\" data-name=\"social links container\">\n                    <a class=\"text-sm font-bold hover:text-[#FF6636]\" data-kid=\"1-5-1-2-2-1\" data-name=\"linkedin link\" href=\"#\">\n                        LinkedIn\n                    </a>\n                    <a class=\"text-sm font-bold hover:text-[#FF6636]\" data-kid=\"1-5-1-2-2-2\" data-name=\"instagram link\" href=\"#\">\n                        Instagram\n                    </a>\n                    <a class=\"text-sm font-bold hover:text-[#FF6636]\" data-kid=\"1-5-1-2-2-3\" data-name=\"behance link\" href=\"#\">\n                        Behance\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-span-2 md:col-span-2 text-right\" data-kid=\"1-5-1-3\" data-name=\"footer brand section\">\n                <h3 class=\"font-expressive font-black text-4xl uppercase tracking-tighter mb-4 text-[#FF6636]\" data-kid=\"1-5-1-3-1\" data-name=\"footer brand name\">\n                    DS-Graphix\n                </h3>\n                <p class=\"text-xs font-bold opacity-30 uppercase tracking-[0.4em]\" data-kid=\"1-5-1-3-2\" data-name=\"copyright notice text\">\n                    © 2026 All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </footer>\n    <!-- GSAP for Animations -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script type=\"module\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n        \n        gsap.registerPlugin(ScrollTrigger);\n\n        // Smooth Scrolling\n        const lenis = new Lenis({\n            duration: 1.2,\n            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n            orientation: 'vertical',\n            gestureOrientation: 'vertical',\n            smoothWheel: true,\n            wheelMultiplier: 1,\n            smoothTouch: false,\n            touchMultiplier: 2,\n            infinite: false,\n        });\n\n        function raf(time) {\n            lenis.raf(time);\n            requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n\n        // Animations\n        gsap.to('.scrub-text', {\n            scrollTrigger: {\n                trigger: '.scrub-text',\n                start: 'top 80%',\n                end: 'bottom 20%',\n                scrub: 1\n            },\n            y: -80,\n            duration: 1\n        });\n\n        gsap.from('.reveal-up', {\n            scrollTrigger: {\n                trigger: '.reveal-up',\n                start: 'top 90%',\n            },\n            y: 50,\n            opacity: 0,\n            duration: 1,\n            ease: \"power4.out\"\n        });\n\n        // Horizontal Parallax for tickers\n        gsap.to('.diagonal-strip', {\n            scrollTrigger: {\n                trigger: '.diagonal-strip',\n                start: 'top bottom',\n                end: 'bottom top',\n                scrub: true\n            },\n            xPercent: -5\n        });\n    </script>\n</div>\n",
