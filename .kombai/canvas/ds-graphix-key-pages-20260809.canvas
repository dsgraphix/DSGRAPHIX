\"border-b-2 border-[#2A2A29] pb-4\" data-kid=\"4-6-1-1-2-2\" data-name=\"contact channel group\">\n                            <p class=\"text-xs font-black uppercase tracking-widest opacity-50 mb-2\" data-kid=\"4-6-1-1-2-2-1\" data-name=\"label text\">\n                                Direct Channel\n                            </p>\n                            <p class=\"text-2xl font-black uppercase\" data-kid=\"4-6-1-1-2-2-2\" data-name=\"contact detail text\">\n                                hello@ds-graphix.com\n                                <br data-kid=\"4-6-1-1-2-2-2-1\" data-name=\"line break\"/>\n                                +91 98903 88405\n                            </p>\n                        </div>\n                        <div class=\"flex gap-4 pt-4\" data-kid=\"4-6-1-1-2-3\" data-name=\"social media links group\">\n                            <a class=\"w-12 h-12 border-2 border-[#2A2A29] flex items-center justify-center text-xl hover:bg-[#2A2A29] hover:text-white transition-all\" data-kid=\"4-6-1-1-2-3-1\" data-name=\"linkedin link\" href=\"#\">\n                                <i class=\"ti ti-brand-linkedin\" data-kid=\"4-6-1-1-2-3-1-1\" data-name=\"linkedin icon\">\n                                </i>\n                            </a>\n                            <a class=\"w-12 h-12 border-2 border-[#2A2A29] flex items-center justify-center text-xl hover:bg-[#2A2A29] hover:text-white transition-all\" data-kid=\"4-6-1-1-2-3-2\" data-name=\"twitter link\" href=\"#\">\n                                <i class=\"ti ti-brand-twitter\" data-kid=\"4-6-1-1-2-3-2-1\" data-name=\"twitter icon\">\n                                </i>\n                            </a>\n                            <a class=\"w-12 h-12 border-2 border-[#2A2A29] flex items-center justify-center text-xl hover:bg-[#2A2A29] hover:text-white transition-all\" data-kid=\"4-6-1-1-2-3-3\" data-name=\"instagram link\" href=\"#\">\n                                <i class=\"ti ti-brand-instagram\" data-kid=\"4-6-1-1-2-3-3-1\" data-name=\"instagram icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"relative\" data-kid=\"4-6-1-2\" data-name=\"contact form column\">\n                    <form class=\"space-y-12\" data-kid=\"4-6-1-2-1\" data-name=\"contact form\">\n                        <div data-kid=\"4-6-1-2-1-1\" data-name=\"name input group\">\n                            <input class=\"brutalist-input\" data-kid=\"4-6-1-2-1-1-1\" data-name=\"name input field\" placeholder=\"Your Name\" type=\"text\"/>\n                        </div>\n                        <div data-kid=\"4-6-1-2-1-2\" data-name=\"email input group\">\n                            <input class=\"brutalist-input\" data-kid=\"4-6-1-2-1-2-1\" data-name=\"email input field\" placeholder=\"Work Email\" type=\"email\"/>\n                        </div>\n                        <div data-kid=\"4-6-1-2-1-3\" data-name=\"brief textarea group\">\n                            <textarea class=\"brutalist-input resize-none\" data-kid=\"4-6-1-2-1-3-1\" data-name=\"brief textarea field\" placeholder=\"Project Brief\" rows=\"2\"></textarea>\n                        </div>\n                        <button class=\"w-full bg-[#2A2A29] text-white py-8 text-3xl font-black uppercase tracking-tight hover:bg-white hover:text-[#2A2A29] transition-all border-4 border-transparent hover:border-[#2A2A29] active:scale-95\" data-kid=\"4-6-1-2-1-4\" data-name=\"form submit button\" type=\"submit\">\n                            Submit Inquiry\n                        </button>\n                    </form>\n                </div>\n            </div>\n            <div class=\"mt-32 pt-12 border-t-2 border-[#2A2A29]/20 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"4-6-2\" data-name=\"copyright and legal area\">\n                <span class=\"text-sm font-black uppercase tracking-widest\" data-kid=\"4-6-2-1\" data-name=\"copyright notice text\">\n                    © 2026 DS-Graphix Studio. All Rights Reserved.\n                </span>\n                <div class=\"flex gap-12 uppercase text-xs font-black tracking-widest opacity-50\" data-kid=\"4-6-2-2\" data-name=\"legal links group\">\n                    <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"4-6-2-2-1\" data-name=\"privacy policy link\" href=\"#\">\n                        Privacy Policy\n                    </a>\n                    <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"4-6-2-2-2\" data-name=\"terms of service link\" href=\"#\">\n                        Terms of Service\n                    </a>\n                </div>\n            </div>\n        </footer>\n    </main>\n    <!-- WhatsApp Sticky Tab -->\n    <a class=\"fixed right-0 top-1/2 -translate-y-1/2 z-[200] bg-[#FF6636] border-2 border-white px-3 py-8 sticky-whatsapp group hover:bg-[#2A2A29] transition-all flex flex-col items-center gap-2 shadow-xl\" data-kid=\"5\" data-name=\"whatsapp sticky chat button\" href=\"https://wa.me/919890388405\">\n        <i class=\"ti ti-brand-whatsapp text-2xl text-white group-hover:text-[#FF6636] rotate-180\" data-kid=\"5-1\" data-name=\"whatsapp icon\">\n        </i>\n        <span class=\"text-xs font-black uppercase tracking-widest text-white group-hover:text-[#FF6636]\" data-kid=\"5-2\" data-name=\"chat label text\">\n            Chat with us\n        </span>\n    </a>\n    <!-- Scripts -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script type=\"module\">\n        import Lenis from \"https://esm.sh/lenis@1\";\n        \n        // Initialize Lenis\n        const lenis = new Lenis({\n            duration: 1.2,\n            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n            orientation: 'vertical',\n            gestureOrientation: 'vertical',\n            smoothWheel: true,\n        });\n\n        // GSAP ScrollTrigger Integration\n        gsap.registerPlugin(ScrollTrigger);\n        \n        gsap.ticker.add((time) => {\n            lenis.raf(time * 1000); \n        });\n        gsap.ticker.lagSmoothing(0);\n        \n        lenis.on('scroll', ScrollTrigger.update);\n\n        // Entrance Animations\n        gsap.from(\".reveal-text\", {\n            y: 100,\n            opacity: 0,\n            duration: 1.5,\n            ease: \"expo.out\",\n            stagger: 0.2\n        });\n\n        // Parallax effects\n        gsap.utils.toArray('[data-scroll]').forEach(el => {\n            const speed = el.dataset.scrollSpeed || 1;\n            gsap.to(el, {\n                y: (i, target) => -100 * speed,\n                ease: \"none\",\n                scrollTrigger: {\n                    trigger: el,\n                    start: \"top bottom\",\n                    end: \"bottom top\",\n                    scrub: true\n                }\n            });\n        });\n    </script>\n</body>\n",
      "comments": [],
      "created": "2026-08-09T11:39:40.229769+00:00",
      "modified": "2026-08-09T11:39:40.229769+00:00",
      "id": "var_372a00f1f387"
    },
    "var_55f046f4d073": {
      "type": "variant",
      "label": "Systems-Led — Home",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8280,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n    @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n    :root {\n        --color-canvas: #F2F4F8;\n        --color-card: #FFFFFF;\n        --color-text: #2A2A29;\n        --color-accent: #FF6636;\n    }\n\n    .font-jakarta {\n        font-family: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    .soft-elevation {\n        box-shadow: 0 2px 8px rgba(0,0,0,0.04), 0 1px 2px rgba(0,0,0,0.02);\n    }\n\n    .thin-border {\n        border: 1px solid rgba(42, 42, 41, 0.1);\n    }\n\n    .custom-scrollbar::-webkit-scrollbar {\n        width: 6px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n        background: var(--color-canvas);\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n        background: rgba(42, 42, 41, 0.15);\n        border-radius: 10px;\n    }\n\n    /* Gantt - NO CSS TRANSITION here as it conflicts with GSAP */\n    .gantt-bar {\n        position: relative;\n    }\n\n    .gantt-bar::before {\n        content: '';\n        position: absolute;\n        left: -4px;\n        top: 0;\n        bottom: 0;\n        width: 4px;\n        background: currentColor;\n    }\n\n    /* System Grid Background */\n    .bg-grid {\n        background-image: radial-gradient(rgba(42, 42, 41, 0.05) 1px, transparent 1px);\n        background-size: 24px 24px;\n    }\n\n    /* Slider Track */\n    .slider-track {\n        background: linear-gradient(to right, var(--color-accent) 40%, #E5E7EB 40%);\n    }\n\n    .active-row {\n        background-color: var(--color-accent);\n        color: white;\n    }\n\n    .active-row * {\n        color: white !important;\n        opacity: 1 !important;\n    }\n</style>\n<div class=\"font-jakarta bg-[var(--color-canvas)] text-[var(--color-text)] overflow-x-clip m-0 p-0 box-border scroll-smooth\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Header / Navbar -->\n    <header class=\"fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-xl border-b border-[var(--color-text)]/10 px-8 py-4\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <div class=\"max-w-[1520px] mx-auto flex items-center justify-between gap-12\" data-kid=\"1-1-1\" data-name=\"navigation flex container\">\n            <!-- Wordmark -->\n            <a class=\"flex items-center gap-3 shrink-0 no-underline text-[var(--color-text)]\" data-kid=\"1-1-1-1\" data-name=\"brand identity wordmark\" href=\"#\">\n                <div class=\"w-9 h-9 bg-[var(--color-text)] rounded-sm flex items-center justify-center\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon container\">\n                    <span class=\"text-white font-black text-xl\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo text\">\n                        D\n                    </span>\n                </div>\n                <span class=\"font-extrabold text-2xl tracking-tighter\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    DS-GRAPHIX\n                </span>\n            </a>\n            <!-- Search Field - Integrated & Functional -->\n            <div class=\"flex-1 max-w-2xl hidden lg:block\" data-kid=\"1-1-1-2\" data-name=\"search input container\">\n                <div class=\"relative group\" data-kid=\"1-1-1-2-1\" data-name=\"search field wrapper\">\n                    <i class=\"ti ti-command absolute left-4 top-1/2 -translate-y-1/2 text-[var(--color-text)]/30 text-lg\" data-kid=\"1-1-1-2-1-1\" data-name=\"command icon\">\n                    </i>\n                    <input class=\"w-full bg-[var(--color-canvas)]/50 border border-[var(--color-text)]/10 focus:border-[var(--color-accent)]/50 rounded-lg py-2.5 pl-12 pr-4 text-sm outline-hidden transition-all group-hover:bg-white group-hover:shadow-sm\" data-kid=\"1-1-1-2-1-2\" data-name=\"search input field\" placeholder=\"Search systems, deliverables, or metrics...\" type=\"text\"/>\n                    <div class=\"absolute right-4 top-1/2 -translate-y-1/2 flex items-center gap-2\" data-kid=\"1-1-1-2-1-3\" data-name=\"search shortcut helper container\">\n                        <span class=\"text-[10px] font-bold opacity-30 tracking-widest\" data-kid=\"1-1-1-2-1-3-1\" data-name=\"shortcut keys text\">\n                            PRESS ⌘ + K\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- Actions -->\n            <div class=\"flex items-center gap-6\" data-kid=\"1-1-1-3\" data-name=\"navigation actions container\">\n                <nav class=\"hidden xl:flex items-center gap-8 text-[10px] font-black uppercase tracking-[0.2em] opacity-40\" data-kid=\"1-1-1-3-1\" data-name=\"navigation link list\">\n                    <a class=\"hover:text-[var(--color-accent)] transition-colors no-underline text-[var(--color-text)]\" data-kid=\"1-1-1-3-1-1\" data-name=\"systems link\" href=\"#\">\n                        Systems\n                    </a>\n                    <a class=\"hover:text-[var(--color-accent)] transition-colors no-underline text-[var(--color-text)]\" data-kid=\"1-1-1-3-1-2\" data-name=\"inventory link\" href=\"#\">\n                        Inventory\n                    </a>\n                </nav>\n                <div class=\"w-px h-6 bg-[var(--color-text)]/10 hidden xl:block\" data-kid=\"1-1-1-3-2\" data-name=\"divider line\">\n                </div>\n                <button class=\"bg-[var(--color-accent)] text-white px-6 py-3 rounded-lg text-xs font-black uppercase tracking-[0.15em] hover:brightness-110 active:scale-95 transition-all border-none cursor-pointer shadow-lg shadow-[var(--color-accent)]/20 relative overflow-hidden group\" data-kid=\"1-1-1-3-3\" data-name=\"build project button\">\n                    <span class=\"relative z-10\" data-kid=\"1-1-1-3-3-1\" data-name=\"button label text\">\n                        Build Project\n                    </span>\n                    <div class=\"absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300\" data-kid=\"1-1-1-3-3-2\" data-name=\"button hover background animation overlay\">\n                    </div>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"pt-32 pb-24 space-y-32\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Rebuilt Hero: System Orchestrator -->\n        <section class=\"max-w-[1520px] mx-auto px-8 relative\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\" data-kid=\"1-2-1-1\" data-name=\"hero grid container\">\n                <!-- Large Content Column -->\n                <div class=\"lg:col-span-8 space-y-12\" data-kid=\"1-2-1-1-1\" data-name=\"large content column\">\n                    <div class=\"space-y-6\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero label container\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"version label text\">\n                            <span class=\"text-[var(--color-accent)] text-sm font-black uppercase tracking-[0.3em]\" data-kid=\"1-2-1-1-1-1-1-1\">\n                                Version 2.0.24\n                            </span>\n                            <div class=\"h-px w-20 bg-[var(--color-text)]/10\" data-kid=\"1-2-1-1-1-1-1-2\">\n                            </div>\n                        </div>\n                        <h1 class=\"text-6xl lg:text-8xl font-black leading-[0.95] tracking-tighter max-w-4xl\" data-kid=\"1-2-1-1-1-1-2\" data-name=\"spacer divider\">\n                            Creative systems that scale with your\n                            <span class=\"text-transparent bg-clip-text bg-[var(--color-text)] opacity-40\" data-kid=\"1-2-1-1-1-1-2-1\">\n                                next stage.\n                            </span>\n                        </h1>\n                        <p class=\"text-xl lg:text-2xl text-[var(--color-text)]/50 max-w-2xl leading-relaxed\" data-kid=\"1-2-1-1-1-1-3\">\n                            We architect high-fidelity design infrastructures for software teams that demand speed without sacrificing systematic rigour.\n                        </p>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-6\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero headline text\">\n                        <button class=\"bg-[var(--color-text)] text-white px-10 py-5 rounded-lg font-black uppercase tracking-[0.2em] hover:bg-black transition-all border-none cursor-pointer flex items-center gap-4 group\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"headline emphasis text\">\n                            Initialize Project\n                            <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"1-2-1-1-1-2-1-1\">\n                            </i>\n                        </button>\n                        <div class=\"flex items-center gap-4 bg-white thin-border px-6 py-4 rounded-lg soft-elevation\" data-kid=\"1-2-1-1-1-2-2\">\n                            <div class=\"w-12 h-12 bg-green-500/10 text-green-600 rounded-full flex items-center justify-center text-2xl\" data-kid=\"1-2-1-1-1-2-2-1\">\n                                <i class=\"ti ti-activity\" data-kid=\"1-2-1-1-1-2-2-1-1\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-2-1-1-1-2-2-2\">\n                                <span class=\"block text-[10px] font-black opacity-30 uppercase\" data-kid=\"1-2-1-1-1-2-2-2-1\">\n                                    System Status\n                                </span>\n                                <span class=\"font-bold\" data-kid=\"1-2-1-1-1-2-2-2-2\">\n                                    Next Sprint: March 12\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Metrics Grid (More distinctive than bento) -->\n                    <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\" data-kid=\"1-2-1-1-1-3\" data-name=\"subheadline text\">\n                        <div class=\"bg-white thin-border p-6 rounded-lg space-y-2\" data-kid=\"1-2-1-1-1-3-1\">\n                            <span class=\"block text-[10px] font-black opacity-30 uppercase tracking-widest\" data-kid=\"1-2-1-1-1-3-1-1\">\n                                Deployments\n                            </span>\n                            <span class=\"text-4xl font-black text-[var(--color-accent)]\" data-kid=\"1-2-1-1-1-3-1-2\">\n                                140+\n                            </span>\n                        </div>\n                        <div class=\"bg-white thin-border p-6 rounded-lg space-y-2\" data-kid=\"1-2-1-1-1-3-2\">\n                            <span class=\"block text-[10px] font-black opacity-30 uppercase tracking-widest\" data-kid=\"1-2-1-1-1-3-2-1\">\n                                Performance\n                            </span>\n                            <span class=\"text-4xl font-black\" data-kid=\"1-2-1-1-1-3-2-2\">\n                                99.2%\n                            </span>\n                        </div>\n                        <div class=\"bg-white thin-border p-6 rounded-lg space-y-2\" data-kid=\"1-2-1-1-1-3-3\">\n                            <span class=\"block text-[10px] font-black opacity-30 uppercase tracking-widest\" data-kid=\"1-2-1-1-1-3-3-1\">\n                                Active Brands\n                            </span>\n                            <span class=\"text-4xl font-black\" data-kid=\"1-2-1-1-1-3-3-2\">\n                                200+\n                            </span>\n                        </div>\n                        <div class=\"bg-white thin-border p-6 rounded-lg space-y-2\" data-kid=\"1-2-1-1-1-3-4\">\n                            <span class=\"block text-[10px] font-black opacity-30 uppercase tracking-widest\" data-kid=\"1-2-1-1-1-3-4-1\">\n                                Uptime\n                            </span>\n                            <span class=\"text-4xl font-black\" data-kid=\"1-2-1-1-1-3-4-2\">\n                                24/7\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Visual Stack Column -->\n                <div class=\"lg:col-span-4 space-y-8\" data-kid=\"1-2-1-1-2\" data-name=\"visual stack column\">\n                    <div class=\"bg-[var(--color-text)] rounded-xl overflow-hidden soft-elevation relative group aspect-square lg:aspect-auto lg:h-[600px]\" data-kid=\"1-2-1-1-2-1\" data-name=\"featured project card\">\n                        <img alt=\"System Interface Mockup\" class=\"w-full h-full object-cover opacity-80 mix-blend-luminosity group-hover:mix-blend-normal transition-all duration-700\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"featured image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&w=800&q=80&fit=crop\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent p-8 flex flex-col justify-end\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"featured project details\">\n                            <span class=\"text-[var(--color-accent)] text-xs font-black uppercase tracking-widest mb-2\" data-kid=\"1-2-1-1-2-1-2-1\" data-name=\"live environment label\">\n                                Live Environment\n                            </span>\n                            <h3 class=\"text-white text-xl font-bold\" data-kid=\"1-2-1-1-2-1-2-2\" data-name=\"project title\">\n                                Fintech Core Terminal v4.0\n                            </h3>\n                            <div class=\"mt-4 flex gap-2\" data-kid=\"1-2-1-1-2-1-2-3\" data-name=\"pulse status dots container\">\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse\" data-kid=\"1-2-1-1-2-1-2-3-1\" data-name=\"pulse dot\">\n                                </div>\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse delay-100\" data-kid=\"1-2-1-1-2-1-2-3-2\" data-name=\"pulse dot\">\n                                </div>\n                                <div class=\"w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse delay-200\" data-kid=\"1-2-1-1-2-1-2-3-3\" data-name=\"pulse dot\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Decorative Grid Underlay -->\n            <div class=\"absolute -z-10 top-0 left-0 w-full h-full bg-grid opacity-20 pointer-events-none\" data-kid=\"1-2-1-2\" data-name=\"decorative grid background\">\n            </div>\n        </section>\n        <!-- Refactored Service Matrix: Minimalist & Clean -->\n        <section class=\"max-w-[1520px] mx-auto px-8\" data-kid=\"1-2-2\" data-name=\"service matrix section\">\n            <div class=\"mb-16 flex flex-col md:flex-row md:items-end justify-between gap-8\" data-kid=\"1-2-2-1\" data-name=\"section header container\">\n                <div class=\"space-y-4\" data-kid=\"1-2-2-1-1\" data-name=\"section titles\">\n                    <h2 class=\"text-4xl lg:text-5xl font-black tracking-tighter\" data-kid=\"1-2-2-1-1-1\" data-name=\"service matrix headline\">\n                        Concrete Deliverables.\n                    </h2>\n                    <p class=\"text-lg text-[var(--color-text)]/50 max-w-xl\" data-kid=\"1-2-2-1-1-2\" data-name=\"service matrix description\">\n                        We replace abstract design terms with concrete, production-ready system outputs.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-4 text-xs font-black opacity-40 tracking-widest uppercase\" data-kid=\"1-2-2-1-2\" data-name=\"filter controls container\">\n                    <span data-kid=\"1-2-2-1-2-1\" data-name=\"filter label\">\n                        Filter:\n                    </span>\n                    <button class=\"bg-[var(--color-text)] text-white px-3 py-1 rounded\" data-kid=\"1-2-2-1-2-2\" data-name=\"active filter button\">\n                        All Systems\n                    </button>\n                    <button class=\"hover:text-[var(--color-accent)]\" data-kid=\"1-2-2-1-2-3\" data-name=\"ui ux filter button\">\n                        UI/UX\n                    </button>\n                    <button class=\"hover:text-[var(--color-accent)]\" data-kid=\"1-2-2-1-2-4\" data-name=\"identity filter button\">\n                        Identity\n                    </button>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 thin-border rounded-xl overflow-hidden bg-white\" data-kid=\"1-2-2-2\" data-name=\"service grid container\">\n                <!-- UI/UX -->\n                <div class=\"p-10 border-b md:border-b-0 md:border-r border-[var(--color-text)]/10 hover:bg-[var(--color-canvas)]/30 transition-colors group flex flex-col justify-between\" data-kid=\"1-2-2-2-1\" data-name=\"service card\">\n                    <div data-kid=\"1-2-2-2-1-1\" data-name=\"service card content\">\n                        <span class=\"text-[10px] font-black opacity-20 uppercase tracking-[0.3em] mb-8 block\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"service reference code\">\n                            Ref: SYS-01\n                        </span>\n                        <h3 class=\"text-3xl font-black mb-8 leading-none\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"service title\">\n                            Interface Architecture\n                        </h3>\n                        <ul class=\"space-y-4 list-none p-0 m-0\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"service feature list\">\n                            <li class=\"flex items-center gap-3 text-sm font-medium\" data-kid=\"1-2-2-2-1-1-3-1\" data-name=\"service feature\">\n                                <i class=\"ti ti-check text-[var(--color-accent)]\" data-kid=\"1-2-2-2-1-1-3-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                                Multi-state Component Libraries\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm font-medium\" data-kid=\"1-2-2-2-1-1-3-2\" data-name=\"service feature\">\n                                <i class=\"ti ti-check text-[var(--color-accent)]\" data-kid=\"1-2-2-2-1-1-3-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                Scalable Design Tokens\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm font-medium\" data-kid=\"1-2-2-2-1-1-3-3\" data-name=\"service feature\">\n                                <i class=\"ti ti-check text-[var(--color-accent)]\" data-kid=\"1-2-2-2-1-1-3-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                High-Fidelity Logic Mapping\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm font-bold opacity-30 mt-6\" data-kid=\"1-2-2-2-1-1-3-4\" data-name=\"service duration\">\n                                <i class=\"ti ti-clock\" data-kid=\"1-2-2-2-1-1-3-4-1\" data-name=\"clock icon\">\n                                </i>\n                                4-6 WEEKS\n                            </li>\n                        </ul>\n                        <a class=\"mt-10 inline-flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.2em] text-[var(--color-accent)] no-underline border-b border-[var(--color-accent)]/20 pb-1 hover:border-[var(--color-accent)] transition-all w-fit\" data-kid=\"1-2-2-2-1-1-4\" data-name=\"view docs link\" href=\"#\">\n                            View Docs\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-2-1-1-4-1\" data-name=\"arrow link icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <!-- Branding -->\n                    <div class=\"p-10 border-b lg:border-b-0 lg:border-r border-[var(--color-text)]/10 hover:bg-[var(--color-canvas)]/30 transition-colors group\" data-kid=\"1-2-2-2-1-2\" data-name=\"service card\">\n                        <span class=\"text-xs font-black opacity-30 uppercase tracking-[0.2em] mb-8 block\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"service reference code\">\n                            System 02\n                        </span>\n                        <h3 class=\"text-2xl font-black mb-6\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"service title\">\n                            Visual Identity OS\n                        </h3>\n                        <ul class=\"space-y-4 list-none p-0 m-0\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"service feature list\">\n                            <li class=\"flex items-center gap-3 text-sm font-medium\" data-kid=\"1-2-2-2-1-2-3-1\" data-name=\"service feature\">\n                                <i class=\"ti ti-check text-[var(--color-accent)]\" data-kid=\"1-2-2-2-1-2-3-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                                Dynamic Brand Guidelines\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm font-medium\" data-kid=\"1-2-2-2-1-2-3-2\" data-name=\"service feature\">\n                                <i class=\"ti ti-check text-[var(--color-accent)]\" data-kid=\"1-2-2-2-1-2-3-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                Generative Logo Systems\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm font-medium\" data-kid=\"1-2-2-2-1-2-3-3\" data-name=\"service feature\">\n                                <i class=\"ti ti-check text-[var(--color-accent)]\" data-kid=\"1-2-2-2-1-2-3-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                Type-driven Architecture\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm font-medium opacity-40\" data-kid=\"1-2-2-2-1-2-3-4\" data-name=\"service duration\">\n                                <i class=\"ti ti-clock\" data-kid=\"1-2-2-2-1-2-3-4-1\" data-name=\"clock icon\">\n                                </i>\n                                Window: 3-4 Weeks\n                            </li>\n                        </ul>\n                        <a class=\"mt-8 inline-flex items-center gap-2 text-sm font-black uppercase tracking-widest text-[var(--color-accent)] no-underline opacity-60 hover:opacity-100 transition-opacity\" data-kid=\"1-2-2-2-1-2-4\" data-name=\"view details link\" href=\"#\">\n                            View Details\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-2-1-2-4-1\" data-name=\"arrow link icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <!-- Motion -->\n                    <div class=\"p-10 hover:bg-[var(--color-canvas)]/30 transition-colors group\" data-kid=\"1-2-2-2-1-3\" data-name=\"service card\">\n                        <span class=\"text-xs font-black opacity-30 uppercase tracking-[0.2em] mb-8 block\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"service reference code\">\n                            System 03\n                        </span>\n                        <h3 class=\"text-2xl font-black mb-6\" data-kid=\"1-2-2-2-1-3-2\" data-name=\"service title\">\n                            Motion Dynamics\n                        </h3>\n                        <ul class=\"space-y-4 list-none p-0 m-0\" data-kid=\"1-2-2-2-1-3-3\" data-name=\"service feature list\">\n                            <li class=\"flex items-center gap-3 text-sm font-medium\" data-kid=\"1-2-2-2-1-3-3-1\" data-name=\"service feature\">\n                                <i class=\"ti ti-check text-[var(--color-accent)]\" data-kid=\"1-2-2-2-1-3-3-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                                Product Reveal Sequences\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm font-medium\" data-kid=\"1-2-2-2-1-3-3-2\" data-name=\"service feature\">\n                                <i class=\"ti ti-check text-[var(--color-accent)]\" data-kid=\"1-2-2-2-1-3-3-2-1\" data-name=\"checkmark icon\">\n                                </i>\n                                Interaction Micro-Anims\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm font-medium\" data-kid=\"1-2-2-2-1-3-3-3\" data-name=\"service feature\">\n                                <i class=\"ti ti-check text-[var(--color-accent)]\" data-kid=\"1-2-2-2-1-3-3-3-1\" data-name=\"checkmark icon\">\n                                </i>\n                                Social Narrative Reels\n                            </li>\n                            <li class=\"flex items-center gap-3 text-sm font-medium opacity-40\" data-kid=\"1-2-2-2-1-3-3-4\" data-name=\"service duration\">\n                                <i class=\"ti ti-clock\" data-kid=\"1-2-2-2-1-3-3-4-1\" data-name=\"clock icon\">\n                                </i>\n                                Window: 1-2 Weeks\n                            </li>\n                        </ul>\n                        <a class=\"mt-8 inline-flex items-center gap-2 text-sm font-black uppercase tracking-widest text-[var(--color-accent)] no-underline opacity-60 hover:opacity-100 transition-opacity\" data-kid=\"1-2-2-2-1-3-4\" data-name=\"view details link\" href=\"#\">\n                            View Details\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-2-1-3-4-1\" data-name=\"arrow link icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Board Selection Portfolio (Refined Detail View) -->\n        <section class=\"max-w-[1520px] mx-auto px-8\" data-kid=\"1-2-3\" data-name=\"portfolio section\">\n            <div class=\"bg-white rounded-xl thin-border soft-elevation overflow-hidden flex flex-col lg:flex-row h-auto lg:h-[750px]\" data-kid=\"1-2-3-1\" data-name=\"portfolio container\">\n                <!-- Left Sidebar -->\n                <div class=\"w-full lg:w-[450px] border-b lg:border-b-0 lg:border-r border-[var(--color-text)]/10 flex flex-col\" data-kid=\"1-2-3-1-1\" data-name=\"sidebar container\">\n                    <div class=\"p-10 border-b border-[var(--color-text)]/10 bg-[var(--color-canvas)]/20\" data-kid=\"1-2-3-1-1-1\" data-name=\"sidebar header\">\n                        <h3 class=\"text-2xl font-black tracking-tighter\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"sidebar title\">\n                            Inventory\n                        </h3>\n                        <p class=\"text-xs font-bold opacity-30 uppercase tracking-widest mt-2\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"sidebar subtitle\">\n                            Filterable Case Studies\n                        </p>\n                    </div>\n                    <div class=\"flex-1 overflow-y-auto custom-scrollbar\" data-kid=\"1-2-3-1-1-2\" data-name=\"portfolio item list\">\n                        <div class=\"p-10 border-b border-[var(--color-text)]/10 bg-[var(--color-accent)] text-white cursor-pointer portfolio-item\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"portfolio project button\" data-project=\"fintech\">\n                            <span class=\"text-[10px] font-black uppercase tracking-widest opacity-60 block mb-2\" data-kid=\"1-2-3-1-1-2-1-1\" data-name=\"project category\">\n                                UI Systems / Fintech\n                            </span>\n                            <h4 class=\"text-3xl font-black mb-4\" data-kid=\"1-2-3-1-1-2-1-2\" data-name=\"project title\">\n                                Core 2.0\n                            </h4>\n                            <div class=\"flex items-center gap-4 text-[10px] font-black opacity-60 uppercase\" data-kid=\"1-2-3-1-1-2-1-3\" data-name=\"project stats container\">\n                                <span data-kid=\"1-2-3-1-1-2-1-3-1\" data-name=\"metric value\">\n                                    Metric: +42.8%\n                                </span>\n                                <div class=\"w-1 h-1 rounded-full bg-white\" data-kid=\"1-2-3-1-1-2-1-3-2\" data-name=\"separator dot\">\n                                </div>\n                                <span data-kid=\"1-2-3-1-1-2-1-3-3\" data-name=\"project year\">\n                                    Deployed: 2024\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"p-10 border-b border-[var(--color-text)]/10 hover:bg-[var(--color-canvas)]/40 cursor-pointer transition-all portfolio-item\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"portfolio project button\" data-project=\"ecoflow\">\n                            <span class=\"text-[10px] font-black uppercase tracking-widest opacity-30 block mb-2\" data-kid=\"1-2-3-1-1-2-2-1\" data-name=\"project category\">\n                                Brand OS / Energy\n                            </span>\n                            <h4 class=\"text-3xl font-black mb-4\" data-kid=\"1-2-3-1-1-2-2-2\" data-name=\"project title\">\n                                EcoFlow Global\n                            </h4>\n                            <div class=\"flex items-center gap-4 text-[10px] font-black opacity-30 uppercase\" data-kid=\"1-2-3-1-1-2-2-3\" data-name=\"project stats container\">\n                                <span data-kid=\"1-2-3-1-1-2-2-3-1\" data-name=\"metric value\">\n                                    Metric: +65.2%\n                                </span>\n                                <div class=\"w-1 h-1 rounded-full bg-[var(--color-text)]\" data-kid=\"1-2-3-1-1-2-2-3-2\" data-name=\"separator dot\">\n                                </div>\n                                <span data-kid=\"1-2-3-1-1-2-2-3-3\" data-name=\"project year\">\n                                    Deployed: 2023\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Right Detail (High density dashboard view) -->\n                <div class=\"flex-1 p-10 lg:p-20 relative overflow-hidden flex flex-col\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2\" data-name=\"detail panel container\" data-reason=\"project title, description, and stats text replaced by script on click\" id=\"project-detail\">\n                    <div class=\"relative z-10 flex-1 flex flex-col justify-center\" data-kid=\"1-2-3-1-2-1\" data-name=\"detail content container\">\n                        <div class=\"max-w-3xl space-y-8\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"detail content wrapper\">\n                            <div class=\"flex items-center gap-4\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"active status header container\">\n                                <span class=\"px-3 py-1 bg-[var(--color-text)] text-white text-[10px] font-black uppercase tracking-widest\" data-kid=\"1-2-3-1-2-1-1-1-1\" data-name=\"active status label\">\n                                    Active Report\n                                </span>\n                                <div class=\"h-px flex-1 bg-[var(--color-text)]/10\" data-kid=\"1-2-3-1-2-1-1-1-2\" data-name=\"status separator line\">\n                                </div>\n                            </div>\n                            <h2 class=\"text-5xl lg:text-7xl font-black leading-[0.9] tracking-tighter\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"project headline\" data-reason=\"text replaced by script on click\" id=\"detail-title\">\n                                Optimizing Data Density for Global Fintech.\n                            </h2>\n                            <p class=\"text-xl lg:text-2xl text-[var(--color-text)]/50 leading-relaxed max-w-2xl\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-1-1-3\" data-name=\"project description\" data-reason=\"text replaced by script on click\" id=\"detail-desc\">\n                                Re-architected the terminal experience for high-stakes decision makers, resulting in a 30% reduction in cognitive switch time.\n                            </p>\n                            <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-8 pt-8\" data-kid=\"1-2-3-1-2-1-1-4\" data-name=\"stats grid\">\n                                <div class=\"space-y-2\" data-kid=\"1-2-3-1-2-1-1-4-1\" data-name=\"stat box\">\n                                    <span class=\"block text-[10px] font-black opacity-30 uppercase\" data-kid=\"1-2-3-1-2-1-1-4-1-1\" data-name=\"stat label\">\n                                        User Flow\n                                    </span>\n                                    <div class=\"text-3xl font-black text-[var(--color-accent)]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-1-1-4-1-2\" data-name=\"stat value\" data-reason=\"text replaced by script on click\" id=\"detail-stat-1\">\n                                        +42.8%\n                                    </div>\n                                </div>\n                                <div class=\"space-y-2\" data-kid=\"1-2-3-1-2-1-1-4-2\" data-name=\"stat box\">\n                                    <span class=\"block text-[10px] font-black opacity-30 uppercase\" data-kid=\"1-2-3-1-2-1-1-4-2-1\" data-name=\"stat label\">\n                                        Load Delay\n                                    </span>\n                                    <div class=\"text-3xl font-black\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-1-1-4-2-2\" data-name=\"stat value\" data-reason=\"text replaced by script on click\" id=\"detail-stat-2\">\n                                        -2.4s\n                                    </div>\n                                </div>\n                                <div class=\"space-y-2\" data-kid=\"1-2-3-1-2-1-1-4-3\" data-name=\"stat box\">\n                                    <span class=\"block text-[10px] font-black opacity-30 uppercase\" data-kid=\"1-2-3-1-2-1-1-4-3-1\" data-name=\"stat label\">\n                                        Production\n                                    </span>\n                                    <div class=\"text-3xl font-black\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-1-1-4-3-2\" data-name=\"stat value\" data-reason=\"text replaced by script on click\" id=\"detail-stat-3\">\n                                        3.5x\n                                    </div>\n                                </div>\n                                <div class=\"space-y-2\" data-kid=\"1-2-3-1-2-1-1-4-4\" data-name=\"stat box\">\n                                    <span class=\"block text-[10px] font-black opacity-30 uppercase\" data-kid=\"1-2-3-1-2-1-1-4-4-1\" data-name=\"stat label\">\n                                        Uptime\n                                    </span>\n                                    <div class=\"text-3xl font-black\" data-kid=\"1-2-3-1-2-1-1-4-4-2\" data-name=\"stat value\">\n                                        100%\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"pt-8\" data-kid=\"1-2-3-1-2-1-1-5\" data-name=\"full audit action container\">\n                                <button class=\"bg-[var(--color-text)] text-white px-10 py-5 rounded-lg font-black uppercase tracking-[0.2em] border-none cursor-pointer flex items-center gap-4 hover:brightness-110 transition-all\" data-kid=\"1-2-3-1-2-1-1-5-1\" data-name=\"full audit button\">\n                                    View Full System Audit\n                                    <i class=\"ti ti-arrow-right\" data-kid=\"1-2-3-1-2-1-1-5-1-1\" data-name=\"arrow icon\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Architecture SVG background (Software feel) -->\n                    <div class=\"absolute right-0 bottom-0 opacity-[0.05] pointer-events-none select-none translate-x-20 translate-y-20\" data-kid=\"1-2-3-1-2-2\" data-name=\"decorative architecture icon container\">\n                        <i class=\"ti ti-box-margin text-[600px]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"box icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Improved Gantt Chart: Taller bars, more legible -->\n        <section class=\"max-w-[1520px] mx-auto px-8\" data-kid=\"1-2-4\" data-name=\"workflow section\">\n            <div class=\"bg-white rounded-xl thin-border soft-elevation p-12 lg:p-20 space-y-16\" data-kid=\"1-2-4-1\" data-name=\"workflow