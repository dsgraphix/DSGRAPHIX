        "x": 13800,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap');\n\n  :root {\n    --color-orange: #FF6636;\n    --color-dark: #2A2A29;\n    --color-light: #F2F4F8;\n    --color-white: #FFFFFF;\n    --font-serif: 'Fraunces', serif;\n    --font-sans: 'DM Sans', sans-serif;\n  }\n\n  body {\n    background-color: var(--color-white);\n    color: var(--color-dark);\n    font-family: var(--font-sans);\n    margin: 0;\n    overflow-x: clip;\n  }\n\n  .font-serif { font-family: var(--font-serif); }\n  .font-sans { font-family: var(--font-sans); }\n\n  /* Custom Utilities */\n  .border-thin { border: 1px solid var(--color-dark); }\n  .border-thin-light { border: 1px solid var(--color-light); }\n  .border-t-thin { border-top: 1px solid var(--color-dark); }\n  .border-b-thin { border-bottom: 1px solid var(--color-dark); }\n  \n  .sharp-corner { border-radius: 0px !important; }\n\n  /* Premium Button Hover */\n  .cta-button {\n    transition: background-color 0.5s cubic-bezier(0.19, 1, 0.22, 1), color 0.5s cubic-bezier(0.19, 1, 0.22, 1);\n  }\n\n  /* Animation classes */\n  .reveal-up { opacity: 0; } /* We will use gsap.from which doesn't need this, but good for reference if we used .to */\n\n  /* Lenis CSS */\n  html.lenis {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto;\n  }\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n  .lenis.lenis-scrolling iframe {\n    pointer-events: none;\n  }\n\n  /* Nav Hover */\n  .nav-link {\n    position: relative;\n    padding-bottom: 2px;\n  }\n  .nav-link::after {\n    content: '';\n    position: absolute;\n    width: 0;\n    height: 1px;\n    bottom: 0;\n    left: 0;\n    background-color: var(--color-orange);\n    transition: width 0.3s ease;\n  }\n  .nav-link:hover::after {\n    width: 100%;\n  }\n\n  .communication-item:hover i {\n    transform: scale(1.1);\n    color: white;\n  }\n  .communication-item i {\n    transition: all 0.3s ease;\n  }\n\n  /* Sticky index circle markers */\n  .marker-dot {\n    width: 6px;\n    height: 6px;\n    background-color: var(--color-orange);\n  }\n</style>\n<div data-kid=\"1\" data-name=\"page main content container\" id=\"main-content\">\n    <!-- Slim Header -->\n    <header class=\"fixed top-0 left-0 w-full z-50 bg-white/90 backdrop-blur-sm border-b border-[var(--color-dark)]/10\" data-kid=\"1-1\" data-name=\"header navigation container\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex justify-between items-center\" data-kid=\"1-1-1\" data-name=\"navigation layout wrapper\">\n            <div class=\"flex items-center gap-12\" data-kid=\"1-1-1-1\" data-name=\"brand and link group\">\n                <a class=\"text-xl font-bold tracking-tighter uppercase font-sans\" data-kid=\"1-1-1-1-1\" data-name=\"brand name link\" href=\"/\">\n                    DS-Graphix\n                </a>\n                <nav class=\"hidden md:flex gap-10 text-[10px] uppercase tracking-[0.2em] font-bold\" data-kid=\"1-1-1-1-2\" data-name=\"main navigation menu\">\n                    <a class=\"nav-link\" data-kid=\"1-1-1-1-2-1\" data-name=\"navigation link\" href=\"#\">\n                        Work\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-1-2-2\" data-name=\"navigation link\" href=\"#\">\n                        Services\n                    </a>\n                    <a class=\"text-[var(--color-orange)]\" data-kid=\"1-1-1-1-2-3\" data-name=\"active navigation link\" href=\"#\">\n                        Process\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-1-2-4\" data-name=\"navigation link\" href=\"#\">\n                        About\n                    </a>\n                </nav>\n            </div>\n            <div class=\"flex items-center gap-8\" data-kid=\"1-1-1-2\" data-name=\"header right action group\">\n                <button class=\"text-sm opacity-50 hover:opacity-100 transition-opacity\" data-kid=\"1-1-1-2-1\" data-name=\"search button\">\n                    <i class=\"ti ti-search text-lg\" data-kid=\"1-1-1-2-1-1\" data-name=\"search icon\">\n                    </i>\n                </button>\n                <a class=\"px-6 py-2 border border-[var(--color-dark)] text-[10px] uppercase tracking-[0.2em] font-bold hover:bg-[var(--color-dark)] hover:text-white transition-all duration-300 sharp-corner\" data-kid=\"1-1-1-2-2\" data-name=\"inquiry link button\" href=\"#\">\n                    Inquiry\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- Hero Section -->\n    <section class=\"pt-64 pb-32 px-6 overflow-hidden\" data-kid=\"1-2\" data-name=\"hero section\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-2-1\" data-name=\"hero content wrapper\">\n            <div class=\"max-w-5xl\" data-kid=\"1-2-1-1\" data-name=\"hero text block\">\n                <h1 class=\"hero-text font-serif text-6xl md:text-[10rem] leading-[0.85] tracking-tight mb-20\" data-kid=\"1-2-1-1-1\" data-name=\"hero main headline\">\n                    A clear route from rough idea to\n                    <span class=\"italic text-[var(--color-orange)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"highlighted headline span\">\n                        ready-to-grow.\n                    </span>\n                </h1>\n                <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-12 mt-12\" data-kid=\"1-2-1-1-2\" data-name=\"hero bottom decorative layout\">\n                    <div class=\"w-48 h-px bg-[var(--color-dark)] hero-line\" data-kid=\"1-2-1-1-2-1\" data-name=\"hero underline element\">\n                    </div>\n                    <div class=\"flex flex-wrap gap-x-10 gap-y-6 uppercase tracking-[0.3em] text-[9px] font-black text-[var(--color-dark)]/40 hero-index\" data-kid=\"1-2-1-1-2-2\" data-name=\"hero step index list\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"step 01 marker group\">\n                            <span class=\"marker-dot\" data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"index dot marker\">\n                            </span>\n                            01 Align\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"step 02 marker group\">\n                            <span class=\"marker-dot\" data-kid=\"1-2-1-1-2-2-2-1\" data-name=\"index dot marker\">\n                            </span>\n                            02 Explore\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-2-2-3\" data-name=\"step 03 marker group\">\n                            <span class=\"marker-dot\" data-kid=\"1-2-1-1-2-2-3-1\" data-name=\"index dot marker\">\n                            </span>\n                            03 Build\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-2-2-4\" data-name=\"step 04 marker group\">\n                            <span class=\"marker-dot\" data-kid=\"1-2-1-1-2-2-4-1\" data-name=\"index dot marker\">\n                            </span>\n                            04 Launch\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Process Content: Margin-Proof Composition -->\n    <section class=\"max-w-7xl mx-auto px-6 space-y-48 pb-48\" data-kid=\"1-3\" data-name=\"process steps section\">\n        <!-- Step 01: Align -->\n        <div class=\"process-step grid grid-cols-1 lg:grid-cols-[120px_1fr_320px] gap-12 lg:gap-24 border-t border-[var(--color-dark)] pt-16\" data-kid=\"1-3-1\" data-name=\"process step 01 container\">\n            <div class=\"font-serif text-6xl text-[var(--color-orange)] step-number\" data-kid=\"1-3-1-1\" data-name=\"step number text\">\n                01\n            </div>\n            <div class=\"space-y-10\" data-kid=\"1-3-1-2\" data-name=\"step content container\">\n                <div class=\"space-y-4\" data-kid=\"1-3-1-2-1\" data-name=\"step header container\">\n                    <h2 class=\"font-serif text-5xl md:text-7xl uppercase tracking-tighter step-title\" data-kid=\"1-3-1-2-1-1\" data-name=\"step title heading\">\n                        Align\n                    </h2>\n                    <p class=\"text-xl md:text-3xl leading-snug max-w-2xl text-[var(--color-dark)]/90 font-sans tracking-tight\" data-kid=\"1-3-1-2-1-2\" data-name=\"step description text\">\n                        Strategy over decoration. We dissect your business objectives and user psychology to build a roadmap that removes guesswork from growth.\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 pt-12 border-t border-[var(--color-light)]\" data-kid=\"1-3-1-2-2\" data-name=\"step details container\">\n                    <div class=\"space-y-6\" data-kid=\"1-3-1-2-2-1\" data-name=\"step concrete output section\">\n                        <h4 class=\"uppercase tracking-[0.2em] text-xs font-bold text-[var(--color-orange)]\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"output list heading\">\n                            Concrete Outputs\n                        </h4>\n                        <ul class=\"space-y-4 font-sans text-sm\" data-kid=\"1-3-1-2-2-1-2\" data-name=\"output list\">\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-1-2-2-1-2-1\" data-name=\"list item\">\n                                <span class=\"mt-1.5 w-1 h-1 bg-[var(--color-dark)]/80 shrink-0\" data-kid=\"1-3-1-2-2-1-2-1-1\" data-name=\"list bullet point\">\n                                </span>\n                                <span data-kid=\"1-3-1-2-2-1-2-1-2\" data-name=\"list item text\">\n                                    Product Strategy & Monetization Map\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-1-2-2-1-2-2\" data-name=\"list item\">\n                                <span class=\"mt-1.5 w-1 h-1 bg-[var(--color-dark)]/80 shrink-0\" data-kid=\"1-3-1-2-2-1-2-2-1\" data-name=\"list bullet point\">\n                                </span>\n                                <span data-kid=\"1-3-1-2-2-1-2-2-2\" data-name=\"list item text\">\n                                    User Behavioral Personas\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-1-2-2-1-2-3\" data-name=\"list item\">\n                                <span class=\"mt-1.5 w-1 h-1 bg-[var(--color-dark)]/80 shrink-0\" data-kid=\"1-3-1-2-2-1-2-3-1\" data-name=\"list bullet point\">\n                                </span>\n                                <span data-kid=\"1-3-1-2-2-1-2-3-2\" data-name=\"list item text\">\n                                    Technical Architecture Audit\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"space-y-6\" data-kid=\"1-3-1-2-2-2\" data-name=\"step timeline section\">\n                        <h4 class=\"uppercase tracking-[0.2em] text-xs font-bold text-[var(--color-orange)]\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"timeline heading\">\n                            The Clock\n                        </h4>\n                        <p class=\"text-sm leading-relaxed text-[var(--color-dark)]/70\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"timeline description text\">\n                            Kickoff within\n                            <span class=\"text-[var(--color-dark)] font-bold\" data-kid=\"1-3-1-2-2-2-2-1\" data-name=\"highlighted text span\">\n                                48 hours\n                            </span>\n                            . High-level strategy documentation delivered on day 5. Weekly 30-min strategy syncs established immediately.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- Right Margin Proof -->\n            <div class=\"space-y-8 lg:mt-24\" data-kid=\"1-3-1-3\" data-name=\"step right sidebar container\">\n                <div class=\"bg-[var(--color-light)] p-10 border-l-4 border-[var(--color-orange)]\" data-kid=\"1-3-1-3-1\" data-name=\"testimonial card container\">\n                    <p class=\"font-sans text-sm italic leading-relaxed text-[var(--color-dark)]/80 mb-6\" data-kid=\"1-3-1-3-1-1\" data-name=\"testimonial quote text\">\n                        \"DS-Graphix understood our vision faster than any agency we've partnered with. The strategy was surgical, not fluff.\"\n                    </p>\n                    <div class=\"text-[9px] uppercase tracking-[0.2em] font-black opacity-60\" data-kid=\"1-3-1-3-1-2\" data-name=\"testimonial author details\">\n                        Mark T. • Elevate SaaS\n                    </div>\n                </div>\n                <img alt=\"Strategy Sessions\" class=\"w-full grayscale brightness-95\" data-kid=\"1-3-1-3-2\" data-name=\"step visual illustration\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1504198322253-cfa87a0ff25f?auto=format&w=800&q=80&fit=crop\"/>\n            </div>\n        </div>\n        <!-- Step 02: Explore -->\n        <div class=\"process-step grid grid-cols-1 lg:grid-cols-[120px_1fr_320px] gap-12 lg:gap-24 border-t border-[var(--color-dark)] pt-16\" data-kid=\"1-3-2\" data-name=\"process step 02 container\">\n            <div class=\"font-serif text-6xl text-[var(--color-orange)] step-number\" data-kid=\"1-3-2-1\" data-name=\"step number text\">\n                02\n            </div>\n            <div class=\"space-y-10\" data-kid=\"1-3-2-2\" data-name=\"step content container\">\n                <div class=\"space-y-4\" data-kid=\"1-3-2-2-1\" data-name=\"step header container\">\n                    <h2 class=\"font-serif text-5xl md:text-7xl uppercase tracking-tighter step-title\" data-kid=\"1-3-2-2-1-1\" data-name=\"step title heading\">\n                        Explore\n                    </h2>\n                    <p class=\"text-xl md:text-3xl leading-snug max-w-2xl text-[var(--color-dark)]/90 font-sans tracking-tight\" data-kid=\"1-3-2-2-1-2\" data-name=\"step description text\">\n                        Creativity meets usability. We rapid-prototype diverse visual systems and interaction patterns to find the one that resonates most with your market.\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 pt-12 border-t border-[var(--color-light)]\" data-kid=\"1-3-2-2-2\" data-name=\"step details container\">\n                    <div class=\"space-y-6\" data-kid=\"1-3-2-2-2-1\" data-name=\"step concrete output section\">\n                        <h4 class=\"uppercase tracking-[0.2em] text-xs font-bold text-[var(--color-orange)]\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"output list heading\">\n                            Concrete Outputs\n                        </h4>\n                        <ul class=\"space-y-4 font-sans text-sm\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"output list\">\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-2-2-2-1-2-1\" data-name=\"list item\">\n                                <span class=\"mt-1.5 w-1 h-1 bg-[var(--color-dark)]/80 shrink-0\" data-kid=\"1-3-2-2-2-1-2-1-1\" data-name=\"list bullet point\">\n                                </span>\n                                <span data-kid=\"1-3-2-2-2-1-2-1-2\" data-name=\"list item text\">\n                                    3 Distinct Visual Direction Boards\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-2-2-2-1-2-2\" data-name=\"list item\">\n                                <span class=\"mt-1.5 w-1 h-1 bg-[var(--color-dark)]/80 shrink-0\" data-kid=\"1-3-2-2-2-1-2-2-1\" data-name=\"list bullet point\">\n                                </span>\n                                <span data-kid=\"1-3-2-2-2-1-2-2-2\" data-name=\"list item text\">\n                                    Clickable Lo-Fi Wireframes\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-2-2-2-1-2-3\" data-name=\"list item\">\n                                <span class=\"mt-1.5 w-1 h-1 bg-[var(--color-dark)]/80 shrink-0\" data-kid=\"1-3-2-2-2-1-2-3-1\" data-name=\"list bullet point\">\n                                </span>\n                                <span data-kid=\"1-3-2-2-2-1-2-3-2\" data-name=\"list item text\">\n                                    Core UX Flow Documentation\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"space-y-6\" data-kid=\"1-3-2-2-2-2\" data-name=\"step timeline section\">\n                        <h4 class=\"uppercase tracking-[0.2em] text-xs font-bold text-[var(--color-orange)]\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"timeline heading\">\n                            The Clock\n                        </h4>\n                        <p class=\"text-sm leading-relaxed text-[var(--color-dark)]/70\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"timeline description text\">\n                            Visual concepts delivered within\n                            <span class=\"text-[var(--color-dark)] font-bold\" data-kid=\"1-3-2-2-2-2-2-1\" data-name=\"highlighted text span\">\n                                7 days\n                            </span>\n                            . Two rounds of feedback per core flow. Zero \"standard\" templates used.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- Right Margin Proof -->\n            <div class=\"space-y-8 lg:mt-24\" data-kid=\"1-3-2-3\" data-name=\"step right sidebar container\">\n                <div class=\"border border-[var(--color-light)] p-10 flex flex-col items-center text-center\" data-kid=\"1-3-2-3-1\" data-name=\"metric card container\">\n                    <div class=\"text-6xl font-serif text-[var(--color-orange)] mb-2\" data-kid=\"1-3-2-3-1-1\" data-name=\"metric value text\">\n                        98%\n                    </div>\n                    <p class=\"text-[9px] uppercase tracking-[0.2em] font-black opacity-50\" data-kid=\"1-3-2-3-1-2\" data-name=\"metric caption text\">\n                        First-pass Approval Rate on UX Concepts\n                    </p>\n                </div>\n                <img alt=\"Design Exploration\" class=\"w-full grayscale brightness-90\" data-kid=\"1-3-2-3-2\" data-name=\"step visual illustration\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1531591022136-eb8b0da1e6d0?auto=format&w=800&q=80&fit=crop\"/>\n            </div>\n        </div>\n        <!-- Step 03: Build -->\n        <div class=\"process-step grid grid-cols-1 lg:grid-cols-[120px_1fr_320px] gap-12 lg:gap-24 border-t border-[var(--color-dark)] pt-16\" data-kid=\"1-3-3\" data-name=\"process step 03 container\">\n            <div class=\"font-serif text-6xl text-[var(--color-orange)] step-number\" data-kid=\"1-3-3-1\" data-name=\"step number text\">\n                03\n            </div>\n            <div class=\"space-y-10\" data-kid=\"1-3-3-2\" data-name=\"step content container\">\n                <div class=\"space-y-4\" data-kid=\"1-3-3-2-1\" data-name=\"step header container\">\n                    <h2 class=\"font-serif text-5xl md:text-7xl uppercase tracking-tighter step-title\" data-kid=\"1-3-3-2-1-1\" data-name=\"step title heading\">\n                        Build\n                    </h2>\n                    <p class=\"text-xl md:text-3xl leading-snug max-w-2xl text-[var(--color-dark)]/90 font-sans tracking-tight\" data-kid=\"1-3-3-2-1-2\" data-name=\"step description text\">\n                        High-fidelity execution. We craft pixel-perfect interfaces, dynamic motion systems, and scalable components designed for the long haul.\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 pt-12 border-t border-[var(--color-light)]\" data-kid=\"1-3-3-2-2\" data-name=\"step details container\">\n                    <div class=\"space-y-6\" data-kid=\"1-3-3-2-2-1\" data-name=\"step concrete output section\">\n                        <h4 class=\"uppercase tracking-[0.2em] text-xs font-bold text-[var(--color-orange)]\" data-kid=\"1-3-3-2-2-1-1\" data-name=\"output list heading\">\n                            Concrete Outputs\n                        </h4>\n                        <ul class=\"space-y-4 font-sans text-sm\" data-kid=\"1-3-3-2-2-1-2\" data-name=\"output list\">\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-3-2-2-1-2-1\" data-name=\"list item\">\n                                <span class=\"mt-1.5 w-1 h-1 bg-[var(--color-dark)]/80 shrink-0\" data-kid=\"1-3-3-2-2-1-2-1-1\" data-name=\"list bullet point\">\n                                </span>\n                                <span data-kid=\"1-3-3-2-2-1-2-1-2\" data-name=\"list item text\">\n                                    Production-Ready Figma Design System\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-3-2-2-1-2-2\" data-name=\"list item\">\n                                <span class=\"mt-1.5 w-1 h-1 bg-[var(--color-dark)]/80 shrink-0\" data-kid=\"1-3-3-2-2-1-2-2-1\" data-name=\"list bullet point\">\n                                </span>\n                                <span data-kid=\"1-3-3-2-2-1-2-2-2\" data-name=\"list item text\">\n                                    Animated Interaction Library\n                                </span>\n                            </li>\n                            <li class=\"flex items-start gap-3\" data-kid=\"1-3-3-2-2-1-2-3\" data-name=\"list item\">\n                                <span class=\"mt-1.5 w-1 h-1 bg-[var(--color-dark)]/80 shrink-0\" data-kid=\"1-3-3-2-2-1-2-3-1\" data-name=\"list bullet point\">\n                                </span>\n                                <span data-kid=\"1-3-3-2-2-1-2-3-2\" data-name=\"list item text\">\n                                    Full-Spectrum Responsive UI Kit\n                                </span>\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"space-y-6\" data-kid=\"1-3-3-2-2-2\" data-name=\"step timeline section\">\n                        <h4 class=\"uppercase tracking-[0.2em] text-xs font-bold text-[var(--color-orange)]\" data-kid=\"1-3-3-2-2-2-1\" data-name=\"timeline heading\">\n                            The Clock\n                        </h4>\n                        <p class=\"text-sm leading-relaxed text-[var(--color-dark)]/70\" data-kid=\"1-3-3-2-2-2-2\" data-name=\"timeline description text\">\n                            Full UI completion in\n                            <span class=\"text-[var(--color-dark)] font-bold\" data-kid=\"1-3-3-2-2-2-2-1\" data-name=\"highlighted text span\">\n                                14-21 days\n                            </span>\n             