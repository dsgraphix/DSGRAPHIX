" data-kid=\"2-4-2\" data-name=\"services content column\">\n            <article class=\"grid md:grid-cols-2 gap-20 items-center animate-reveal\" data-kid=\"2-4-2-1\" data-name=\"human-centric service article\">\n                <div data-kid=\"2-4-2-1-1\" data-name=\"service description text block\">\n                    <h3 class=\"text-5xl font-black mb-8 leading-tight font-serif\" data-kid=\"2-4-2-1-1-1\" data-name=\"service title\">\n                        Human-centric products for high-stakes digital environments.\n                    </h3>\n                    <p class=\"text-lg opacity-70 leading-relaxed mb-10\" data-kid=\"2-4-2-1-1-2\" data-name=\"service description\">\n                        We solve beyond the interface. We design workflows, decision layers, and product logic that scale with your business goals.\n                    </p>\n                    <div class=\"flex flex-wrap gap-3\" data-kid=\"2-4-2-1-1-3\" data-name=\"service tags container\">\n                        <span class=\"px-4 py-2 border border-dark/10 text-[10px] uppercase font-bold tracking-widest\" data-kid=\"2-4-2-1-1-3-1\" data-name=\"service tag audit\">\n                            Audit\n                        </span>\n                        <span class=\"px-4 py-2 border border-dark/10 text-[10px] uppercase font-bold tracking-widest\" data-kid=\"2-4-2-1-1-3-2\" data-name=\"service tag strategy\">\n                            Strategy\n                        </span>\n                        <span class=\"px-4 py-2 border border-dark/10 text-[10px] uppercase font-bold tracking-widest\" data-kid=\"2-4-2-1-1-3-3\" data-name=\"service tag prototype\">\n                            Prototype\n                        </span>\n                    </div>\n                </div>\n                <div class=\"bg-light-gray p-12 lg:p-20 group overflow-hidden relative\" data-kid=\"2-4-2-1-2\" data-name=\"service imagery container\">\n                    <img alt=\"Digital creative mockup by Nick Adams\" class=\"w-full grayscale shadow-[30px_30px_0px_rgba(42,42,41,0.05)] group-hover:grayscale-0\" data-kid=\"2-4-2-1-2-1\" data-name=\"service feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1516131206008-dd041a9764fd?auto=format&w=800&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 border border-dark/5 pointer-events-none\" data-kid=\"2-4-2-1-2-2\" data-name=\"service image border overlay\">\n                    </div>\n                </div>\n            </article>\n            <article class=\"grid md:grid-cols-2 gap-16 items-center animate-reveal\" data-kid=\"2-4-2-2\" data-name=\"visual authority service article\">\n                <div class=\"md:order-2\" data-kid=\"2-4-2-2-1\" data-name=\"service description text block\">\n                    <h3 class=\"text-5xl font-black mb-8 leading-tight font-serif\" data-kid=\"2-4-2-2-1-1\" data-name=\"service title\">\n                        Visual languages that command authority and trust.\n                    </h3>\n                    <p class=\"text-lg opacity-70 leading-relaxed mb-10\" data-kid=\"2-4-2-2-1-2\" data-name=\"service description\">\n                        Identity isn't just a logo. It's an entire ecosystem of visual signals that position your brand as the obvious choice in a crowded market.\n                    </p>\n                    <div class=\"flex flex-wrap gap-3\" data-kid=\"2-4-2-2-1-3\" data-name=\"service tags container\">\n                        <span class=\"px-4 py-2 border border-dark/10 text-[10px] uppercase font-bold tracking-widest\" data-kid=\"2-4-2-2-1-3-1\" data-name=\"service tag naming\">\n                            Naming\n                        </span>\n                        <span class=\"px-4 py-2 border border-dark/10 text-[10px] uppercase font-bold tracking-widest\" data-kid=\"2-4-2-2-1-3-2\" data-name=\"service tag visual dna\">\n                            Visual DNA\n                        </span>\n                        <span class=\"px-4 py-2 border border-dark/10 text-[10px] uppercase font-bold tracking-widest\" data-kid=\"2-4-2-2-1-3-3\" data-name=\"service tag systems\">\n                            Systems\n                        </span>\n                    </div>\n                </div>\n                <div class=\"md:order-1 bg-light-gray p-12 lg:p-20 group overflow-hidden relative\" data-kid=\"2-4-2-2-2\" data-name=\"service imagery container\">\n                    <img alt=\"Magazine mockup by Content Pixie\" class=\"w-full grayscale shadow-[30px_30px_0px_rgba(42,42,41,0.05)] group-hover:grayscale-0\" data-kid=\"2-4-2-2-2-1\" data-name=\"service feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1592966719124-2ca2978ba325?auto=format&w=800&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 border border-dark/5 pointer-events-none\" data-kid=\"2-4-2-2-2-2\" data-name=\"service image border overlay\">\n                    </div>\n                </div>\n            </article>\n        </div>\n    </section>\n    <!-- Photo Wall / Masonry Portfolio -->\n    <section class=\"py-40 px-6 max-w-[1440px] mx-auto border-t border-dark\" data-kid=\"2-5\" data-name=\"portfolio section\" id=\"work\">\n        <div class=\"flex flex-col md:flex-row justify-between items-end mb-24 gap-8 pt-12\" data-kid=\"2-5-1\" data-name=\"portfolio header row\">\n            <h2 class=\"text-7xl md:text-[10rem] font-black italic tracking-tighter font-serif leading-[0.8] mb-6\" data-kid=\"2-5-1-1\" data-name=\"portfolio section headline\">\n                Selected\n                <br data-kid=\"2-5-1-1-1\" data-name=\"headline line break\"/>\n                Archives.\n            </h2>\n            <a class=\"text-xs uppercase tracking-[0.5em] font-black border-b-2 border-orange pb-3 hover:text-orange transition-all\" data-kid=\"2-5-1-2\" data-name=\"view all projects link\" href=\"#\">\n  