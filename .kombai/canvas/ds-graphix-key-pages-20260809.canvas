       <br data-kid=\"1-1-6-1-1-1-1-1\" data-name=\"line break\"/>\n                            <span class=\"italic opacity-80\" data-kid=\"1-1-6-1-1-1-1-2\" data-name=\"cta italic text\">\n                                Let’s shape it.\n                            </span>\n                        </h2>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row gap-4 w-full md:w-auto\" data-kid=\"1-1-6-1-1-2\" data-name=\"cta actions container\">\n                        <a class=\"bg-[#2A2A29] text-white px-12 py-6 text-[10px] font-bold uppercase tracking-widest text-center hover:bg-white hover:text-[#2A2A29] transition-all duration-300\" data-kid=\"1-1-6-1-1-2-1\" data-name=\"book discovery call button\" href=\"#\">\n                            Book discovery call\n                        </a>\n                        <a class=\"border border-white/40 text-white px-12 py-6 text-[10px] font-bold uppercase tracking-widest text-center hover:bg-white hover:text-[#FF6636] transition-all duration-300\" data-kid=\"1-1-6-1-1-2-2\" data-name=\"drop an email button\" href=\"mailto:hello@ds-graphix.com\">\n                            Drop an email\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <!-- Editorial background shape -->\n            <div class=\"absolute right-0 top-0 h-full w-1/3 bg-white/5 skew-x-[-15deg] transform translate-x-20\" data-kid=\"1-1-6-2\" data-name=\"background decorative shape\">\n            </div>\n        </section>\n        <!-- Footer -->\n        <footer class=\"bg-white pt-32 pb-12 px-6\" data-kid=\"1-1-7\" data-name=\"site footer\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"1-1-7-1\" data-name=\"footer content wrapper\">\n                <div class=\"grid grid-cols-2 md:grid-cols-4 gap-12 mb-32\" data-kid=\"1-1-7-1-1\" data-name=\"footer navigation grid\">\n                    <div class=\"col-span-2\" data-kid=\"1-1-7-1-1-1\" data-name=\"footer brand column\">\n                        <div class=\"text-2xl font-black tracking-tighter uppercase mb-8\" data-kid=\"1-1-7-1-1-1-1\" data-name=\"footer brand name\">\n                            DS-Graphix\n                        </div>\n                        <p class=\"text-sm opacity-50 max-w-xs leading-relaxed\" data-kid=\"1-1-7-1-1-1-2\" data-name=\"footer brand description\">\n                            Premium digital partner for high-growth enterprises seeking editorial creative excellence.\n                        </p>\n                        <div class=\"mt-10 flex gap-6 text-lg opacity-40\" data-kid=\"1-1-7-1-1-1-3\" data-name=\"social media links group\">\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-1-3-1\" data-name=\"linkedin link\" href=\"#\">\n                                <i class=\"ti ti-brand-linkedin\" data-kid=\"1-1-7-1-1-1-3-1-1\" data-name=\"linkedin icon\">\n                                </i>\n                            </a>\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-1-3-2\" data-name=\"twitter link\" href=\"#\">\n                                <i class=\"ti ti-brand-twitter\" data-kid=\"1-1-7-1-1-1-3-2-1\" data-name=\"twitter icon\">\n                                </i>\n                            </a>\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-1-3-3\" data-name=\"instagram link\" href=\"#\">\n                                <i class=\"ti ti-brand-instagram\" data-kid=\"1-1-7-1-1-1-3-3-1\" data-name=\"instagram icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-1-7-1-1-2\" data-name=\"footer capabilities column\">\n                        <h5 class=\"text-[10px] font-bold uppercase tracking-widest mb-8 opacity-40\" data-kid=\"1-1-7-1-1-2-1\" data-name=\"footer capabilities header\">\n                            Capabilities\n                        </h5>\n                        <ul class=\"space-y-4 text-xs font-bold uppercase tracking-widest opacity-60\" data-kid=\"1-1-7-1-1-2-2\" data-name=\"footer capabilities list\">\n                            <li data-kid=\"1-1-7-1-1-2-2-1\" data-name=\"UI/UX design footer link\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-2-2-1-1\" data-name=\"UI/UX design link text\" href=\"#\">\n                                    UI/UX Design\n                                </a>\n                            </li>\n                            <li data-kid=\"1-1-7-1-1-2-2-2\" data-name=\"branding footer link\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-2-2-2-1\" data-name=\"branding link text\" href=\"#\">\n                                    Branding\n                                </a>\n                            </li>\n                            <li data-kid=\"1-1-7-1-1-2-2-3\" data-name=\"graphic design footer link\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-2-2-3-1\" data-name=\"graphic design link text\" href=\"#\">\n                                    Graphic Design\n                                </a>\n                            </li>\n                            <li data-kid=\"1-1-7-1-1-2-2-4\" data-name=\"video production footer link\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-2-2-4-1\" data-name=\"video production link text\" href=\"#\">\n                                    Video Production\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-1-7-1-1-3\" data-name=\"footer quick links column\">\n                        <h5 class=\"text-[10px] font-bold uppercase tracking-widest mb-8 opacity-40\" data-kid=\"1-1-7-1-1-3-1\" data-name=\"footer quick links header\">\n                            Quick Links\n                        </h5>\n                        <ul class=\"space-y-4 text-xs font-bold uppercase tracking-widest opacity-60\" data-kid=\"1-1-7-1-1-3-2\" data-name=\"footer quick links list\">\n                            <li data-kid=\"1-1-7-1-1-3-2-1\" data-name=\"case studies link\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-3-2-1-1\" data-name=\"case studies link text\" href=\"#\">\n                                    Case Studies\n                                </a>\n                            </li>\n                            <li data-kid=\"1-1-7-1-1-3-2-2\" data-name=\"our process link\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-3-2-2-1\" data-name=\"our process link text\" href=\"#\">\n                                    Our Process\n                                </a>\n                            </li>\n                            <li data-kid=\"1-1-7-1-1-3-2-3\" data-name=\"client list link\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-3-2-3-1\" data-name=\"client list link text\" href=\"#\">\n                                    Client List\n                                </a>\n                            </li>\n                            <li data-kid=\"1-1-7-1-1-3-2-4\" data-name=\"careers link\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-1-7-1-1-3-2-4-1\" data-name=\"careers link text\" href=\"#\">\n                                    Careers\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n                <div class=\"pt-12 border-t border-[#2A2A29]/10 flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"1-1-7-1-2\" data-name=\"footer bottom row\">\n                    <p class=\"text-[8px] font-bold uppercase tracking-[0.3em] opacity-30\" data-kid=\"1-1-7-1-2-1\" data-name=\"copyright notice text\">\n                        © 2026 DS-Graphix Creative Agency. All Rights Reserved.\n                    </p>\n                    <div class=\"flex gap-10 text-[8px] font-bold uppercase tracking-[0.3em] opacity-30\" data-kid=\"1-1-7-1-2-2\" data-name=\"footer legal links group\">\n                        <a class=\"hover:text-[#2A2A29]\" data-kid=\"1-1-7-1-2-2-1\" data-name=\"privacy policy link\" href=\"#\">\n                            Privacy Policy\n                        </a>\n                        <a class=\"hover:text-[#2A2A29]\" data-kid=\"1-1-7-1-2-2-2\" data-name=\"terms of service link\" href=\"#\">\n                            Terms of Service\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Initialize Lenis\n    const lenis = new Lenis({\n        duration: 1.2,\n        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n        smoothWheel: true,\n    })\n\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n\n    // GSAP ScrollTrigger Integration\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Text Reveal\n    gsap.from(\".hero-reveal\", {\n        y: 60,\n        opacity: 0,\n        duration: 1.2,\n        stagger: 0.2,\n        ease: \"power4.out\",\n        delay: 0.5\n    });\n\n    gsap.from(\".hero-image-wrap\", {\n        scale: 1.1,\n        opacity: 0,\n        duration: 1.5,\n        ease: \"power2.out\",\n        delay: 0.8\n    });\n\n    // Service Blocks Entrance\n    const serviceBlocks = gsap.utils.toArray('.service-block');\n    serviceBlocks.forEach((block) => {\n        const text = block.querySelector('.service-text');\n        const img = block.querySelector('.service-image');\n        \n        gsap.from(text, {\n            scrollTrigger: {\n                trigger: block,\n                start: \"top 80%\",\n            },\n            y: 50,\n            opacity: 0,\n            duration: 0.8,\n            ease: \"power3.out\"\n        });\n\n        gsap.from(img, {\n            scrollTrigger: {\n                trigger: block,\n                start: \"top 80%\",\n            },\n            y: 100,\n            opacity: 0,\n            duration: 1,\n            ease: \"power2.out\"\n        });\n    });\n\n    // Active Index Highlighting\n    const sections = gsap.utils.toArray('.service-block');\n    const navItems = gsap.utils.toArray('.service-nav-item');\n\n    sections.forEach((section, i) => {\n        ScrollTrigger.create({\n            trigger: section,\n            start: \"top center\",\n            end: \"bottom center\",\n            onToggle: self => {\n                if (self.isActive) {\n                    navItems.forEach(item => item.classList.remove('active'));\n                    navItems[i].classList.add('active');\n                }\n            }\n        });\n    });\n\n    // Parallax Metric\n    gsap.to(\".metric-value\", {\n        scrollTrigger: {\n            trigger: \"#proof-strip\",\n            start: \"top bottom\",\n            scrub: true\n        },\n        y: -50\n    });\n</script>\n",
      "comments": [],
      "created": "2026-08-09T11:39:40.080493+00:00",
      "modified": "2026-08-09T11:39:40.080493+00:00",
