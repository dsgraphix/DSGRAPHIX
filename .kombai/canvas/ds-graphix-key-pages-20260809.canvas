      "html": "<div class=\"bg-[#FFFFFF] text-[#2A2A29] font-['DM_Sans'] antialiased selection:bg-[#FF6636] selection:text-white\" data-kid=\"1\" data-name=\"page layout container\" id=\"smooth-wrapper\">\n    <link data-kid=\"1-1\" data-name=\"smooth scroll stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n    <link data-kid=\"1-2\" data-name=\"tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;1,9..144,400&family=DM+Sans:wght@400;500;700&display=swap');\n\n    :root {\n      --color-primary: #FF6636;\n      --color-dark: #2A2A29;\n      --color-bg: #FFFFFF;\n      --color-contrast: #F2F4F8;\n      --color-muted: #A1A1A1;\n    }\n\n    .font-fraunces { font-family: 'Fraunces', serif; }\n    \n    .no-scrollbar::-webkit-scrollbar { display: none; }\n    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n    /* Masonry Styling */\n    .masonry-container {\n      column-count: 1;\n      column-gap: 3rem;\n    }\n    @media (min-width: 768px) {\n      .masonry-container { column-count: 2; }\n    }\n    @media (min-width: 1280px) {\n      .masonry-container { column-count: 3; }\n    }\n    .masonry-item {\n      break-inside: avoid;\n      margin-bottom: 3rem;\n    }\n\n    /* Marquee Styling */\n    .marquee-container {\n      display: flex;\n      overflow: hidden;\n      user-select: none;\n      gap: 3rem;\n    }\n    .marquee-content {\n      flex-shrink: 0;\n      display: flex;\n      justify-content: space-around;\n      min-width: 100%;\n      gap: 3rem;\n      animation: scroll 30s linear infinite;\n    }\n    @keyframes scroll {\n      from { transform: translateX(0); }\n      to { transform: translateX(-100%); }\n    }\n\n    /* Custom Image Effects */\n    .image-reveal {\n      clip-path: inset(0 100% 0 0);\n      transition: clip-path 1.2s cubic-bezier(0.77, 0, 0.175, 1);\n    }\n    .image-reveal.active {\n      clip-path: inset(0 0 0 0);\n    }\n    </style>\n    <!-- Navigation -->\n    <header class=\"fixed top-0 left-0 w-full z-50 bg-white/95 backdrop-blur-md border-b border-[#2A2A29]/5\" data-kid=\"1-3\" data-name=\"navigation header\">\n        <div class=\"max-w-[1440px] mx-auto px-6 md:px-12 h-20 flex justify-between items-center\" data-kid=\"1-3-1\" data-name=\"header content wrapper\">\n            <div class=\"text-xl font-bold tracking-tighter uppercase font-fraunces\" data-kid=\"1-3-1-1\" data-name=\"brand logo text\">\n                DS-Graphix\n            </div>\n            <nav class=\"hidden lg:flex items-center gap-10 text-xs font-bold uppercase tracking-[0.2em]\" data-kid=\"1-3-1-2\" data-name=\"main navigation links\">\n                <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-3-1-2-1\" data-name=\"work navigation link\" href=\"#\">\n                    Work\n                </a>\n                <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-3-1-2-2\" data-name=\"services navigation link\" href=\"#\">\n                    Services\n                </a>\n                <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-3-1-2-3\" data-name=\"process navigation link\" href=\"#\">\n                    Process\n                </a>\n                <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-3-1-2-4\" data-name=\"insights navigation link\" href=\"#\">\n                    Insights\n                </a>\n                <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-3-1-2-5\" data-name=\"contact navigation link\" href=\"#\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-3-1-3\" data-name=\"header actions wrapper\">\n                <button class=\"bg-[#FF6636] text-white px-8 py-3 text-xs font-bold uppercase tracking-[0.2em] transition-all hover:bg-black hover:-translate-y-0.5 active:translate-y-0 cursor-pointer\" data-kid=\"1-3-1-3-1\" data-name=\"discovery call button\">\n                    Book a Discovery Call\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"pt-20\" data-kid=\"1-4\" data-name=\"main content area\" id=\"smooth-content\">\n        <!-- Hero Section -->\n        <section class=\"px-6 md:px-12 pt-28 pb-20 md:pt-48 md:pb-32 max-w-[1440px] mx-auto\" data-kid=\"1-4-1\" data-name=\"hero section\">\n            <div class=\"max-w-5xl gsap-reveal-hero\" data-kid=\"1-4-1-1\" data-name=\"hero content wrapper\">\n                <span class=\"text-xs font-bold uppercase tracking-[0.3em] text-[#FF6636] mb-8 block\" data-kid=\"1-4-1-1-1\" data-name=\"hero subheadline tag\">\n                    Showcase 2024\n                </span>\n                <h1 class=\"font-fraunces text-6xl md:text-[10rem] leading-[0.8] tracking-tighter mb-12\" data-kid=\"1-4-1-1-2\" data-name=\"hero main headline\">\n                    Work with a\n                    <br data-kid=\"1-4-1-1-2-1\" data-name=\"hero headline line break\"/>\n                    point of view.\n                </h1>\n                <div class=\"flex flex-col md:flex-row gap-12 items-start mt-16\" data-kid=\"1-4-1-1-3\" data-name=\"hero introduction wrapper\">\n                    <div class=\"w-1 h-24 bg-[#FF6636] hidden md:block\" data-kid=\"1-4-1-1-3-1\" data-name=\"hero decorative accent bar\">\n                    </div>\n                    <p class=\"text-xl md:text-3xl leading-snug max-w-3xl text-[#2A2A29]/90 font-fraunces italic\" data-kid=\"1-4-1-1-3-2\" data-name=\"hero descriptive text\">\n                        Visual excellence is baseline. Strategic differentiation is the finish line. We build design systems that move metrics and command attention.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <!-- Filter Rail -->\n        <section class=\"sticky top-20 z-40 bg-white border-b border-[#2A2A29]/10\" data-kid=\"1-4-2\" data-name=\"sticky filter rail\">\n            <div class=\"max-w-[1440px] mx-auto px-6 md:px-12 flex flex-col md:flex-row justify-between items-center py-6 gap-6\" data-kid=\"1-4-2-1\" data-name=\"filter rail content wrapper\">\n                <div class=\"flex gap-8 overflow-x-auto no-scrollbar w-full md:w-auto\" data-kid=\"1-4-2-1-1\" data-name=\"filter buttons list\">\n                    <button class=\"text-xs font-bold uppercase tracking-[0.2em] text-[#FF6636] whitespace-nowrap\" data-kid=\"1-4-2-1-1-1\" data-name=\"all work filter button\">\n                        All Work\n                    </button>\n                    <button class=\"text-xs font-bold uppercase tracking-[0.2em] text-[#A1A1A1] hover:text-[#2A2A29] whitespace-nowrap transition-colors\" data-kid=\"1-4-2-1-1-2\" data-name=\"ui ux filter button\">\n                        UI/UX Design\n                    </button>\n                    <button class=\"text-xs font-bold uppercase tracking-[0.2em] text-[#A1A1A1] hover:text-[#2A2A29] whitespace-nowrap transition-colors\" data-kid=\"1-4-2-1-1-3\" data-name=\"brand identity filter button\">\n                        Brand Identity\n                    </button>\n                    <button class=\"text-xs font-bold uppercase tracking-[0.2em] text-[#A1A1A1] hover:text-[#2A2A29] whitespace-nowrap transition-colors\" data-kid=\"1-4-2-1-1-4\" data-name=\"graphic design filter button\">\n                        Graphic Design\n                    </button>\n                    <button class=\"text-xs font-bold uppercase tracking-[0.2em] text-[#A1A1A1] hover:text-[#2A2A29] whitespace-nowrap transition-colors\" data-kid=\"1-4-2-1-1-5\" data-name=\"social ads filter button\">\n                        Social & Ads\n                    </button>\n                </div>\n                <div class=\"flex items-center gap-4 border-l border-[#2A2A29]/10 pl-8 hidden md:flex\" data-kid=\"1-4-2-1-2\" data-name=\"search projects trigger\">\n                    <i class=\"ti ti-search text-lg opacity-40\" data-kid=\"1-4-2-1-2-1\" data-name=\"search icon\">\n                    </i>\n                    <span class=\"text-xs font-bold uppercase tracking-[0.2em] opacity-40\" data-kid=\"1-4-2-1-2-2\" data-name=\"search text label\">\n                        Search Projects\n                    </span>\n                </div>\n            </div>\n        </section>\n        <!-- Masonry Gallery -->\n        <section class=\"px-6 md:px-12 py-16 max-w-[1440px] mx-auto\" data-kid=\"1-4-3\" data-name=\"masonry gallery section\">\n            <div class=\"masonry-container\" data-kid=\"1-4-3-1\" data-name=\"masonry grid container\">\n                <!-- Case 1: Large UI/UX -->\n                <div class=\"masonry-item group gsap-reveal-item lg:col-span-2\" data-kid=\"1-4-3-1-1\" data-name=\"case study item 1\">\n                    <div class=\"relative overflow-hidden bg-[#F2F4F8] aspect-[16/10]\" data-kid=\"1-4-3-1-1-1\" data-name=\"case 1 image wrapper\">\n                        <img alt=\"UI/UX Dashboard\" class=\"w-full h-full object-cover transition-all duration-700 group-hover:scale-105\" data-kid=\"1-4-3-1-1-1-1\" data-name=\"case 1 image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1516131206008-dd041a9764fd?auto=format&w=1200&q=80&fit=crop\"/>\n                        <div class=\"absolute top-6 left-6 bg-[#FF6636] text-white px-4 py-2 text-[10px] font-bold uppercase tracking-widest\" data-kid=\"1-4-3-1-1-1-2\" data-name=\"case 1 category badge\">\n                            Case 01\n                        </div>\n                    </div>\n                    <div class=\"mt-6 border-b border-[#2A2A29]/10 pb-6\" data-kid=\"1-4-3-1-1-2\" data-name=\"case 1 details wrapper\">\n                        <div class=\"flex justify-between items-baseline mb-3\" data-kid=\"1-4-3-1-1-2-1\" data-name=\"case 1 headline wrapper\">\n                            <h3 class=\"font-fraunces text-3xl group-hover:text-[#FF6636] transition-colors\" data-kid=\"1-4-3-1-1-2-1-1\" data-name=\"case 1 title\">\n                                Lumina Dashboard\n                            </h3>\n                            <span class=\"text-2xl font-fraunces text-[#FF6636]\" data-kid=\"1-4-3-1-1-2-1-2\" data-name=\"case 1 performance metric\">\n                                +42%\n                            </span>\n                        </div>\n                        <p class=\"text-sm opacity-60 leading-relaxed mb-4\" data-kid=\"1-4-3-1-1-2-2\" data-name=\"case 1 description text\">\n                            Complete digital transformation for an AI-led wealth ecosystem.\n                        </p>\n                        <a class=\"text-xs font-bold uppercase tracking-widest inline-flex items-center gap-2 group-hover:gap-4 transition-all\" data-kid=\"1-4-3-1-1-2-3\" data-name=\"case 1 view link\" href=\"#\">\n                            View Case\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-4-3-1-1-2-3-1\" data-name=\"case 1 arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <!-- Case 2: Narrow Brand -->\n                <div class=\"masonry-item group gsap-reveal-item\" data-kid=\"1-4-3-1-2\" data-name=\"case study item 2\">\n                    <div class=\"relative overflow-hidden bg-[#F2F4F8] aspect-[3/4]\" data-kid=\"1-4-3-1-2-1\" data-name=\"case 2 image wrapper\">\n                        <img alt=\"Brand identity\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000\" data-kid=\"1-4-3-1-2-1-1\" data-name=\"case 2 image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1504198322253-cfa87a0ff25f?auto=format&w=800&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"mt-6 border-b border-[#2A2A29]/10 pb-6\" data-kid=\"1-4-3-1-2-2\" data-name=\"case 2 details wrapper\">\n                        <h3 class=\"font-fraunces text-2xl mb-3 group-hover:text-[#FF6636] transition-colors\" data-kid=\"1-4-3-1-2-2-1\" data-name=\"case 2 title\">\n                            Aura Skincare\n                        </h3>\n                        <p class=\"text-sm opacity-60 leading-relaxed mb-4\" data-kid=\"1-4-3-1-2-2-2\" data-name=\"case 2 description text\">\n                            Minimalist branding bridging luxury and sustainability.\n                        </p>\n                        <a class=\"text-xs font-bold uppercase tracking-widest\" data-kid=\"1-4-3-1-2-2-3\" data-name=\"case 2 view link\" href=\"#\">\n                            Case Study\n                        </a>\n                    </div>\n                </div>\n                <!-- Case 3: Video Tile -->\n                <div class=\"masonry-item group gsap-reveal-item\" data-kid=\"1-4-3-1-3\" data-name=\"case study item 3\">\n                    <div class=\"relative overflow-hidden bg-[#2A2A29] aspect-square\" data-kid=\"1-4-3-1-3-1\" data-name=\"case 3 media wrapper\">\n                        <video autoplay=\"\" class=\"w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-700\" data-kid=\"1-4-3-1-3-1-1\" data-name=\"case 3 video\" loop=\"\" muted=\"\" playsinline=\"\" preload=\"metadata\" src=\"https://images.pexels.com/videos/3141208/free-video-3141208.mp4\">\n                        </video>\n                        <div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"1-4-3-1-3-1-2\" data-name=\"case 3 play icon container\">\n                            <div class=\"w-16 h-16 rounded-full border border-white/30 flex items-center justify-center backdrop-blur-sm group-hover:scale-110 transition-transform\" data-kid=\"1-4-3-1-3-1-2-1\" data-name=\"case 3 play icon wrapper\">\n                                <i class=\"ti ti-player-play text-white text-2xl\" data-kid=\"1-4-3-1-3-1-2-1-1\" data-name=\"case 3 play icon\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-6 border-b border-[#2A2A29]/10 pb-6\" data-kid=\"1-4-3-1-3-2\" data-name=\"case 3 details wrapper\">\n                        <h3 class=\"font-fraunces text-2xl mb-3\" data-kid=\"1-4-3-1-3-2-1\" data-name=\"case 3 title\">\n                            Velocity Reels\n                        </h3>\n                        <p class=\"text-sm opacity-60 leading-relaxed mb-4\" data-kid=\"1-4-3-1-3-2-2\" data-name=\"case 3 description text\">\n                            High-impact motion graphics for social-first brands.\n                        </p>\n                        <a class=\"text-xs font-bold uppercase tracking-widest\" data-kid=\"1-4-3-1-3-2-3\" data-name=\"case 3 view link\" href=\"#\">\n                            Watch Showreel\n                        </a>\n                    </div>\n                </div>\n                <!-- Case 4: Tall Graphic -->\n                <div class=\"masonry-item group gsap-reveal-item\" data-kid=\"1-4-3-1-4\" data-name=\"case study item 4\">\n                    <div class=\"relative overflow-hidden bg-[#F2F4F8] aspect-[4/6]\" data-kid=\"1-4-3-1-4-1\" data-name=\"case 4 image wrapper\">\n                        <img alt=\"Signage Design\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000\" data-kid=\"1-4-3-1-4-1-1\" data-name=\"case 4 image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1632667680404-572c57873c21?auto=format&w=800&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"mt-6 border-b border-[#2A2A29]/10 pb-6\" data-kid=\"1-4-3-1-4-2\" data-name=\"case 4 details wrapper\">\n                        <h3 class=\"font-fraunces text-2xl mb-3\" data-kid=\"1-4-3-1-4-2-1\" data-name=\"case 4 title\">\n                            Vorm Foundation\n                        </h3>\n                        <p class=\"text-sm opacity-60 leading-relaxed mb-4\" data-kid=\"1-4-3-1-4-2-2\" data-name=\"case 4 description text\">\n                            Spatial signage and wayfinding for cultural institutions.\n                        </p>\n                        <a class=\"text-xs font-bold uppercase tracking-widest\" data-kid=\"1-4-3-1-4-2-3\" data-name=\"case 4 view link\" href=\"#\">\n                            View Archive\n                        </a>\n                    </div>\n                </div>\n                <!-- Case 5: Social Campaign -->\n                <div class=\"masonry-item group gsap-reveal-item\" data-kid=\"1-4-3-1-5\" data-name=\"case study item 5\">\n                    <div class=\"relative overflow-hidden bg-[#F2F4F8] aspect-square\" data-kid=\"1-4-3-1-5-1\" data-name=\"case 5 image wrapper\">\n                        <img alt=\"Social Media\" class=\"w-full h-full object-cover transition-all duration-700 group-hover:scale-105\" data-kid=\"1-4-3-1-5-1-1\" data-name=\"case 5 image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1703223513338-dbcce451a748?auto=format&w=800&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"mt-6 border-b border-[#2A2A29]/10 pb-6\" data-kid=\"1-4-3-1-5-2\" data-name=\"case 5 details wrapper\">\n                        <h3 class=\"font-fraunces text-2xl mb-3\" data-kid=\"1-4-3-1-5-2-1\" data-name=\"case 5 title\">\n                            Buenos Social\n                        </h3>\n                        <p class=\"text-sm opacity-60 leading-relaxed mb-4\" data-kid=\"1-4-3-1-5-2-2\" data-name=\"case 5 description text\">\n                            Strategy and content production for Gen-Z audiences.\n                        </p>\n                        <a class=\"text-xs font-bold uppercase tracking-widest\" data-kid=\"1-4-3-1-5-2-3\" data-name=\"case 5 view link\" href=\"#\">\n                            Campaign Stats\n                        </a>\n                    </div>\n                </div>\n                <!-- Case 6: Wide Archive -->\n                <div class=\"masonry-item group gsap-reveal-item\" data-kid=\"1-4-3-1-6\" data-name=\"case study item 6\">\n                    <div class=\"relative overflow-hidden bg-[#F2F4F8] aspect-[16/10]\" data-kid=\"1-4-3-1-6-1\" data-name=\"case 6 image wrapper\">\n                        <img alt=\"Print Archive\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000\" data-kid=\"1-4-3-1-6-1-1\" data-name=\"case 6 image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1490013616775-3ca8865fb129?auto=format&w=1200&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"mt-8 border-b border-[#2A2A29]/10 pb-8\" data-kid=\"1-4-3-1-6-2\" data-name=\"case 6 details wrapper\">\n                        <h3 class=\"font-fraunces text-3xl mb-4 group-hover:text-[#FF6636] transition-colors\" data-kid=\"1-4-3-1-6-2-1\" data-name=\"case 6 title\">\n                            Water Journal\n                        </h3>\n                        <div class=\"flex justify-between items-end\" data-kid=\"1-4-3-1-6-2-2\" data-name=\"case 6 stats wrapper\">\n                            <p class=\"text-sm opacity-60 leading-relaxed max-w-[70%]\" data-kid=\"1-4-3-1-6-2-2-1\" data-name=\"case 6 description text\">\n                                Award-winning editorial design redefined for the digital age, focusing on the intersection of tactile and digital.\n                            </p>\n                            <div class=\"text-right\" data-kid=\"1-4-3-1-6-2-2-2\" data-name=\"case 6 performance stats\">\n                                <span class=\"text-2xl font-fraunces text-[#FF6636]\" data-kid=\"1-4-3-1-6-2-2-2-1\" data-name=\"case 6 awards count\">\n                                    12 Awards\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Pull Quote -->\n        <section class=\"bg-[#F2F4F8] py-28 md:py-40 px-6 md:px-12 mt-20\" data-kid=\"1-4-4\" data-name=\"pull quote section\">\n            <div class=\"max-w-5xl mx-auto text-center relative gsap-reveal-quote\" data-kid=\"1-4-4-1\" data-name=\"quote wrapper\">\n                <h2 class=\"font-fraunces text-4xl md:text-6xl leading-[1.1] text-[#2A2A29] mb-12\" data-kid=\"1-4-4-1-1\" data-name=\"testimonial quote text\">\n                    \"DS-Graphix approach to design is\n                    <span class=\"italic\" data-kid=\"1-4-4-1-1-1\" data-name=\"quote highlighted text\">\n                        relentlessly objective\n                    </span>\n                    . They solve for business outcomes we didn't think design could touch.\"\n                </h2>\n                <div class=\"flex flex-col items-center gap-6\" data-kid=\"1-4-4-1-2\" data-name=\"attribution wrapper\">\n                    <div class=\"w-12 h-px bg-[#FF6636]\" data-kid=\"1-4-4-1-2-1\" data-name=\"quote decorative bar\">\n                    </div>\n                    <div data-kid=\"1-4-4-1-2-2\" data-name=\"author details\">\n                        <p class=\"text-sm font-bold uppercase tracking-[0.2em] mb-1\" data-kid=\"1-4-4-1-2-2-1\" data-name=\"author name\">\n                            Dhananjay Chalke\n                        </p>\n                        <p class=\"text-xs uppercase tracking-widest opacity-40\" data-kid=\"1-4-4-1-2-2-2\" data-name=\"author title\">\n                            Founder, DS-Graphix\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Client Logo Rail -->\n        <section class=\"py-16 px-6 md:px-12 max-w-[1440px] mx-auto overflow-hidden\" data-kid=\"1-4-5\" data-name=\"client logo rail section\">\n            <div class=\"border-y border-[#2A2A29]/10 py-10\" data-kid=\"1-4-5-1\" data-name=\"rail container\">\n                <div class=\"marquee-container opacity-40\" data-kid=\"1-4-5-1-1\" data-name=\"marquee content container\">\n                    <div class=\"marquee-content font-fraunces text-xl uppercase tracking-[0.3em]\" data-kid=\"1-4-5-1-1-1\" data-name=\"marquee list primary\">\n                        <span data-kid=\"1-4-5-1-1-1-1\" data-name=\"monsoonfish client name\">\n                            Monsoonfish\n                        </span>\n                        <span data-kid=\"1-4-5-1-1-1-2\" data-name=\"yuj designs client name\">\n                            YUJ Designs\n                        </span>\n                        <span data-kid=\"1-4-5-1-1-1-3\" data-name=\"finflow client name\">\n                            FinFlow\n                        </span>\n                        <span data-kid=\"1-4-5-1-1-1-4\" data-name=\"aura skincare client name\">\n                            Aura Skincare\n                        </span>\n                        <span data-kid=\"1-4-5-1-1-1-5\" data-name=\"lumina wealth client name\">\n                            Lumina Wealth\n                        </span>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"marquee-content font-fraunces text-xl uppercase tracking-[0.3em]\" data-kid=\"1-4-5-1-1-2\" data-name=\"marquee list secondary\">\n                        <span data-kid=\"1-4-5-1-1-2-1\" data-name=\"monsoonfish client name clone\">\n                            Monsoonfish\n                        </span>\n                        <span data-kid=\"1-4-5-1-1-2-2\" data-name=\"yuj designs client name clone\">\n                            YUJ Designs\n                        </span>\n                        <span data-kid=\"1-4-5-1-1-2-3\" data-name=\"finflow client name clone\">\n                            FinFlow\n                        </span>\n                        <span data-kid=\"1-4-5-1-1-2-4\" data-name=\"aura skincare client name clone\">\n                            Aura Skincare\n                        </span>\n                        <span data-kid=\"1-4-5-1-1-2-5\" data-name=\"lumina wealth client name clone\">\n                            Lumina Wealth\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Final CTA -->\n        <section class=\"py-24 md:py-32 px-6 md:px-12 text-center gsap-reveal-cta\" data-kid=\"1-4-6\" data-name=\"final cta section\">\n            <div class=\"max-w-4xl mx-auto\" data-kid=\"1-4-6-1\" data-name=\"cta content wrapper\">\n                <span class=\"text-xs font-bold uppercase tracking-[0.4em] text-[#FF6636] mb-10 block\" data-kid=\"1-4-6-1-1\" data-name=\"cta preheader\">\n                    Start your journey\n                </span>\n                <h2 class=\"font-fraunces text-7xl md:text-[9rem] leading-[0.8] tracking-tighter mb-16\" data-kid=\"1-4-6-1-2\" data-name=\"cta main headline\">\n                    Define your\n                    <br data-kid=\"1-4-6-1-2-1\" data-name=\"cta headline line break\"/>\n                    difference.\n                </h2>\n                <div class=\"flex flex-col sm:flex-row items-center justify-center gap-8\" data-kid=\"1-4-6-1-3\" data-name=\"cta buttons wrapper\">\n                    <button class=\"bg-[#FF6636] text-white px-12 py-5 text-xs font-bold uppercase tracking-[0.2em] hover:bg-black transition-all cursor-pointer\" data-kid=\"1-4-6-1-3-1\" data-name=\"strategy session button\">\n                        Book a Strategy Session\n                    </button>\n                    <a class=\"text-xs font-bold uppercase tracking-[0.2em] border-b border-[#2A2A29] pb-1 hover:text-[#FF6636] hover:border-[#FF6636] transition-all\" data-kid=\"1-4-6-1-3-2\" data-name=\"view process link\" href=\"#\">\n                        View Our Process\n                    </a>\n                </div>\n            </div>\n        </section>\n        <!-- Footer -->\n        <footer class=\"bg-white border-t border-[#2A2A29]/5 px-6 md:px-12 py-20\" data-kid=\"1-4-7\" data-name=\"footer section\">\n            <div class=\"max-w-[1440px] mx-auto flex flex-col md:flex-row justify-between items-start gap-12\" data-kid=\"1-4-7-1\" data-name=\"footer main content\">\n                <div class=\"max-w-sm\" data-kid=\"1-4-7-1-1\" data-name=\"footer branding and social\">\n                    <h4 class=\"text-2xl font-bold font-fraunces uppercase mb-6\" data-kid=\"1-4-7-1-1-1\" data-name=\"footer logo\">\n                        DS-Graphix\n                    </h4>\n                    <p class=\"text-sm text-[#2A2A29]/60 leading-relaxed mb-8 italic\" data-kid=\"1-4-7-1-1-2\" data-name=\"footer about snippet\">\n                        Building business-led digital products and identities that command attention.\n                    </p>\n                    <div class=\"flex gap-6 text-xl\" data-kid=\"1-4-7-1-1-3\" data-name=\"footer social icons\">\n                        <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-4-7-1-1-3-1\" data-name=\"linkedin link\" href=\"#\">\n                            <i class=\"ti ti-brand-linkedin\" data-kid=\"1-4-7-1-1-3-1-1\" data-name=\"linkedin icon\">\n                            </i>\n                        </a>\n                        <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"1-4-7-1-1-3-2\" data-name=\"instagram link\" href=\"#\">\n                            <i class=\"ti ti-brand-instagram\" data-kid=\"1-4-7-1-1-3-2-1\" data-name=\"instagram icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-2 sm:grid-cols-3 gap-16 md:gap-24\" data-kid=\"1-4-7-1-2\" data-name=\"footer nav grids\">\n                    <div data-kid=\"1-4-7-1-2-1\" data-name=\"explore column\">\n                        <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#FF6636] mb-6 block\" data-kid=\"1-4-7-1-2-1-1\" data-name=\"explore title\">\n                            Explore\n                        </span>\n                        <ul class=\"flex flex-col gap-4 text-xs font-bold uppercase tracking-[0.1em] opacity-70\" data-kid=\"1-4-7-1-2-1-2\" data-name=\"explore links list\">\n                            <li data-kid=\"1-4-7-1-2-1-2-1\" data-name=\"explore work link item\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-4-7-1-2-1-2-1-1\" data-name=\"explore work link\" href=\"#\">\n                                    Work\n                                </a>\n                            </li>\n                            <li data-kid=\"1-4-7-1-2-1-2-2\" data-name=\"explore services link item\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-4-7-1-2-1-2-2-1\" data-name=\"explore services link\" href=\"#\">\n                                    Services\n                                </a>\n                            </li>\n                            <li data-kid=\"1-4-7-1-2-1-2-3\" data-name=\"explore process link item\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-4-7-1-2-1-2-3-1\" data-name=\"explore process link\" href=\"#\">\n                                    Process\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-4-7-1-2-2\" data-name=\"capabilities column\">\n                        <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#FF6636] mb-6 block\" data-kid=\"1-4-7-1-2-2-1\" data-name=\"capabilities title\">\n                            Capabilities\n                        </span>\n                        <ul class=\"flex flex-col gap-4 text-xs font-bold uppercase tracking-[0.1em] opacity-70\" data-kid=\"1-4-7-1-2-2-2\" data-name=\"capabilities links list\">\n                            <li data-kid=\"1-4-7-1-2-2-2-1\" data-name=\"capabilities uiux link item\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-4-7-1-2-2-2-1-1\" data-name=\"capabilities uiux link\" href=\"#\">\n                                    UI/UX\n                                </a>\n                            </li>\n                            <li data-kid=\"1-4-7-1-2-2-2-2\" data-name=\"capabilities branding link item\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-4-7-1-2-2-2-2-1\" data-name=\"capabilities branding link\" href=\"#\">\n                                    Branding\n                                </a>\n                            </li>\n                            <li data-kid=\"1-4-7-1-2-2-2-3\" data-name=\"capabilities video link item\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-4-7-1-2-2-2-3-1\" data-name=\"capabilities video link\" href=\"#\">\n                                    Video\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-4-7-1-2-3\" data-name=\"reach out column\">\n                        <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#FF6636] mb-6 block\" data-kid=\"1-4-7-1-2-3-1\" data-name=\"reach out title\">\n                            Reach Out\n                        </span>\n                        <ul class=\"flex flex-col gap-4 text-xs font-bold uppercase tracking-[0.1em] opacity-70\" data-kid=\"1-4-7-1-2-3-2\" data-name=\"reach out links list\">\n                            <li data-kid=\"1-4-7-1-2-3-2-1\" data-name=\"reach out email link item\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-4-7-1-2-3-2-1-1\" data-name=\"reach out email link\" href=\"#\">\n                                    Email\n                                </a>\n                            </li>\n                            <li data-kid=\"1-4-7-1-2-3-2-2\" data-name=\"reach out whatsapp link item\">\n                                <a class=\"hover:text-[#FF6636]\" data-kid=\"1-4-7-1-2-3-2-2-1\" data-name=\"reach out whatsapp link\" href=\"#\">\n                                    WhatsApp\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"max-w-[1440px] mx-auto mt-20 pt-10 border-t border-[#2A2A29]/5 flex flex-col sm:flex-row justify-between items-center gap-6 text-[10px] font-bold uppercase tracking-widest opacity-40\" data-kid=\"1-4-7-2\" data-name=\"footer bottom bar\">\n                <p data-kid=\"1-4-7-2-1\" data-name=\"copyright text\">\n                    © 2026 DS-Graphix Agency.\n                </p>\n                <div class=\"flex gap-8\" data-kid=\"1-4-7-2-2\" data-name=\"footer secondary links\">\n                    <a class=\"hover:text-[#2A2A29]\" data-kid=\"1-4-7-2-2-1\" data-name=\"privacy link\" href=\"#\">\n                        Privacy\n                    </a>\n                    <a class=\"hover:text-[#2A2A29]\" data-kid=\"1-4-7-2-2-2\" data-name=\"terms link\" href=\"#\">\n                        Terms\n                    </a>\n                </div>\n            </div>\n        </footer>\n    </main>\n    <!-- WhatsApp FAB -->\n    <div class=\"fixed bottom-8 right-8 z-[100]\" data-kid=\"1-5\" data-name=\"whatsapp fab container\">\n        <a class=\"w-14 h-14 bg-[#25D366] text-white rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform\" data-kid=\"1-5-1\" data-name=\"whatsapp floating action button\" href=\"https://wa.me/+919890388405\" target=\"_blank\">\n            <i class=\"ti ti-brand-whatsapp text-3xl\" data-kid=\"1-5-1-1\" data-name=\"whatsapp icon\">\n            </i>\n        </a>\n    </div>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script type=\"module\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Initialize Lenis\n    const lenis = new Lenis({\n      duration: 1.2,\n      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n      smoothWheel: true,\n    })\n\n    function raf(time) {\n      lenis.raf(time)\n      requestAnimationFrame(raf)\n    }\n\n    requestAnimationFrame(raf)\n\n    // Initialize GSAP\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Animations - Use set + to for initial safety\n    gsap.set(\".gsap-reveal-hero\", { opacity: 0, y: 60 });\n    gsap.to(\".gsap-reveal-hero\", {\n      duration: 1.5,\n      y: 0,\n      opacity: 1,\n      ease: \"power4.out\",\n      stagger: 0.2,\n      delay: 0.2\n    });\n\n    // Batch Reveals for Masonry Items\n    ScrollTrigger.batch(\".gsap-reveal-item\", {\n      onEnter: batch => gsap.fromTo(batch, \n        { opacity: 0, y: 40 }, \n        { opacity: 1, y: 0, duration: 1, stagger: 0.1, ease: \"power3.out\", overwrite: true }\n      ),\n      start: \"top 92%\",\n    });\n\n    // Quote Reveal\n    gsap.fromTo(\".gsap-reveal-quote\", \n      { opacity: 0, y: 30 },\n      {\n        scrollTrigger: {\n          trigger: \".gsap-reveal-quote\",\n          start: \"top 85%\",\n        },\n        duration: 1.2,\n        y: 0,\n        opacity: 1,\n        ease: \"power3.out\"\n      }\n    );\n\n    // CTA Reveal\n    gsap.fromTo(\".gsap-reveal-cta\", \n      { opacity: 0, scale: 0.98 },\n      {\n        scrollTrigger: {\n          trigger: \".gsap-reveal-cta\",\n          start: \"top 85%\",\n        },\n        duration: 1.5,\n        scale: 1,\n        opacity: 1,\n        ease: \"power2.out\"\n      }\n    );\n\n    // Image Clip Reveals\n    const imageObserver = new IntersectionObserver((entries) => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          entry.target.classList.add('active');\n        }\n      });\n    }, { threshold: 0.1 });\n\n    document.querySelectorAll('.image-reveal').forEach(img => imageObserver.observe(img));\n    </script>\n</div>\n",
