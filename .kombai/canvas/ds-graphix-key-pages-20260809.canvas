              </div>\n                </div>\n            </aside>\n        </section>\n        <!-- Final Footer Reveal -->\n        <footer class=\"bg-[#FF6636] text-[#2A2A29] px-6 md:px-12 py-24 md:py-40 relative z-10\" data-kid=\"3-2-3\" data-name=\"page footer\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"3-2-3-1\" data-name=\"footer inner container\">\n                <div class=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-16 mb-24\" data-kid=\"3-2-3-1-1\" data-name=\"footer header section\">\n                    <h2 class=\"font-heading text-[12vw] font-black leading-none tracking-tighter uppercase footer-logo\" data-kid=\"3-2-3-1-1-1\" data-name=\"footer logo heading\">\n                        DS-GRAPHIX\n                    </h2>\n                    <div class=\"max-w-xs space-y-4\" data-kid=\"3-2-3-1-1-2\" data-name=\"footer description container\">\n                        <p class=\"font-heading font-bold text-xl leading-tight uppercase\" data-kid=\"3-2-3-1-1-2-1\" data-name=\"footer agency title text\">\n                            Full-Service Creative & Digital Agency.\n                        </p>\n                        <p class=\"text-sm font-medium opacity-70\" data-kid=\"3-2-3-1-1-2-2\" data-name=\"footer agency description text\">\n                            Empowering brands with high-impact, business-driven design solutions.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"border-t-4 border-[#2A2A29] pt-12 flex flex-col md:flex-row justify-between gap-12\" data-kid=\"3-2-3-1-2\" data-name=\"footer bottom section\">\n                    <div class=\"flex flex-wrap gap-8 md:gap-16 font-heading font-black text-xs md:text-sm uppercase tracking-widest\" data-kid=\"3-2-3-1-2-1\" data-name=\"footer navigation menu\">\n                        <a class=\"hover:underline underline-offset-4\" data-kid=\"3-2-3-1-2-1-1\" data-name=\"work link\" href=\"#\">\n                            Work\n                        </a>\n                        <a class=\"hover:underline underline-offset-4\" data-kid=\"3-2-3-1-2-1-2\" data-name=\"studio link\" href=\"#\">\n                            Studio\n                        </a>\n                        <a class=\"hover:underline underline-offset-4\" data-kid=\"3-2-3-1-2-1-3\" data-name=\"process link\" href=\"#\">\n                            Process\n                        </a>\n                        <a class=\"hover:underline underline-offset-4\" data-kid=\"3-2-3-1-2-1-4\" data-name=\"insights link\" href=\"#\">\n                            Insights\n                        </a>\n                    </div>\n                    <div class=\"flex flex-col md:flex-row gap-8 md:gap-16 font-heading font-bold text-[10px] md:text-xs uppercase tracking-[0.2em] opacity-60\" data-kid=\"3-2-3-1-2-2\" data-name=\"footer secondary links and copyright\">\n                        <div class=\"flex gap-8\" data-kid=\"3-2-3-1-2-2-1\" data-name=\"legal links container\">\n                            <a class=\"hover:text-[#2A2A29]\" data-kid=\"3-2-3-1-2-2-1-1\" data-name=\"privacy link\" href=\"#\">\n                                Privacy\n                            </a>\n                            <a class=\"hover:text-[#2A2A29]\" data-kid=\"3-2-3-1-2-2-1-2\" data-name=\"terms link\" href=\"#\">\n                                Terms\n                            </a>\n                            <a class=\"hover:text-[#2A2A29]\" data-kid=\"3-2-3-1-2-2-1-3\" data-name=\"cookies link\" href=\"#\">\n                                Cookies\n                            </a>\n                        </div>\n                        <p data-kid=\"3-2-3-1-2-2-2\" data-name=\"copyright notice text\">\n                            © 2026 DS-GRAPHIX. BOLD BY DESIGN.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    </main>\n    <!-- Sticky Elements -->\n    <div class=\"whatsapp-tab\" data-kid=\"3-3\" data-name=\"whatsapp chat tab container\">\n        <div class=\"rotated-text-tab hidden md:block shadow-2xl\" data-kid=\"3-3-1\" data-name=\"whatsapp rotated label text\">\n            Quick Chat\n        </div>\n        <a class=\"whatsapp-btn sharp-corners\" data-kid=\"3-3-2\" data-name=\"whatsapp button\" href=\"#\">\n            <i class=\"fab fa-whatsapp text-2xl\" data-kid=\"3-3-2-1\" data-name=\"whatsapp icon\">\n            </i>\n        </a>\n    </div>\n    <div class=\"booking-cta-bar brutalist-border sharp-corners\" data-kid=\"3-4\" data-name=\"booking call to action bar\">\n        <p class=\"font-heading font-black uppercase text-sm tracking-widest\" data-kid=\"3-4-1\" data-name=\"discovery call prompt text\">\n            Discovery Call?\n        </p>\n        <a class=\"bg-white text-[#2A2A29] px-6 py-2 font-heading font-black uppercase text-xs tracking-widest sharp-corners hover:bg-[#FF6636] hover:text-white transition-colors\" data-kid=\"3-4-2\" data-name=\"book now button\" href=\"#\">\n            Book Now\n        </a>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    const lenis = new Lenis()\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    window.addEventListener('load', () => {\n        const tl = gsap.timeline({ defaults: { ease: \"power4.out\" } });\n\n        // Parallax G\n        gsap.to(\".hero-g\", {\n            y: -100,\n            scrollTrigger: {\n                trigger: \".hero-text\",\n                start: \"top top\",\n                scrub: true\n            }\n        });\n\n        // Hero Entrance\n        tl.from(\".hero-text\", {\n            y: 100,\n            opacity: 0,\n            duration: 1.2,\n            stagger: 0.15\n        })\n        .from(\".hero-subtext\", {\n            y: 30,\n            opacity: 0,\n            duration: 1\n        }, \"-=0.8\");\n\n        // Section Trigger Animations\n        gsap.from(\".section-title\", {\n            scrollTrigger: {\n                trigger: \".section-title\",\n                start: \"top 85%\",\n            },\n            x: -50,\n            opacity: 0,\n            duration: 1\n        });\n\n        gsap.from(\".form-input-container\", {\n            scrollTrigger: {\n                trigger: \".inquiry-form\",\n                start: \"top 75%\",\n            },\n            y: 40,\n            opacity: 0,\n            duration: 0.8,\n            stagger: 0.1\n        });\n\n        gsap.from(\".sidebar-content section\", {\n            scrollTrigger: {\n                trigger: \".sidebar-content\",\n                start: \"top 80%\",\n            },\n            y: 50,\n            opacity: 0,\n            duration: 1,\n            stagger: 0.2\n        });\n\n        // Footer Reveal Logo Effect\n        gsap.from(\".footer-logo\", {\n            scrollTrigger: {\n                trigger: \"footer\",\n                start: \"top bottom\",\n                end: \"bottom bottom\",\n                scrub: 1.5\n            },\n            x: -250,\n            ease: \"none\"\n        });\n    });\n\n    const chips = document.querySelectorAll('.service-chip');\n    chips.forEach(chip => {\n        chip.addEventListener('click', () => {\n            chips.forEach(c => c.classList.remove('active'));\n            chip.classList.add('active');\n        });\n    });\n</script>\n<<<<<<< SEARCH\n=======\n>>>>>>> REPLACE\n",
      "comments": [],
      "created": "2026-08-09T11:39:40.286715+00:00",
      "modified": "2026-08-09T11:39:40.286715+00:00",
      "id": "var_416af0d93a0a",
      "overrides": {
        "htmlAttrs": " lang=\"en\"",
        "bodyAttrs": " class=\"noise\"",
        "head": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Contact DS-Graphix | Let's Make Something Useful</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>"
      }
    },
    "var_e06bf19d1ab0": {
      "type": "variant",
      "label": "Expressive — Process",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 11040,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap');\n\n  :root {\n    --color-dark: #2A2A29;\n    --color-orange: #FF6636;\n    --color-light: #F2F4F8;\n    --color-white: #FFFFFF;\n  }\n\n  body {\n    background-color: var(--color-dark);\n    color: var(--color-white);\n    font-family: 'Source+Sans+3', sans-serif;\n    margin: 0;\n    overflow-x: clip;\n  }\n\n  .font-heading {\n    font-family: 'Bricolage Grotesque', sans-serif;\n  }\n\n  .brutalist-border {\n    border: 3px solid var(--color-white);\n  }\n\n  .noise-grain::after {\n    content: \"\";\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    opacity: 0.03;\n    z-index: 9999;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n  }\n\n  .diagonal-ticker {\n    transform: rotate(-2deg) scale(1.05);\n  }\n\n  .step-num {\n    font-size: 160px;\n    line-height: 0.8;\n    color: var(--color-orange);\n    -webkit-text-stroke: 2px var(--color-orange);\n    opacity: 0.9;\n    filter: drop-shadow(0 0 10px rgba(255, 102, 54, 0.2));\n  }\n\n  /* Custom selection */\n  ::selection {\n    background: var(--color-orange);\n    color: var(--color-white);\n  }\n</style>\n<div class=\"noise-grain\" data-kid=\"1\" data-name=\"noise texture grain overlay\">\n</div>\n<!-- Compact Header -->\n<header class=\"fixed top-0 left-0 w-full z-50 bg-[var(--color-dark)]/80 backdrop-blur-md border-b border-white/10 px-6 py-4 flex justify-between items-center\" data-kid=\"2\" data-name=\"site header navigation bar\">\n    <div class=\"flex items-center gap-2\" data-kid=\"2-1\" data-name=\"site logo container\">\n        <div class=\"w-8 h-8 bg-[var(--color-orange)]\" data-kid=\"2-1-1\" data-name=\"brand logo icon\">\n        </div>\n        <span class=\"font-heading font-extrabold text-xl tracking-tighter uppercase\" data-kid=\"2-1-2\" data-name=\"brand name text\">\n            DS-Graphix\n        </span>\n    </div>\n    <nav class=\"hidden md:flex items-center gap-12 font-heading font-bold text-sm tracking-widest uppercase\" data-kid=\"2-2\" data-name=\"primary navigation links\">\n        <a class=\"hover:text-[var(--color-orange)] transition-colors\" data-kid=\"2-2-1\" data-name=\"navigation link services\" href=\"#\">\n            Services\n        </a>\n        <a class=\"hover:text-[var(--color-orange)] transition-colors text-[var(--color-orange)]\" data-kid=\"2-2-2\" data-name=\"navigation link process\" href=\"#\">\n            Process\n        </a>\n        <a class=\"hover:text-[var(--color-orange)] transition-colors\" data-kid=\"2-2-3\" data-name=\"navigation link portfolio\" href=\"#\">\n            Portfolio\n        </a>\n        <a class=\"hover:text-[var(--color-orange)] transition-colors\" data-kid=\"2-2-4\" data-name=\"navigation link about\" href=\"#\">\n            About\n        </a>\n    </nav>\n    <button class=\"font-heading font-extrabold text-sm tracking-widest uppercase bg-white text-[var(--color-dark)] px-6 py-2 border-2 border-white hover:bg-transparent hover:text-white transition-all\" data-kid=\"2-3\" data-name=\"enquire call-to-action button\">\n        Enquire\n    </button>\n</header>\n<!-- Hero Section -->\n<section class=\"min-h-screen flex flex-col justify-center px-6 md:px-16 pt-32 pb-20 relative overflow-hidden\" data-kid=\"3\" data-name=\"hero section\" id=\"hero\">\n    <!-- Corner Coordinates -->\n    <div class=\"absolute top-32 left-16 font-heading text-[10px] tracking-[0.5em] opacity-30 hidden md:block\" data-kid=\"3-1\" data-name=\"location coordinates text\">\n        40.7128° N, 74.0060° W\n    </div>\n    <div class=\"max-w-7xl mx-auto w-full relative z-10\" data-kid=\"3-2\" data-name=\"hero content wrapper\">\n        <div class=\"overflow-hidden\" data-kid=\"3-2-1\" data-name=\"hero headline wrapper\">\n            <h1 class=\"hero-text font-heading text-[12vw] md:text-[10vw] leading-[0.85] font-extrabold uppercase tracking-tighter mb-12\" data-kid=\"3-2-1-1\" data-name=\"main hero headline text\">\n                MAKE THE\n                <br data-kid=\"3-2-1-1-1\" data-name=\"line break\"/>\n                <span class=\"text-[var(--color-orange)]\" data-kid=\"3-2-1-1-2\" data-name=\"highlighted word text\">\n                    WORK\n                </span>\n                MOVE.\n            </h1>\n        </div>\n        <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-8\" data-kid=\"3-2-2\" data-name=\"hero footer information area\">\n            <div class=\"max-w-xl hero-subline border-l-4 border-[var(--color-orange)] pl-8 py-4\" data-kid=\"3-2-2-1\" data-name=\"hero description container\">\n                <p class=\"text-2xl md:text-3xl font-light text-[var(--color-light)]\" data-kid=\"3-2-2-1-1\" data-name=\"hero description text\">\n                    A clear operating rhythm for\n                    <span class=\"font-bold text-white\" data-kid=\"3-2-2-1-1-1\" data-name=\"bold emphasis text\">\n                        fast, thoughtful delivery\n                    </span>\n                    . \n          We eliminate friction between concept and reality.\n                </p>\n            </div>\n            <div class=\"flex flex-col gap-4 font-heading text-sm tracking-[0.2em] uppercase opacity-50\" data-kid=\"3-2-2-2\" data-name=\"hero meta details container\">\n                <p data-kid=\"3-2-2-2-1\" data-name=\"establishment date text\">\n                    Est. 2024\n                </p>\n                <p data-kid=\"3-2-2-2-2\" data-name=\"delivery reach text\">\n                    Global Delivery\n                </p>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- Diagonal Ticker Strip -->\n<div class=\"bg-[var(--color-orange)] py-4 overflow-hidden z-10 relative diagonal-ticker border-y-4 border-white\" data-kid=\"4\" data-name=\"diagonal marquee strip\">\n    <div class=\"flex whitespace-nowrap marquee-container\" data-dynamic=\"true\" data-kid=\"4-1\" data-name=\"marquee content container\" data-reason=\"content translated horizontally by marquee script\">\n        <div class=\"flex items-center gap-8 px-4 font-heading font-black text-2xl md:text-4xl text-white uppercase italic tracking-tighter\" data-dynamic=\"true\" data-kid=\"4-1-1\" data-name=\"first marquee track\" data-reason=\"content translated horizontally by marquee script\">\n            <span data-dynamic=\"true\" data-kid=\"4-1-1-1\" data-name=\"marquee high velocity text\" data-reason=\"content translated horizontally by marquee script\">\n                High Velocity\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-1-2\" data-name=\"marquee bullet separator one\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-1-3\" data-name=\"marquee outcome led text\" data-reason=\"content translated horizontally by marquee script\">\n                Outcome Led\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-1-4\" data-name=\"marquee bullet separator two\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-1-5\" data-name=\"marquee brutal clarity text\" data-reason=\"content translated horizontally by marquee script\">\n                Brutal Clarity\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-1-6\" data-name=\"marquee bullet separator three\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-1-7\" data-name=\"marquee design systems text\" data-reason=\"content translated horizontally by marquee script\">\n                Design Systems\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-1-8\" data-name=\"marquee bullet separator four\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-1-9\" data-name=\"marquee high velocity text repeat\" data-reason=\"content translated horizontally by marquee script\">\n                High Velocity\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-1-10\" data-name=\"marquee bullet separator five\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-1-11\" data-name=\"marquee outcome led text repeat\" data-reason=\"content translated horizontally by marquee script\">\n                Outcome Led\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-1-12\" data-name=\"marquee bullet separator six\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-1-13\" data-name=\"marquee brutal clarity text repeat\" data-reason=\"content translated horizontally by marquee script\">\n                Brutal Clarity\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-1-14\" data-name=\"marquee bullet separator seven\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-1-15\" data-name=\"marquee design systems text repeat\" data-reason=\"content translated horizontally by marquee script\">\n                Design Systems\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-1-16\" data-name=\"marquee bullet separator eight\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n        </div>\n        <div class=\"flex items-center gap-8 px-4 font-heading font-black text-2xl md:text-4xl text-white uppercase italic tracking-tighter\" data-dynamic=\"true\" data-kid=\"4-1-2\" data-name=\"second marquee track\" data-reason=\"content translated horizontally by marquee script\">\n            <span data-dynamic=\"true\" data-kid=\"4-1-2-1\" data-name=\"marquee high velocity text\" data-reason=\"content translated horizontally by marquee script\">\n                High Velocity\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-2-2\" data-name=\"marquee bullet separator\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-2-3\" data-name=\"marquee outcome led text\" data-reason=\"content translated horizontally by marquee script\">\n                Outcome Led\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-2-4\" data-name=\"marquee bullet separator\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-2-5\" data-name=\"marquee brutal clarity text\" data-reason=\"content translated horizontally by marquee script\">\n                Brutal Clarity\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-2-6\" data-name=\"marquee bullet separator\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-2-7\" data-name=\"marquee design systems text\" data-reason=\"content translated horizontally by marquee script\">\n                Design Systems\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-2-8\" data-name=\"marquee bullet separator\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-2-9\" data-name=\"marquee high velocity text repeat\" data-reason=\"content translated horizontally by marquee script\">\n                High Velocity\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-2-10\" data-name=\"marquee bullet separator\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-2-11\" data-name=\"marquee outcome led text repeat\" data-reason=\"content translated horizontally by marquee script\">\n                Outcome Led\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-2-12\" data-name=\"marquee bullet separator\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-2-13\" data-name=\"marquee brutal clarity text repeat\" data-reason=\"content translated horizontally by marquee script\">\n                Brutal Clarity\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-2-14\" data-name=\"marquee bullet separator\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"4-1-2-15\" data-name=\"marquee design systems text repeat\" data-reason=\"content translated horizontally by marquee script\">\n                Design Systems\n            </span>\n            <span class=\"text-[var(--color-dark)]\" data-dynamic=\"true\" data-kid=\"4-1-2-16\" data-name=\"marquee bullet separator\" data-reason=\"content translated horizontally by marquee script\">\n                •\n            </span>\n        </div>\n    </div>\n</div>\n<!-- Process Section -->\n<section class=\"py-40 px-6 md:px-16 overflow-x-clip relative\" data-kid=\"5\" data-name=\"process section\" id=\"process\">\n    <!-- Background Decoration -->\n    <div class=\"absolute top-0 right-0 opacity-[0.02] pointer-events-none font-heading font-black text-[40vw] leading-none select-none overflow-hidden\" data-kid=\"5-1\" data-name=\"background decorative text\">\n        STEPS\n    </div>\n    <div class=\"max-w-6xl mx-auto relative\" data-kid=\"5-2\" data-name=\"process steps container\">\n        <!-- Vertical Rail -->\n        <div class=\"absolute left-1/2 top-0 bottom-0 w-[4px] bg-white/40 -translate-x-1/2 hidden md:block\" data-kid=\"5-2-1\" data-name=\"desktop vertical rail\">\n        </div>\n        <div class=\"absolute left-0 top-0 bottom-0 w-[4px] bg-white/40 md:hidden\" data-kid=\"5-2-2\" data-name=\"mobile vertical rail\">\n        </div>\n        <div class=\"space-y-24 md:space-y-32 relative\" data-kid=\"5-2-3\" data-name=\"steps list wrapper\">\n            <!-- Step 01: ALIGN -->\n            <div class=\"process-step flex flex-col md:flex-row items-start md:justify-start\" data-kid=\"5-2-3-1\" data-name=\"process step one container\">\n                <div class=\"w-full md:w-[46%] brutalist-border p-10 md:p-16 bg-[var(--color-dark)] relative group\" data-kid=\"5-2-3-1-1\" data-name=\"step one card\">\n                    <span class=\"step-num font-heading absolute -top-20 -left-6 md:-left-12 pointer-events-none\" data-kid=\"5-2-3-1-1-1\" data-name=\"step one number text\">\n                        01\n                    </span>\n                    <h3 class=\"font-heading text-5xl md:text-6xl font-black mb-8 pt-12\" data-kid=\"5-2-3-1-1-2\" data-name=\"step one title text\">\n                        ALIGN\n                    </h3>\n                    <p class=\"text-xl text-[var(--color-light)] mb-10 leading-relaxed\" data-kid=\"5-2-3-1-1-3\" data-name=\"step one description text\">\n                        We start by defining the battlefield. No pixels are moved until the strategic foundation is cast in stone.\n                    </p>\n                    <div class=\"grid grid-cols-1 gap-6\" data-kid=\"5-2-3-1-1-4\" data-name=\"step one features list\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"5-2-3-1-1-4-1\" data-name=\"feature list item one\">\n                            <span class=\"w-12 h-[2px] bg-[var(--color-orange)]\" data-kid=\"5-2-3-1-1-4-1-1\" data-name=\"feature bullet line one\">\n                            </span>\n                            <span class=\"font-heading uppercase tracking-widest text-sm font-bold\" data-kid=\"5-2-3-1-1-4-1-2\" data-name=\"feature title one\">\n                                Discovery Brief\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"5-2-3-1-1-4-2\" data-name=\"feature list item two\">\n                            <span class=\"w-12 h-[2px] bg-[var(--color-orange)]\" data-kid=\"5-2-3-1-1-4-2-1\" data-name=\"feature bullet line two\">\n                            </span>\n                            <span class=\"font-heading uppercase tracking-widest text-sm font-bold\" data-kid=\"5-2-3-1-1-4-2