ty-100 transition-all duration-500\" data-kid=\"2-5-2-4-2\" data-name=\"project card overlay info\">\n                    <span class=\"text-[10px] uppercase tracking-[0.3em] bg-orange px-5 py-2 mb-4 inline-block font-black\" data-kid=\"2-5-2-4-2-1\" data-name=\"project tag\">\n                        Content Strategy\n                    </span>\n                    <h3 class=\"text-5xl font-serif font-black leading-none\" data-kid=\"2-5-2-4-2-2\" data-name=\"project title\">\n                        NMG Network\n                        <br data-kid=\"2-5-2-4-2-2-1\" data-name=\"project title line break\"/>\n                        Digital Lab\n                    </h3>\n                </div>\n                <div class=\"absolute inset-0 bg-gradient-to-t from-dark/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"2-5-2-4-3\" data-name=\"hover gradient overlay\">\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Process Section with Margin Proof -->\n    <section class=\"bg-light-gray py-40 overflow-x-clip\" data-kid=\"2-6\" data-name=\"process section\" id=\"process\">\n        <div class=\"max-w-[1440px] mx-auto px-6 grid lg:grid-cols-12 gap-24 relative\" data-kid=\"2-6-1\" data-name=\"process content wrapper\">\n            <div class=\"lg:col-span-8\" data-kid=\"2-6-1-1\" data-name=\"workflow column\">\n                <h2 class=\"text-xs uppercase tracking-[0.5em] font-black mb-24 opacity-30\" data-kid=\"2-6-1-1-1\" data-name=\"workflow section heading\">\n                    Our Workflow\n                </h2>\n                <div class=\"space-y-32\" data-kid=\"2-6-1-1-2\" data-name=\"workflow steps list\">\n                    <div class=\"flex gap-16 animate-reveal\" data-kid=\"2-6-1-1-2-1\" data-name=\"discovery step item\">\n                        <span class=\"text-7xl font-serif text-orange font-black\" data-kid=\"2-6-1-1-2-1-1\" data-name=\"step number one\">\n                            01\n                        </span>\n                        <div data-kid=\"2-6-1-1-2-1-2\" data-name=\"step content container\">\n                            <h3 class=\"text-4xl font-black mb-6 font-serif\" data-kid=\"2-6-1-1-2-1-2-1\" data-name=\"step title\">\n                                Discovery & Audit\n                            </h3>\n                            <p class=\"text-xl opacity-70 max-w-xl leading-relaxed\" data-kid=\"2-6-1-1-2-1-2-2\" data-name=\"step description\">\n                                We don't guess. We analyze. We dive into your analytics, talk to your users, and understand the core business friction points before pushing a single pixel.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-16 animate-reveal\" data-kid=\"2-6-1-1-2-2\" data-name=\"strategic mapping step item\">\n                        <span class=\"text-7xl font-serif text-orange font-black\" data-kid=\"2-6-1-1-2-2-1\" data-name=\"step number two\">\n                            02\n                        </span>\n                        <div data-kid=\"2-6-1-1-2-2-2\" data-name=\"step content container\">\n                            <h3 class=\"text-4xl font-black mb-6 font-serif\" data-kid=\"2-6-1-1-2-2-2-1\" data-name=\"step title\">\n                                Strategic Mapping\n                            </h3>\n                            <p class=\"text-xl opacity-70 max-w-xl leading-relaxed\" data-kid=\"2-6-1-1-2-2-2-2\" data-name=\"step description\">\n                                Architecture precedes aesthetics. We map out the cognitive journey, ensuring the logic is bulletproof and the value proposition is unavoidable.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-16 animate-reveal\" data-kid=\"2-6-1-1-2-3\" data-name=\"creative execution step item\">\n                        <span class=\"text-7xl font-serif text-orange font-black\" data-kid=\"2-6-1-1-2-3-1\" data-name=\"step number three\">\n                            03\n                        </span>\n                        <div data-kid=\"2-6-1-1-2-3-2\" data-name=\"step content container\">\n                            <h3 class=\"text-4xl font-black mb-6 font-serif\" data-kid=\"2-6-1-1-2-3-2-1\" data-name=\"step title\">\n                                Creative Execution\n                            </h3>\n                            <p class=\"text-xl opacity-70 max-w-xl leading-relaxed\" data-kid=\"2-6-1-1-2-3-2-2\" data-name=\"step description\">\n                                High-fidelity design meets rigorous business logic. We build visual systems that are as scalable as they are stunning.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-16 animate-reveal\" data-kid=\"2-6-1-1-2-4\" data-name=\"handoff step item\">\n                        <span class=\"text-7xl font-serif text-orange font-black\" data-kid=\"2-6-1-1-2-4-1\" data-name=\"step number four\">\n                            04\n                        </span>\n                        <div data-kid=\"2-6-1-1-2-4-2\" data-name=\"step content container\">\n                            <h3 class=\"text-4xl font-black mb-6 font-serif\" data-kid=\"2-6-1-1-2-4-2-1\" data-name=\"step title\">\n                                Handoff & Growth\n                            </h3>\n                            <p class=\"text-xl opacity-70 max-w-xl leading-relaxed\" data-kid=\"2-6-1-1-2-4-2-2\" data-name=\"step description\">\n                                Seamless developer handoff is our standard. We stick around to monitor metrics and optimize the experience post-launch.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Margin Proof / Testimonial Pull Quote -->\n            <div class=\"lg:col-span-4 flex flex-col justify-center border-l border-dark/5 pl-12\" data-kid=\"2-6-1-2\" data-name=\"testimonial column\">\n                <div class=\"sticky top-40 animate-reveal\" data-kid=\"2-6-1-2-1\" data-name=\"testimonial sticky wrapper\">\n                    <div class=\"text-[140px] font-serif text-orange/10 absolute -top-36 -left-16 leading-none\" data-kid=\"2-6-1-2-1-1\" data-name=\"testimonial quote mark\">\n                        “\n                    </div>\n                    <blockquote class=\"text-4xl md:text-5xl font-black italic leading-[1.4] mb-12 relative z-10 font-serif\" data-kid=\"2-6-1-2-1-2\" data-name=\"testimonial blockquote\">\n                        \"Monsoonfish helped us drastically reduce the GTM of new products. Their\n                        <span class=\"bg-orange text-white px-3 not-italic\" data-kid=\"2-6-1-2-1-2-1\" data-name=\"testimonial emphasis span\">\n                            40% reduction\n                        </span>\n                        in drop-offs was a game changer.\"\n                    </blockquote>\n                    <div class=\"flex items-center gap-6 p-8 bg-white border border-dark/5 shadow-2xl animate-reveal\" data-kid=\"2-6-1-2-1-3\" data-name=\"testimonial author card\">\n                        <div class=\"w-16 h-16 bg-gray-200 sharp overflow-hidden\" data-kid=\"2-6-1-2-1-3-1\" data-name=\"author profile image container\">\n                            <img alt=\"Atul Alurkar\" data-kid=\"2-6-1-2-1-3-1-1\" data-name=\"author profile image\" src=\"https://i.pravatar.cc/100?u=atul\"/>\n                        </div>\n                        <div data-kid=\"2-6-1-2-1-3-2\" data-name=\"author details container\">\n                            <p class=\"text-lg font-black uppercase tracking-tighter\" data-kid=\"2-6-1-2-1-3-2-1\" data-name=\"author name\">\n                                Atul Alurkar\n                            </p>\n                            <p class=\"text-[10px] uppercase tracking-widest font-bold opacity-40\" data-kid=\"2-6-1-2-1-3-2-2\" data-name=\"author title\">\n                                CEO, Eilisys Technologies\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Final CTA Split -->\n    <section class=\"flex flex-col lg:flex-row border-y border-dark\" data-kid=\"2-7\" data-name=\"contact section\" id=\"contact\">\n        <div class=\"lg:w-1/2 bg-white p-24 lg:p-40 border-b lg:border-b-0 lg:border-r border-dark animate-reveal\" data-kid=\"2-7-1\" data-name=\"contact header block\">\n            <h2 class=\"text-7xl lg:text-9xl font-black tracking-tighter leading-[0.85] mb-12 font-serif italic\" data-kid=\"2-7-1-1\" data-name=\"contact headline\">\n                Bring us\n                <br data-kid=\"2-7-1-1-1\" data-name=\"contact headline line break\"/>\n                the brief.\n            </h2>\n            <p class=\"text-xl opacity-60 max-w-md mb-16 leading-relaxed\" data-kid=\"2-7-1-2\" data-name=\"contact sub-headline\">\n                Ready to make your business impossible to ignore? Let's discuss your product goals and start the discovery phase.\n            </p>\n            <div class=\"space-y-12\" data-kid=\"2-7-1-3\" data-name=\"contact methods list\">\n                <div class=\"group\" data-kid=\"2-7-1-3-1\" data-name=\"email inquiry group\">\n                    <p class=\"text-[10px] uppercase tracking-[0.4em] font-black opacity-30 mb-2\" data-kid=\"2-7-1-3-1-1\" data-name=\"email label\">\n                        Direct Inquiry\n                    </p>\n                    <a class=\"text-2xl lg:text-4xl font-serif underline decoration-orange decoration-2 underline-offset-12 group-hover:text-orange transition-all break-all\" data-kid=\"2-7-1-3-1-2\" data-name=\"email address link\" href=\"mailto:hello@ds-graphix.com\">\n                        hello@ds-graphix.com\n                    </a>\n                </div>\n                <div class=\"group\" data-kid=\"2-7-1-3-2\" data-name=\"whatsapp inquiry group\">\n                    <p class=\"text-[10px] uppercase tracking-[0.4em] font-black opacity-30 mb-2\" data-kid=\"2-7-1-3-2-1\" data-name=\"whatsapp label\">\n                        WhatsApp Instant\n                    </p>\n                    <a class=\"text-3xl lg:text-5xl font-serif underline decoration-orange decoration-2 underline-offset-12 group-hover:text-orange transition-all\" data-kid=\"2-7-1-3-2-2\" data-name=\"whatsapp number link\" href=\"#\">\n                        +91 98903 88405\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class=\"lg:w-1/2 bg-light-gray p-24 lg:p-40 flex flex-col justify-center animate-reveal\" data-kid=\"2-7-2\" data-name=\"contact form column\">\n            <form class=\"space-y-12\" data-kid=\"2-7-2-1\" data-name=\"contact form\">\n                <div class=\"relative\" data-kid=\"2-7-2-1-1\" data-name=\"name input wrapper\">\n                    <input class=\"w-full bg-transparent border-b border-dark/20 py-4 focus:border-orange outline-hidden text-2xl font-serif transition-colors placeholder:text-dark/20\" data-kid=\"2-7-2-1-1-1\" data-name=\"name input field\" placeholder=\"YOUR NAME\" type=\"text\"/>\n                </div>\n                <div class=\"relative\" data-kid=\"2-7-2-1-2\" data-name=\"email input wrapper\">\n                    <input class=\"w-full bg-transparent border-b border-dark/20 py-4 focus:border-orange outline-hidden text-2xl font-serif transition-colors placeholder:text-dark/20\" data-kid=\"2-7-2-1-2-1\" data-name=\"email input field\" placeholder=\"WORK EMAIL\" type=\"email\"/>\n                </div>\n                <div class=\"relative\" data-kid=\"2-7-2-1-3\" data-name=\"message input wrapper\">\n                    <textarea class=\"w-full bg-transparent border-b border-dark/20 py-4 focus:border-orange outline-hidden text-2xl font-serif transition-colors placeholder:text-dark/20 resize-none\" data-kid=\"2-7-2-1-3-1\" data-name=\"message text area\" placeholder=\"TELL US ABOUT THE PROJECT\" rows=\"4\"></textarea>\n                </div>\n                <button class=\"bg-orange text-white text-xs uppercase tracking-[0.4em] font-black px-16 py-8 sharp hover:bg-dark transition-all transform hover:-translate-y-2\" data-kid=\"2-7-2-1-4\" data-name=\"submit form button\" type=\"submit\">\n                    Submit Brief\n                </button>\n            </form>\n        </div>\n    </section>\n</main>\n<!-- Footer -->\n<footer class=\"bg-dark text-white pt-32 pb-16 px-6\" data-kid=\"3\" data-name=\"footer section\">\n    <div class=\"max-w-[1440px] mx-auto\" data-kid=\"3-1\" data-name=\"footer container\">\n        <div class=\"grid lg:grid-cols-12 gap-24 mb-32\" data-kid=\"3-1-1\" data-name=\"footer content grid\">\n            <div class=\"lg:col-span-5\" data-kid=\"3-1-1-1\" data-name=\"footer brand column\">\n                <div class=\"text-4xl font-black uppercase tracking-tighter font-serif mb-12\" data-kid=\"3-1-1-1-1\" data-name=\"footer brand name\">\n                    DS-Graphix\n                </div>\n                <p class=\"text-xl opacity-40 leading-relaxed max-w-sm mb-12\" data-kid=\"3-1-1-1-2\" data-name=\"footer description text\">\n                    A multi-disciplinary design lab building digital systems for the next generation of industry leaders.\n                </p>\n                <div class=\"flex gap-8 text-2xl\" data-kid=\"3-1-1-1-3\" data-name=\"social media links container\">\n                    <a class=\"hover:text-orange transition-colors\" data-kid=\"3-1-1-1-3-1\" data-name=\"linkedin link\" href=\"#\">\n                        <i class=\"ti ti-brand-linkedin\" data-kid=\"3-1-1-1-3-1-1\" data-name=\"linkedin icon\">\n                        </i>\n                    </a>\n                    <a class=\"hover:text-orange transition-colors\" data-kid=\"3-1-1-1-3-2\" data-name=\"instagram link\" href=\"#\">\n                        <i class=\"ti ti-brand-instagram\" data-kid=\"3-1-1-1-3-2-1\" data-name=\"instagram icon\">\n                        </i>\n                    </a>\n                    <a class=\"hover:text-orange transition-colors\" data-kid=\"3-1-1-1-3-3\" data-name=\"behance link\" href=\"#\">\n                        <i class=\"ti ti-brand-behance\" data-kid=\"3-1-1-1-3-3-1\" data-name=\"behance icon\">\n                        </i>\n                    </a>\n                    <a class=\"hover:text-orange transition-colors\" data-kid=\"3-1-1-1-3-4\" data-name=\"dribbble link\" href=\"#\">\n                        <i class=\"ti ti-brand-dribbble\" data-kid=\"3-1-1-1-3-4-1\" data-name=\"dribbble icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-16\" data-kid=\"3-1-1-2\" data-name=\"footer links grid\">\n                <div data-kid=\"3-1-1-2-1\" data-name=\"footer navigation column\">\n                    <h4 class=\"text-[10px] uppercase tracking-[0.5em] font-black opacity-30 mb-8\" data-kid=\"3-1-1-2-1-1\" data-name=\"navigation heading\">\n                        Navigation\n                    </h4>\n                    <ul class=\"space-y-4 text-sm font-bold uppercase tracking-widest\" data-kid=\"3-1-1-2-1-2\" data-name=\"navigation list\">\n                        <li data-kid=\"3-1-1-2-1-2-1\" data-name=\"work link wrapper\">\n                            <a class=\"hover:text-orange\" data-kid=\"3-1-1-2-1-2-1-1\" data-name=\"work link\" href=\"#work\">\n                                Work\n                            </a>\n                        </li>\n                        <li data-kid=\"3-1-1-2-1-2-2\" data-name=\"services link wrapper\">\n                            <a class=\"hover:text-orange\" data-kid=\"3-1-1-2-1-2-2-1\" data-name=\"services link\" href=\"#services\">\n                                Services\n                            </a>\n                        </li>\n                        <li data-kid=\"3-1-1-2-1-2-3\" data-name=\"process link wrapper\">\n                            <a class=\"hover:text-orange\" data-kid=\"3-1-1-2-1-2-3-1\" data-name=\"process link\" href=\"#process\">\n                                Process\n                            </a>\n                        </li>\n                        <li data-kid=\"3-1-1-2-1-2-4\" data-name=\"about link wrapper\">\n                            <a class=\"hover:text-orange\" data-kid=\"3-1-1-2-1-2-4-1\" data-name=\"about link\" href=\"#about\">\n                                About\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"3-1-1-2-2\" data-name=\"footer offices column\">\n                    <h4 class=\"text-[10px] uppercase tracking-[0.5em] font-black opacity-30 mb-8\" data-kid=\"3-1-1-2-2-1\" data-name=\"offices heading\">\n                        Offices\n                    </h4>\n                    <ul class=\"space-y-6 text-sm opacity-50\" data-kid=\"3-1-1-2-2-2\" data-name=\"offices list\">\n                        <li data-kid=\"3-1-1-2-2-2-1\" data-name=\"pune office item\">\n                            <span class=\"block font-black uppercase tracking-widest mb-1 text-white opacity-100\" data-kid=\"3-1-1-2-2-2-1-1\" data-name=\"pune office label\">\n                                Pune, IN\n                            </span>\n                            25, Baner Rd, Aundh,\n                            <br data-kid=\"3-1-1-2-2-2-1-2\" data-name=\"address line break\"/>\n                            Maharashtra 411007\n                        </li>\n                        <li data-kid=\"3-1-1-2-2-2-2\" data-name=\"los angeles office item\">\n                            <span class=\"block font-black uppercase tracking-widest mb-1 text-white opacity-100\" data-kid=\"3-1-1-2-2-2-2-1\" data-name=\"la office label\">\n                                Los Angeles, US\n                            </span>\n                            19851 Sienna Ln,\n                            <br data-kid=\"3-1-1-2-2-2-2-2\" data-name=\"address line break\"/>\n                            California 92886\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"3-1-1-2-3\" data-name=\"footer contact column\">\n                    <h4 class=\"text-[10px] uppercase tracking-[0.5em] font-black opacity-30 mb-8\" data-kid=\"3-1-1-2-3-1\" data-name=\"contact heading\">\n                        Contact\n                    </h4>\n                    <ul class=\"space-y-4 text-sm font-bold\" data-kid=\"3-1-1-2-3-2\" data-name=\"contact list\">\n                        <li data-kid=\"3-1-1-2-3-2-1\" data-name=\"contact email wrapper\">\n                            <a class=\"hover:text-orange\" data-kid=\"3-1-1-2-3-2-1-1\" data-name=\"contact email link\" href=\"mailto:hello@ds-graphix.com\">\n                                hello@ds-graphix.com\n                            </a>\n                        </li>\n                        <li data-kid=\"3-1-1-2-3-2-2\" data-name=\"contact phone wrapper\">\n                            <a class=\"hover:text-orange\" data-kid=\"3-1-1-2-3-2-2-1\" data-name=\"contact phone link\" href=\"tel:+919890388405\">\n                                +91 98903 88405\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class=\"pt-16 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-8 text-[10px] uppercase tracking-[0.5em] opacity-30 font-black\" data-kid=\"3-1-2\" data-name=\"footer bottom bar\">\n            <p data-kid=\"3-1-2-1\" data-name=\"copyright text\">\n                © 2026 DS-GRAPHIX CREATIVE AGENCY. ALL RIGHTS RESERVED.\n            </p>\n            <div class=\"flex gap-12\" data-kid=\"3-1-2-2\" data-name=\"footer policy links\">\n                <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"3-1-2-2-1\" data-name=\"privacy policy link\" href=\"#\">\n                    Privacy Policy\n                </a>\n                <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"3-1-2-2-2\" data-name=\"terms of service link\" href=\"#\">\n                    Terms of Service\n                </a>\n                <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"3-1-2-2-3\" data-name=\"cookie policy link\" href=\"#\">\n                    Cookie Policy\n                </a>\n            </div>\n        </div>\n    </div>\n</footer>\n<!-- Floating WhatsApp -->\n<a class=\"fixed bottom-10 right-10 z-50 bg-[#25D366] text-white w-16 h-16 flex items-center justify-center text-3xl sharp shadow-2xl hover:scale-110 transition-transform\" data-kid=\"4\" data-name=\"floating whatsapp button\" href=\"#\">\n    <i class=\"ti ti-brand-whatsapp\" data-kid=\"4-1\" data-name=\"whatsapp icon\">\n    </i>\n</a>\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\";\n  \n  // Initialize Lenis\n  const lenis = new Lenis();\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n  requestAnimationFrame(raf);\n\n  // GSAP Registration\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Entrance Animations\n  const reveals = document.querySelectorAll('.animate-reveal');\n  reveals.forEach((el) => {\n    gsap.from(el, {\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 95%\",\n        toggleActions: \"play none none none\"\n      },\n      y: 60,\n      opacity: 0,\n      duration: 1.2,\n      ease: \"power3.out\"\n    });\n  });\n\n  // Smooth hover for nav items (Micro-interactions)\n  const navItems = document.querySelectorAll('nav a');\n  navItems.forEach(item => {\n    item.addEventListener('mouseenter', () => {\n      gsap.to(item, { scale: 1.05, duration: 0.3, ease: \"power2.out\" });\n    });\n    item.addEventListener('mouseleave', () => {\n      gsap.to(item, { scale: 1, duration: 0.3, ease: \"power2.out\" });\n    });\n  });\n\n  // Parallax effects\n  const parallaxImages = document.querySelectorAll('[data-scroll]');\n  parallaxImages.forEach(img => {\n    const speed = img.getAttribute('data-scroll-speed');\n    gsap.to(img, {\n      scrollTrigger: {\n        trigger: img,\n        start: \"top bottom\",\n        end: \"bottom top\",\n        scrub: true\n      },\n      y: (index, target) => -100 * speed,\n      ease: \"none\"\n    });\n  });\n</script>\n",
