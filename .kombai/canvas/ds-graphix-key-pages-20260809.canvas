      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n    @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n    :root {\n        --color-orange: #FF6636;\n        --color-dark: #2A2A29;\n        --color-white: #FFFFFF;\n        --color-gray: #F2F4F8;\n    }\n\n    body {\n        font-family: 'DM Sans', sans-serif;\n        background-color: var(--color-white);\n        color: var(--color-dark);\n        margin: 0;\n        overflow-x: clip;\n    }\n\n    h1, h2, h3, .font-serif {\n        font-family: 'Fraunces', serif;\n    }\n\n    .no-scrollbar::-webkit-scrollbar {\n        display: none;\n    }\n    .no-scrollbar {\n        -ms-overflow-style: none;\n        scrollbar-width: none;\n    }\n\n    /* Custom underline hover */\n    .link-underline {\n        position: relative;\n    }\n    .link-underline::after {\n        content: '';\n        position: absolute;\n        width: 0;\n        height: 1px;\n        bottom: -4px;\n        left: 0;\n        background-color: currentColor;\n        transition: width 0.3s ease;\n    }\n    .link-underline:hover::after {\n        width: 100%;\n    }\n\n    .service-nav-item.active {\n        color: var(--color-dark);\n        border-color: var(--color-orange);\n    }\n</style>\n<div data-kid=\"1\" data-name=\"page scrolling container\" id=\"smooth-wrapper\">\n    <div data-kid=\"1-1\" data-name=\"page content wrapper\" id=\"smooth-content\">\n        <!-- Slim Header -->\n        <header class=\"fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-[#2A2A29]/5\" data-kid=\"1-1-1\" data-name=\"sticky site header\">\n            <div class=\"max-w-7xl mx-auto px-6 h-16 flex justify-between items-center\" data-kid=\"1-1-1-1\" data-name=\"header layout container\">\n                <a class=\"text-lg font-black tracking-tighter uppercase text-[#2A2A29]\" data-kid=\"1-1-1-1-1\" data-name=\"site brand name link\" href=\"#\">\n                    DS-Graphix\n                </a>\n                <nav class=\"hidden md:flex gap-10 text-xs font-bold uppercase tracking-[0.2em]\" data-kid=\"1-1-1-1-2\" data-name=\"main navigation menu\">\n                    <a class=\"link-underline\" data-kid=\"1-1-1-1-2-1\" data-name=\"navigation link Work\" href=\"#\">\n                        Work\n                    </a>\n                    <a class=\"text-[#FF6636]\" data-kid=\"1-1-1-1-2-2\" data-name=\"navigation link Services\" href=\"#\">\n                        Services\n                    </a>\n                    <a class=\"link-underline\" data-kid=\"1-1-1-1-2-3\" data-name=\"navigation link Process\" href=\"#\">\n                        Process\n                    </a>\n                    <a class=\"link-underline\" data-kid=\"1-1-1-1-2-4\" data-name=\"navigation link About\" href=\"#\">\n                        About\n                    </a>\n                </nav>\n                <div class=\"flex items-center gap-6\" data-kid=\"1-1-1-1-3\" data-name=\"header utility actions container\">\n                    <button class=\"text-[#2A2A29] hover:text-[#FF6636] transition-colors\" data-kid=\"1-1-1-1-3-1\" data-name=\"search button\">\n                        <i class=\"ti ti-search text-lg\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"search icon\">\n                        </i>\n                    </button>\n                    <a class=\"bg-[#2A2A29] text-white px-5 py-2 text-xs font-bold uppercase tracking-widest hover:bg-[#FF6636] transition-colors\" data-kid=\"1-1-1-1-3-2\" data-name=\"primary call-to-action button\" href=\"#\">\n                        Start Brief\n                    </a>\n                </div>\n            </div>\n        </header>\n        <!-- Page Intro / Hero -->\n        <section class=\"pt-48 pb-32 px-6 md:px-12 border-b border-[#2A2A29]/10\" data-kid=\"1-1-2\" data-name=\"hero section\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"1-1-2-1\" data-name=\"hero content wrapper\">\n                <div class=\"grid md:grid-cols-[1.2fr_0.8fr] gap-20 items-end\" data-kid=\"1-1-2-1-1\" data-name=\"hero layout grid\">\n                    <div class=\"hero-text\" data-kid=\"1-1-2-1-1-1\" data-name=\"hero text content block\">\n                        <h1 class=\"hero-reveal text-6xl lg:text-[110px] leading-[0.85] tracking-tight mb-12\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"hero headline text\">\n                            A full creative team,\n                            <br data-kid=\"1-1-2-1-1-1-1-1\"/>\n                            <span class=\"italic text-[#FF6636]\" data-kid=\"1-1-2-1-1-1-1-2\" data-name=\"hero headline italic highlight\">\n                                without the handoffs.\n                            </span>\n                        </h1>\n                        <div class=\"hero-reveal flex flex-col md:flex-row md:items-start gap-10\" data-kid=\"1-1-2-1-1-1-2\" data-name=\"hero description block\">\n                            <div class=\"w-20 h-px bg-[#2A2A29] mt-3.5 shrink-0\" data-kid=\"1-1-2-1-1-1-2-1\" data-name=\"decorative horizontal rule\">\n                            </div>\n                            <p class=\"text-lg md:text-xl text-[#2A2A29]/70 max-w-md leading-relaxed\" data-kid=\"1-1-2-1-1-1-2-2\" data-name=\"hero description text\">\n                                We eliminate friction by uniting strategy, design, and production under one editorial standard.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"hidden md:block relative aspect-[3/4] overflow-hidden hero-image-wrap\" data-kid=\"1-1-2-1-1-2\" data-name=\"hero image container\">\n                        <img alt=\"Abstract Architectural Detail by Anders Jildén\" class=\"w-full h-full object-cover grayscale\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"hero decorative image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1488972685288-c3fd157d7c7a?auto=format&w=800&q=80&fit=crop\"/>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Main Services Section -->\n        <section class=\"relative\" data-kid=\"1-1-3\" data-name=\"services overview section\" id=\"services-grid\">\n            <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row\" data-kid=\"1-1-3-1\" data-name=\"services grid container\">\n                <!-- Sticky Service Index -->\n                <aside class=\"w-full md:w-64 md:sticky md:top-16 md:h-[calc(100vh-64px)] z-40 bg-white\" data-kid=\"1-1-3-1-1\" data-name=\"sticky services sidebar\">\n                    <div class=\"p-6 md:py-24 border-b md:border-b-0 md:border-r border-[#2A2A29]/10 h-full overflow-x-auto no-scrollbar md:overflow-visible\" data-kid=\"1-1-3-1-1-1\" data-name=\"sidebar content wrapper\">\n                        <nav class=\"flex md:flex-col gap-8 md:gap-8 whitespace-nowrap\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"services navigation menu\">\n                            <a class=\"service-nav-item active text-xs font-bold uppercase tracking-widest text-[#2A2A29]/40 hover:text-[#2A2A29] border-b-2 md:border-b-0 md:border-l-2 pl-0 md:pl-4 transition-all duration-300\" data-kid=\"1-1-3-1-1-1-1-1\" data-name=\"navigation link UI/UX Design\" href=\"#uiux\">\n                                01. UI/UX Design\n                            </a>\n                            <a class=\"service-nav-item text-xs font-bold uppercase tracking-widest text-[#2A2A29]/40 hover:text-[#2A2A29] border-b-2 md:border-b-0 md:border-l-2 pl-0 md:pl-4 transition-all duration-300\" data-kid=\"1-1-3-1-1-1-1-2\" data-name=\"navigation link Brand Identity\" href=\"#branding\">\n                                02. Brand Identity\n                            </a>\n                            <a class=\"service-nav-item text-xs font-bold uppercase tracking-widest text-[#2A2A29]/40 hover:text-[#2A2A29] border-b-2 md:border-b-0 md:border-l-2 pl-0 md:pl-4 transition-all duration-300\" data-kid=\"1-1-3-1-1-1-1-3\" data-name=\"navigation link Graphic Design\" href=\"#graphic\">\n                                03. Graphic Design\n                            </a>\n                            <a class=\"service-nav-item text-xs font-bold uppercase tracking-widest text-[#2A2A29]/40 hover:text-[#2A2A29] border-b-2 md:border-b-0 md:border-l-2 pl-0 md:pl-4 transition-all duration-300\" data-kid=\"1-1-3-1-1-1-1-4\" data-name=\"navigation link Social Content\" href=\"#social\">\n                                04. Social Content\n                            </a>\n                            <a class=\"service-nav-item text-xs font-bold uppercase tracking-widest text-[#2A2A29]/40 hover:text-[#2A2A29] border-b-2 md:border-b-0 md:border-l-2 pl-0 md:pl-4 transition-all duration-300\" data-kid=\"1-1-3-1-1-1-1-5\" data-name=\"navigation link Video Reels\" href=\"#video\">\n                                05. Video Reels\n                            </a>\n                        </nav>\n                    </div>\n                </aside>\n                <!-- Reading Column -->\n                <main class=\"flex-1 overflow-x-clip\" data-kid=\"1-1-3-1-2\" data-name=\"main services content column\">\n                    <!-- 01. UI/UX -->\n                    <article class=\"service-block py-24 px-8 md:px-20 border-b border-[#2A2A29]/10\" data-kid=\"1-1-3-1-2-1\" data-name=\"UI/UX service block\" id=\"uiux\">\n                        <div class=\"grid md:grid-cols-2 gap-20 items-start\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"UI/UX content layout\">\n                            <div class=\"service-text\" data-kid=\"1-1-3-1-2-1-1-1\" data-name=\"UI/UX text details\">\n                                <span class=\"text-xs font-bold text-[#FF6636] uppercase tracking-[0.3em] block mb-6\" data-kid=\"1-1-3-1-2-1-1-1-1\" data-name=\"UI/UX category label\">\n                                    Digital Experience\n                                </span>\n                                <h2 class=\"text-4xl md:text-6xl font-serif mb-8 leading-tight\" data-kid=\"1-1-3-1-2-1-1-1-2\" data-name=\"UI/UX service title\">\n                                    UI/UX Design\n                                </h2>\n                                <p class=\"text-lg italic font-serif text-[#2A2A29]/80 mb-10 leading-relaxed border-l border-[#FF6636] pl-6\" data-kid=\"1-1-3-1-2-1-1-1-3\" data-name=\"UI/UX service quote\">\n                                    \"We transform complex workflows into frictionless digital assets that convert visitors into advocates.\"\n                                </p>\n                                <div class=\"grid grid-cols-2 gap-10 mb-12\" data-kid=\"1-1-3-1-2-1-1-1-4\" data-name=\"UI/UX spec grid\">\n                                    <div data-kid=\"1-1-3-1-2-1-1-1-4-1\" data-name=\"UI/UX deliverables group\">\n                                        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-4 opacity-40\" data-kid=\"1-1-3-1-2-1-1-1-4-1-1\" data-name=\"deliverables header\">\n                                            Deliverables\n                                        </h4>\n                                        <ul class=\"text-sm space-y-2 opacity-70\" data-kid=\"1-1-3-1-2-1-1-1-4-1-2\" data-name=\"deliverables list\">\n                                            <li data-kid=\"1-1-3-1-2-1-1-1-4-1-2-1\">\n                                                User Flow Maps\n                                            </li>\n                                            <li data-kid=\"1-1-3-1-2-1-1-1-4-1-2-2\">\n                                                High-Fi Prototypes\n                                            </li>\n                                            <li data-kid=\"1-1-3-1-2-1-1-1-4-1-2-3\">\n                                                Design Systems\n                                            </li>\n                                            <li data-kid=\"1-1-3-1-2-1-1-1-4-1-2-4\">\n                                                UX Audits\n                                            </li>\n                                        </ul>\n                                    </div>\n                                    <div data-kid=\"1-1-3-1-2-1-1-1-4-2\" data-name=\"UI/UX timeline group\">\n                                        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-4 opacity-40\" data-kid=\"1-1-3-1-2-1-1-1-4-2-1\" data-name=\"timeline header\">\n                                            Start Window\n                                        </h4>\n                                        <p class=\"text-sm opacity-70\" data-kid=\"1-1-3-1-2-1-1-1-4-2-2\" data-name=\"timeline text\">\n                                            Immediate (2 weeks)\n                                        </p>\n                                    </div>\n                                </div>\n                                <a class=\"group inline-flex items-center gap-3 text-xs font-bold uppercase tracking-widest text-[#2A2A29]\" data-kid=\"1-1-3-1-2-1-1-1-5\" data-name=\"UI/UX capability link\" href=\"#\">\n                                    View Capability\n                                    <span class=\"w-8 h-px bg-[#2A2A29] group-hover:w-16 transition-all duration-500\" data-kid=\"1-1-3-1-2-1-1-1-5-1\" data-name=\"capability link underline element\">\n                                    </span>\n                                </a>\n                            </div>\n                            <div class=\"service-image md:pt-12\" data-kid=\"1-1-3-1-2-1-1-2\" data-name=\"UI/UX service image wrapper\">\n                                <img alt=\"UI UX Design Work by Nick Adams\" class=\"w-full grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"1-1-3-1-2-1-1-2-1\" data-name=\"UI/UX service image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1516131206008-dd041a9764fd?auto=format&w=800&q=80&fit=crop\"/>\n                            </div>\n                        </div>\n                    </article>\n                    <!-- 02. Logo & Brand -->\n                    <article class=\"service-block py-24 px-8 md:px-20 border-b border-[#2A2A29]/10 bg-[#F2F4F8]/30\" data-kid=\"1-1-3-1-2-2\" data-name=\"branding service block\" id=\"branding\">\n                        <div class=\"grid md:grid-cols-2 gap-20 items-start\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"branding content layout\">\n                            <div class=\"md:order-2 service-text\" data-kid=\"1-1-3-1-2-2-1-1\" data-name=\"branding text details\">\n                                <span class=\"text-xs font-bold text-[#FF6636] uppercase tracking-[0.3em] block mb-6\" data-kid=\"1-1-3-1-2-2-1-1-1\" data-name=\"branding category label\">\n                                    Visual Identity\n                                </span>\n                                <h2 class=\"text-4xl md:text-6xl font-serif mb-8 leading-tight\" data-kid=\"1-1-3-1-2-2-1-1-2\" data-name=\"branding service title\">\n                                    Logo & Brand Identity\n                                </h2>\n                                <p class=\"text-lg italic font-serif text-[#2A2A29]/80 mb-10 leading-relaxed border-l border-[#FF6636] pl-6\" data-kid=\"1-1-3-1-2-2-1-1-3\" data-name=\"branding service quote\">\n                                    \"Crafting legacies, not just logos. We build visual languages that command authority and premium pricing.\"\n                                </p>\n                                <div class=\"grid grid-cols-2 gap-10 mb-12\" data-kid=\"1-1-3-1-2-2-1-1-4\" data-name=\"branding spec grid\">\n                                    <div data-kid=\"1-1-3-1-2-2-1-1-4-1\" data-name=\"branding deliverables group\">\n                                        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-4 opacity-40\" data-kid=\"1-1-3-1-2-2-1-1-4-1-1\" data-name=\"deliverables header\">\n                                            Deliverables\n                                        </h4>\n                                        <ul class=\"text-sm space-y-2 opacity-70\" data-kid=\"1-1-3-1-2-2-1-1-4-1-2\" data-name=\"deliverables list\">\n                                            <li data-kid=\"1-1-3-1-2-2-1-1-4-1-2-1\">\n                                                Dynamic Logo Suites\n                                            </li>\n                                            <li data-kid=\"1-1-3-1-2-2-1-1-4-1-2-2\">\n                                                Brand Guidelines\n                                            </li>\n                                            <li data-kid=\"1-1-3-1-2-2-1-1-4-1-2-3\">\n                                                Typography Sets\n                                            </li>\n                                            <li data-kid=\"1-1-3-1-2-2-1-1-4-1-2-4\">\n                                                Iconography\n                                            </li>\n                                        </ul>\n                                    </div>\n                                    <div data-kid=\"1-1-3-1-2-2-1-1-4-2\" data-name=\"branding timeline group\">\n                                        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-4 opacity-40\" data-kid=\"1-1-3-1-2-2-1-1-4-2-1\" data-name=\"timeline header\">\n                                            Start Window\n                                        </h4>\n                                        <p class=\"text-sm opacity-70\" data-kid=\"1-1-3-1-2-2-1-1-4-2-2\" data-name=\"timeline text\">\n                                            3-4 Weeks\n                                        </p>\n                                    </div>\n                                </div>\n                                <a class=\"group inline-flex items-center gap-3 text-xs font-bold uppercase tracking-widest text-[#2A2A29]\" data-kid=\"1-1-3-1-2-2-1-1-5\" data-name=\"branding capability link\" href=\"#\">\n                                    View Capability\n                                    <span class=\"w-8 h-px bg-[#2A2A29] group-hover:w-16 transition-all duration-500\" data-kid=\"1-1-3-1-2-2-1-1-5-1\" data-name=\"capability link underline element\">\n                                    </span>\n                                </a>\n                            </div>\n                            <div class=\"md:order-1 service-image md:pt-12\" data-kid=\"1-1-3-1-2-2-1-2\" data-name=\"branding service image wrapper\">\n                                <img alt=\"Editorial Mockup by Content Pixie\" class=\"w-full grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"1-1-3-1-2-2-1-2-1\" data-name=\"branding service image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1592966719124-2ca2978ba325?auto=format&w=800&q=80&fit=crop\"/>\n                            </div>\n                        </div>\n                    </article>\n                    <!-- 03. Graphic Design -->\n                    <article class=\"service-block py-24 px-8 md:px-20 border-b border-[#2A2A29]/10\" data-kid=\"1-1-3-1-2-3\" data-name=\"graphic design service block\" id=\"graphic\">\n                        <div class=\"grid md:grid-cols-2 gap-20 items-start\" data-kid=\"1-1-3-1-2-3-1\" data-name=\"graphic design content layout\">\n                            <div class=\"service-text\" data-kid=\"1-1-3-1-2-3-1-1\" data-name=\"graphic design text details\">\n                                <span class=\"text-xs font-bold text-[#FF6636] uppercase tracking-[0.3em] block mb-6\" data-kid=\"1-1-3-1-2-3-1-1-1\" data-name=\"graphic design category label\">\n                                    Marketing Collateral\n                                </span>\n                                <h2 class=\"text-4xl md:text-6xl font-serif mb-8 leading-tight\" data-kid=\"1-1-3-1-2-3-1-1-2\" data-name=\"graphic design service title\">\n                                    Graphic Design\n                                </h2>\n                                <p class=\"text-lg italic font-serif text-[#2A2A29]/80 mb-10 leading-relaxed border-l border-[#FF6636] pl-6\" data-kid=\"1-1-3-1-2-3-1-1-3\" data-name=\"graphic design service quote\">\n                                    \"From editorial layouts to high-conversion ads—visual communication that cuts through the noise.\"\n                                </p>\n                                <div class=\"grid grid-cols-2 gap-10 mb-12\" data-kid=\"1-1-3-1-2-3-1-1-4\" data-name=\"graphic design spec grid\">\n                                    <div data-kid=\"1-1-3-1-2-3-1-1-4-1\" data-name=\"graphic design deliverables group\">\n                                        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-4 opacity-40\" data-kid=\"1-1-3-1-2-3-1-1-4-1-1\" data-name=\"deliverables header\">\n                                            Deliverables\n                                        </h4>\n                                        <ul class=\"text-sm space-y-2 opacity-70\" data-kid=\"1-1-3-1-2-3-1-1-4-1-2\" data-name=\"deliverables list\">\n                                            <li data-kid=\"1-1-3-1-2-3-1-1-4-1-2-1\">\n                                                Print & Editorial\n                                            </li>\n                                            <li data-kid=\"1-1-3-1-2-3-1-1-4-1-2-2\">\n                                                Digital Ad Suites\n                                            </li>\n                                            <li data-kid=\"1-1-3-1-2-3-1-1-4-1-2-3\">\n                                                Packaging Design\n                                            </li>\n                                            <li data-kid=\"1-1-3-1-2-3-1-1-4-1-2-4\">\n                                                Pitch Decks\n                                            </li>\n                                        </ul>\n                                    </div>\n                                    <div data-kid=\"1-1-3-1-2-3-1-1-4-2\" data-name=\"graphic design timeline group\">\n                                        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-4 opacity-40\" data-kid=\"1-1-3-1-2-3-1-1-4-2-1\" data-name=\"timeline header\">\n                                            Start Window\n                                        </h4>\n                                        <p class=\"text-sm opacity-70\" data-kid=\"1-1-3-1-2-3-1-1-4-2-2\" data-name=\"timeline text\">\n                                            1-2 Weeks\n                                        </p>\n                                    </div>\n                                </div>\n                                <a class=\"group inline-flex items-center gap-3 text-xs font-bold uppercase tracking-widest text-[#2A2A29]\" data-kid=\"1-1-3-1-2-3-1-1-5\" data-name=\"graphic design capability link\" href=\"#\">\n                                    View Capability\n                                    <span class=\"w-8 h-px bg-[#2A2A29] group-hover:w-16 transition-all duration-500\" data-kid=\"1-1-3-1-2-3-1-1-5-1\" data-name=\"capability link underline element\">\n                                    </span>\n                                </a>\n                            </div>\n                            <div class=\"service-image md:pt-12\" data-kid=\"1-1-3-1-2-3-1-2\" data-name=\"graphic design service image wrapper\">\n              