\"#\">\n                    Behance\n                </a>\n            </div>\n            <div class=\"flex items-center gap-2 text-[10px] font-bold text-black/30 uppercase\" data-kid=\"3-1-3\" data-name=\"system status container\">\n                <span data-kid=\"3-1-3-1\" data-name=\"status label\">\n                    System Status\n                </span>\n                <div class=\"w-1.5 h-1.5 rounded-full bg-green-500\" data-kid=\"3-1-3-2\" data-name=\"status indicator\">\n                </div>\n                <span data-kid=\"3-1-3-3\" data-name=\"status text\">\n                    All Nodes Operational\n                </span>\n            </div>\n        </div>\n    </footer>\n    <!-- WhatsApp Speed Dial (Pattern: #fab-speed-dial) -->\n    <div class=\"fixed bottom-8 right-8 flex flex-col items-end gap-3 z-50\" data-kid=\"4\" data-name=\"speed dial button group\">\n        <!-- Speed Dial Items -->\n        <div class=\"hidden flex flex-col items-end gap-3 mb-2\" data-dynamic=\"true\" data-kid=\"4-1\" data-name=\"speed dial items container\" data-reason=\"visibility toggled by script\" id=\"fab-menu\">\n            <div class=\"fab-group flex items-center gap-3\" data-kid=\"4-1-1\" data-name=\"schedule discovery item group\">\n                <span class=\"fab-label bg-[#2A2A29] text-white text-[10px] font-bold px-3 py-1.5 rounded-lg shadow-sm whitespace-nowrap\" data-kid=\"4-1-1-1\" data-name=\"fab label text\">\n                    Schedule Discovery\n                </span>\n                <button class=\"w-10 h-10 bg-white border border-black/5 rounded-full shadow-lg flex items-center justify-center text-[#2A2A29] hover:bg-[#FF6636] hover:text-white transition-all cursor-pointer\" data-kid=\"4-1-1-2\" data-name=\"schedule icon button\">\n                    <svg class=\"w-4 h-4\" data-kid=\"4-1-1-2-1\" data-name=\"calendar icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                        </path>\n                    </svg>\n                </button>\n            </div>\n            <div class=\"fab-group flex items-center gap-3\" data-kid=\"4-1-2\" data-name=\"whatsapp item group\">\n                <span class=\"fab-label bg-[#2A2A29] text-white text-[10px] font-bold px-3 py-1.5 rounded-lg shadow-sm whitespace-nowrap\" data-kid=\"4-1-2-1\" data-name=\"whatsapp label text\">\n                    Quick WhatsApp\n                </span>\n                <button class=\"w-10 h-10 bg-white border border-black/5 rounded-full shadow-lg flex items-center justify-center text-[#25D366] hover:bg-[#25D366] hover:text-white transition-all cursor-pointer\" data-kid=\"4-1-2-2\" data-name=\"whatsapp icon button\">\n                    <svg class=\"w-4 h-4\" data-kid=\"4-1-2-2-1\" data-name=\"whatsapp icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.07-.947.07-.478 0-.915-.145-1.423-.347-1.196-.475-2.015-1.579-2.585-2.457-.156-.24-.469-.884-.469-1.503s.32-.916.434-1.033c.114-.117.25-.175.335-.175.085 0 .17.001.243.005.074.003.174-.029.273.208.1.242.342.833.372.89.03.058.05.125.012.2-.038.075-.057.125-.113.192-.056.067-.119.149-.17.2-.057.058-.117.121-.05.237.067.116.297.49.638.793.438.39 1.043.614 1.176.68.134.067.21.05.289-.04.08-.09.34-.396.43-.531.09-.135.181-.112.304-.067.123.045.779.368.914.435.135.067.225.1.259.158.034.058.034.336-.11.741z\">\n                        </path>\n                    </svg>\n                </button>\n            </div>\n        </div>\n        <!-- Main FAB -->\n        <button class=\"w-14 h-14 bg-[#25D366] text-white rounded-full shadow-2xl flex items-center justify-center hover:scale-105 transition-transform cursor-pointer group z-10\" data-kid=\"4-2\" data-name=\"speed dial main trigger button\" id=\"fab-trigger\">\n            <svg class=\"w-7 h-7 transition-transform duration-300\" data-kid=\"4-2-1\" data-name=\"plus icon\" fill=\"none\" id=\"fab-icon-plus\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                <path d=\"M12 6v6m0 0v6m0-6h6m-6 0H6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\">\n                </path>\n            </svg>\n            <svg class=\"hidden w-7 h-7\" data-kid=\"4-2-2\" data-name=\"whatsapp icon\" fill=\"currentColor\" id=\"fab-icon-wa\" viewbox=\"0 0 24 24\">\n                <path d=\"M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.07-.947.07-.478 0-.915-.145-1.423-.347-1.196-.475-2.015-1.579-2.585-2.457-.156-.24-.469-.884-.469-1.503s.32-.916.434-1.033c.114-.117.25-.175.335-.175.085 0 .17.001.243.005.074.003.174-.029.273.208.1.242.342.833.372.89.03.058.05.125.012.2-.038.075-.057.125-.113.192-.056.067-.119.149-.17.2-.057.058-.117.121-.05.237.067.116.297.49.638.793.438.39 1.043.614 1.176.68.134.067.21.05.289-.04.08-.09.34-.396.43-.531.09-.135.181-.112.304-.067.123.045.779.368.914.435.135.067.225.1.259.158.034.058.034.336-.11.741z\">\n                </path>\n            </svg>\n        </button>\n    </div>\n    <!-- GSAP & Interaction Script -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            let currentStep = 1;\n            const totalSteps = 3;\n\n            const nextBtn = document.getElementById('next-btn');\n            const prevBtn = document.getElementById('prev-btn');\n            const steps = document.querySelectorAll('.step-content');\n            const indicators = document.querySelectorAll('.step-indicator');\n\n            function updateWizard() {\n                steps.forEach((step, i) => {\n                    if (i + 1 === currentStep) {\n                        gsap.set(step, { display: 'block', opacity: 0, x: 20 });\n                        gsap.to(step, { opacity: 1, x: 0, duration: 0.4, ease: 'power2.out' });\n                    } else {\n                        gsap.set(step, { display: 'none' });\n                    }\n                });\n\n                indicators.forEach((ind, i) => {\n                    const stepNum = i + 1;\n                    if (stepNum === currentStep) {\n                        ind.classList.remove('opacity-30');\n                        ind.querySelector('div').classList.replace('bg-black/10', 'bg-[#FF6636]');\n                        ind.querySelector('div').classList.replace('text-[#2A2A29]', 'text-white');\n                    } else if (stepNum < currentStep) {\n                        ind.classList.remove('opacity-30');\n                        ind.querySelector('div').classList.replace('bg-[#FF6636]', 'bg-[#2A2A29]');\n                        ind.querySelector('div').classList.replace('bg-black/10', 'bg-[#2A2A29]');\n                        ind.querySelector('div').classList.add('text-white');\n                    } else {\n                        ind.classList.add('opacity-30');\n                        ind.querySelector('div').className = 'w-7 h-7 rounded-full bg-black/10 text-[#2A2A29] flex items-center justify-center text-[10px] font-bold';\n                    }\n                });\n\n                prevBtn.classList.toggle('hidden', currentStep === 1);\n                nextBtn.innerText = currentStep === totalSteps ? 'Send Project Brief' : 'Next Step';\n            }\n\n            nextBtn.addEventListener('click', () => {\n                if (currentStep < totalSteps) {\n                    currentStep++;\n                    updateWizard();\n                } else {\n                    // Final Submit Action\n                    nextBtn.innerText = 'Transmitting...';\n                    gsap.to(nextBtn, { scale: 0.95, duration: 0.1 });\n                    setTimeout(() => alert('Brief sent to Dhananjay! We will reply within 4 hours.'), 1000);\n                }\n            });\n\n            prevBtn.addEventListener('click', () => {\n                if (currentStep > 1) {\n                    currentStep--;\n                    updateWizard();\n                }\n            });\n\n            // Project Type Select\n            document.querySelectorAll('.project-type-btn').forEach(btn => {\n                btn.addEventListener('click', () => {\n                    document.querySelectorAll('.project-type-btn').forEach(b => {\n                        b.classList.remove('border-[#FF6636]', 'shadow-sm');\n                        b.classList.add('border-black/5');\n                        b.querySelector('div').classList.remove('border-[#FF6636]/30');\n                        b.querySelector('svg').classList.remove('text-[#FF6636]');\n                    });\n                    btn.classList.add('border-[#FF6636]', 'shadow-sm');\n                    btn.classList.remove('border-black/5');\n                    btn.querySelector('div').classList.add('border-[#FF6636]/30');\n                    btn.querySelector('svg').classList.add('text-[#FF6636]');\n                });\n            });\n\n            // Budget Slider\n            const range = document.querySelector('input[type=\"range\"]');\n            range.addEventListener('input', (e) => {\n                const val = parseInt(e.target.value);\n                const display = document.getElementById('budget-value');\n                if (val < 5000) display.innerText = `$${val.toLocaleString()} — $${(val+2000).toLocaleString()}`;\n                else if (val < 20000) display.innerText = `$${val.toLocaleString()} — $${(val+5000).toLocaleString()}`;\n                else if (val >= 50000) display.innerText = `$50,000+ (Custom Strategic)`;\n                else display.innerText = `$${val.toLocaleString()} — $${(val+10000).toLocaleString()}`;\n            });\n\n            // FAB Toggle\n            const fabTrigger = document.getElementById('fab-trigger');\n            const fabMenu = document.getElementById('fab-menu');\n            const fabIconPlus = document.getElementById('fab-icon-plus');\n            let fabOpen = false;\n\n            fabTrigger.addEventListener('click', () => {\n                fabOpen = !fabOpen;\n                if (fabOpen) {\n                    fabMenu.classList.remove('hidden');\n                    gsap.from('#fab-menu .fab-group', { y: 20, opacity: 0, stagger: 0.1, duration: 0.3, ease: 'back.out(2)' });\n                    gsap.to(fabIconPlus, { rotate: 45, duration: 0.3 });\n                } else {\n                    gsap.to('#fab-menu .fab-group', { y: 20, opacity: 0, stagger: -0.1, duration: 0.2, onComplete: () => fabMenu.classList.add('hidden') });\n                    gsap.to(fabIconPlus, { rotate: 0, duration: 0.3 });\n                }\n            });\n\n            // Initial animations\n            gsap.from('header', { y: -80, opacity: 0, duration: 1, ease: 'expo.out' });\n            gsap.from('h1', { y: 60, opacity: 0, duration: 1, delay: 0.2, ease: 'expo.out' });\n            gsap.from('#quote-wizard', { y: 40, opacity: 0, duration: 1, delay: 0.4, ease: 'expo.out' });\n            gsap.from('.sidebar-item', { y: 40, opacity: 0, stagger: 0.1, duration: 1, delay: 0.6, ease: 'expo.out' });\n            // Animate hero sidebar boxes\n            gsap.from('.lg\\\\:col-span-4 > div', { scale: 0.9, opacity: 0, stagger: 0.2, duration: 1, delay: 0.3, ease: 'expo.out' });\n        });\n    </script>\n</body>\n",
      "comments": [],
      "created": "2026-08-09T11:39:40.210304+00:00",
      "modified": "2026-08-09T11:39:40.210304+00:00",
      "id": "var_f79a4ddf2f6e"
    },
    "var_01aeee9a52c2": {
      "type": "variant",
      "label": "Systems-Led — Process",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 17940,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"bg-[#F2F4F8] text-[#2A2A29] font-['Plus_Jakarta_Sans',sans-serif] min-h-screen selection:bg-[#FF6636]/30\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Navbar -->\n    <nav class=\"sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-[#2A2A29]/5 px-6 py-4\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"navigation content wrapper\">\n            <div class=\"flex items-center gap-8\" data-kid=\"1-1-1-1\" data-name=\"branding and link container\">\n                <a class=\"text-xl font-extrabold tracking-tighter text-[#2A2A29]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo text link\" href=\"#\">\n                    DS\n                    <span class=\"text-[#FF6636]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo dot\">\n                        .\n                    </span>\n                    GRAPHIX\n                </a>\n                <div class=\"hidden lg:flex items-center gap-6 text-[13px] font-semibold text-[#2A2A29]/60\" data-kid=\"1-1-1-1-2\" data-name=\"navigation link group\">\n                    <a class=\"hover:text-[#2A2A29] transition-colors\" data-kid=\"1-1-1-1-2-1\" data-name=\"home link\" href=\"#\">\n                        Home\n                    </a>\n                    <a class=\"hover:text-[#2A2A29] transition-colors\" data-kid=\"1-1-1-1-2-2\" data-name=\"services link\" href=\"#\">\n                        Services\n                    </a>\n                    <a class=\"hover:text-[#2A2A29] transition-colors\" data-kid=\"1-1-1-1-2-3\" data-name=\"work link\" href=\"#\">\n                        Work\n                    </a>\n                    <a class=\"text-[#2A2A29] border-b-2 border-[#FF6636] pb-1\" data-kid=\"1-1-1-1-2-4\" data-name=\"our process link\" href=\"#\">\n                        Our Process\n                    </a>\n                    <a class=\"hover:text-[#2A2A29] transition-colors\" data-kid=\"1-1-1-1-2-5\" data-name=\"about link\" href=\"#\">\n                        About\n                    </a>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-2\" data-name=\"utility link and search container\">\n                <div class=\"hidden md:flex items-center bg-[#F2F4F8] px-3 py-2 rounded-lg border border-[#2A2A29]/5\" data-kid=\"1-1-1-2-1\" data-name=\"search input container\">\n                    <i class=\"ri-search-line text-[#2A2A29]/40 text-sm\" data-kid=\"1-1-1-2-1-1\" data-name=\"search icon\">\n                    </i>\n                    <input class=\"bg-transparent border-none outline-hidden text-xs px-2 w-32 focus:w-48 transition-all\" data-kid=\"1-1-1-2-1-2\" data-name=\"search input field\" placeholder=\"Search insights...\" type=\"text\"/>\n                </div>\n                <a class=\"bg-[#FF6636] text-white px-5 py-2.5 rounded-lg text-xs font-bold hover:bg-[#FF6636]/90 transition-all shadow-sm\" data-kid=\"1-1-1-2-2\" data-name=\"consultation call-to-action button\" href=\"#\">\n                    Book a Consultation\n                </a>\n            </div>\n        </div>\n    </nav>\n    <!-- Hero Section -->\n    <header class=\"pt-24 pb-20 px-6 bg-white overflow-hidden\" data-kid=\"1-2\" data-name=\"hero section\">\n        <div class=\"max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center\" data-kid=\"1-2-1\" data-name=\"hero content grid\">\n            <div class=\"fade-up\" data-kid=\"1-2-1-1\" data-name=\"hero text content block\">\n                <span class=\"text-[11px] font-bold tracking-[0.3em] text-[#FF6636] uppercase mb-8 block\" data-kid=\"1-2-1-1-1\" data-name=\"hero subheadline label\">\n                    Architecture of Delivery\n                </span>\n                <h1 class=\"text-6xl md:text-8xl font-extrabold leading-[0.95] text-[#2A2A29] mb-8 tracking-tighter\" data-kid=\"1-2-1-1-2\" data-name=\"hero main headline\">\n                    A delivery system\n                    <br data-kid=\"1-2-1-1-2-1\" data-name=\"headline line break\"/>\n                    clients can trust.\n                </h1>\n                <p class=\"text-xl text-[#2A2A29]/60 max-w-lg mb-12 leading-relaxed font-medium\" data-kid=\"1-2-1-1-3\" data-name=\"hero description paragraph\">\n                    Precision over guesswork. We deploy a repeatable framework that ensures every pixel and frame is delivered with predictable velocity.\n                </p>\n                <div class=\"flex flex-wrap gap-4\" data-kid=\"1-2-1-1-4\" data-name=\"hero feature badge container\">\n                    <div class=\"bg-[#F2F4F8] px-5 py-3 rounded-md border border-[#2A2A29]/10 flex items-center gap-3\" data-kid=\"1-2-1-1-4-1\" data-name=\"velocity feature badge\">\n                        <i class=\"ri-timer-flash-line text-[#FF6636]\" data-kid=\"1-2-1-1-4-1-1\" data-name=\"velocity icon\">\n                        </i>\n                        <span class=\"text-[12px] font-bold text-[#2A2A29] uppercase tracking-wide\" data-kid=\"1-2-1-1-4-1-2\" data-name=\"velocity text\">\n                            High Velocity Output\n                        </span>\n                    </div>\n                    <div class=\"bg-[#F2F4F8] px-5 py-3 rounded-md border border-[#2A2A29]/10 flex items-center gap-3\" data-kid=\"1-2-1-1-4-2\" data-name=\"frictionless feature badge\">\n                        <i class=\"ri-code-s-slash-line text-[#2A2A29]/60\" data-kid=\"1-2-1-1-4-2-1\" data-name=\"code icon\">\n                        </i>\n                        <span class=\"text-[12px] font-bold text-[#2A2A29] uppercase tracking-wide\" data-kid=\"1-2-1-1-4-2-2\" data-name=\"frictionless text\">\n                            Zero Friction Handoff\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"hidden lg:grid grid-cols-2 gap-4 fade-up\" data-kid=\"1-2-1-2\" data-name=\"hero metrics grid\">\n                <div class=\"col-span-2 bg-[#F2F4F8] border border-[#2A2A29]/5 p-8 rounded-xl\" data-kid=\"1-2-1-2-1\" data-name=\"sprint progress card\">\n                    <div class=\"flex justify-between items-center mb-6\" data-kid=\"1-2-1-2-1-1\" data-name=\"progress card header\">\n                        <span class=\"text-[10px] font-bold text-[#2A2A29]/40 uppercase tracking-widest\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"progress card label\">\n                            Logic Flow: Sprint A\n                        </span>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"status indicator group\">\n                            <span class=\"w-2 h-2 rounded-full bg-[#FF6636]\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"status active dot\">\n                            </span>\n                            <span class=\"w-2 h-2 rounded-full bg-[#2A2A29]/10\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"status inactive dot\">\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-2-1-2\" data-name=\"progress bar area\">\n                        <div class=\"w-full h-1 bg-[#2A2A29]/5 rounded-full overflow-hidden\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"progress track\">\n                            <div class=\"h-full bg-[#FF6636] w-[75%]\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"progress fill bar\">\n                            </div>\n                        </div>\n                        <span class=\"text-xs font-bold text-[#2A2A29]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"progress percentage text\">\n                            75%\n                        </span>\n                    </div>\n                </div>\n                <div class=\"bg-white border border-[#2A2A29]/10 p-6 rounded-xl shadow-sm\" data-kid=\"1-2-1-2-2\" data-name=\"system uptime metric card\">\n                    <span class=\"text-[9px] font-bold text-[#FF6636] uppercase block mb-2\" data-kid=\"1-2-1-2-2-1\" data-name=\"uptime label\">\n                        Integrity\n                    </span>\n                    <span class=\"text-2xl font-extrabold text-[#2A2A29]\" data-kid=\"1-2-1-2-2-2\" data-name=\"uptime percentage value\">\n                        99.8%\n                    </span>\n                    <p class=\"text-[10px] text-[#2A2A29]/40 uppercase mt-1\" data-kid=\"1-2-1-2-2-3\" data-name=\"uptime subtext\">\n                        System Uptime\n                    </p>\n                </div>\n                <div class=\"bg-[#2A2A29] p-6 rounded-xl shadow-lg\" data-kid=\"1-2-1-2-3\" data-name=\"active tasks metric card\">\n                    <span class=\"text-[9px] font-bold text-white/50 uppercase block mb-2\" data-kid=\"1-2-1-2-3-1\" data-name=\"tasks label\">\n                        Active Tasks\n                    </span>\n                    <span class=\"text-2xl font-extrabold text-white\" data-kid=\"1-2-1-2-3-2\" data-name=\"tasks count value\">\n                        12\n                    </span>\n                    <p class=\"text-[10px] text-white/30 uppercase mt-1\" data-kid=\"1-2-1-2-3-3\" data-name=\"tasks subtext\">\n                        In Pipeline\n                    </p>\n                </div>\n            </div>\n        </div>\n    </header>\n    <!-- Gantt Chart Section -->\n    <section class=\"py-24 px-6 relative z-10\" data-kid=\"1-3\" data-name=\"workflow section\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-3-1\" data-name=\"workflow content container\">\n            <div class=\"flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6\" data-kid=\"1-3-1-1\" data-name=\"workflow header block\">\n                <div class=\"fade-up\" data-kid=\"1-3-1-1-1\" data-name=\"workflow title and description\">\n                    <h2 class=\"text-3xl font-extrabold text-[#2A2A29] mb-4\" data-kid=\"1-3-1-1-1-1\" data-name=\"workflow main title\">\n                        Sprint Workflow: Week 01\n                    </h2>\n                    <p class=\"text-[#2A2A29]/50 text-sm max-w-md\" data-kid=\"1-3-1-1-1-2\" data-name=\"workflow description\">\n                        Our process follows a rigorous 4-phase cycle across a standard grid axis to maintain absolute clarity on deliverables.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-3 fade-up\" data-kid=\"1-3-1-1-2\" data-name=\"view toggle button group\">\n                    <span class=\"text-[10px] font-bold text-[#2A2A29]/40 uppercase\" data-kid=\"1-3-1-1-2-1\" data-name=\"view mode label\">\n                        View:\n                    </span>\n                    <button class=\"px-3 py-1.5 bg-[#2A2A29] text-white text-[10px] font-bold rounded-md\" data-kid=\"1-3-1-1-2-2\" data-name=\"timeline view button\">\n                        Timeline\n                    </button>\n                    <button class=\"px-3 py-1.5 bg-white text-[#2A2A29]/50 text-[10px] font-bold rounded-md border border-[#2A2A29]/5\" data-kid=\"1-3-1-1-2-3\" data-name=\"matrix view button\">\n                        Matrix\n                    </button>\n                </div>\n            </div>\n            <!-- Desktop Timeline Grid -->\n            <div class=\"hidden lg:block bg-white rounded-lg border border-[#2A2A29]/10 shadow-[0_4px_24px_rgba(0,0,0,0.03)] overflow-x-clip\" data-kid=\"1-3-1-2\" data-name=\"desktop timeline grid\">\n                <!-- Day Header -->\n                <div class=\"grid grid-cols-[200px_repeat(7,1fr)] border-b border-[#2A2A29]/10 bg-[#F2F4F8]/30\" data-kid=\"1-3-1-2-1\" data-name=\"timeline day header\">\n                    <div class=\"p-4 text-[11px] font-bold text-[#2A2A29]/40 uppercase tracking-[0.2em] border-r border-[#2A2A29]/10\" data-kid=\"1-3-1-2-1-1\" data-name=\"header label column\">\n                        Process Phase\n                    </div>\n                    <div class=\"p-4 text-center text-[11px] font-bold text-[#2A2A29]/60 uppercase tracking-widest\" data-kid=\"1-3-1-2-1-2\" data-name=\"day 01 header\">\n                        Day 01\n                    </div>\n                    <div class=\"p-4 text-center text-[11px] font-bold text-[#2A2A29]/60 uppercase tracking-widest\" data-kid=\"1-3-1-2-1-3\" data-name=\"day 02 header\">\n                        Day 02\n                    </div>\n                    <div class=\"p-4 text-center text-[11px] font-bold text-[#2A2A29]/60 uppercase tracking-widest\" data-kid=\"1-3-1-2-1-4\" data-name=\"day 03 header\">\n                        Day 03\n                    </div>\n                    <div class=\"p-4 text-center text-[11px] font-bold text-[#2A2A29]/60 uppercase tracking-widest\" data-kid=\"1-3-1-2-1-5\" data-name=\"day 04 header\">\n                        Day 04\n                    </div>\n                    <div class=\"p-4 text-center text-[11px] font-bold text-[#2A2A29]/60 uppercase tracking-widest\" data-kid=\"1-3-1-2-1-6\" data-name=\"day 05 header\">\n                        Day 05\n                    </div>\n                    <div class=\"p-4 text-center text-[11px] font-bold text-[#2A2A29]/60 uppercase tracking-widest bg-[#FF6636]/5\" data-kid=\"1-3-1-2-1-7\" data-name=\"review day header\">\n                        Review\n                    </div>\n                    <div class=\"p-4 text-center text-[11px] font-bold text-[#2A2A29]/60 uppercase tracking-widest bg-[#FF6636]/5\" data-kid=\"1-3-1-2-1-8\" data-name=\"launch day header\">\n                        Launch\n                    </div>\n                </div>\n                <!-- Phase: Align -->\n                <div class=\"grid grid-cols-[200px_repeat(7,1fr)] border-b border-[#2A2A29]/10 relative group min-h-[80px]\" data-kid=\"1-3-1-2-2\" data-name=\"align phase row\">\n                    <div class=\"p-4 border-r border-[#2A2A29]/10 flex flex-col justify-center bg-[#F2F4F8]/10\" data-kid=\"1-3-1-2-2-1\" data-name=\"align phase label box\">\n                        <span class=\"text-lg font-extrabold text-[#2A2A29]\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"align title\">\n                            01. Align\n                        </span>\n                        <span class=\"text-[10px] text-[#2A2A29]/40 uppercase font-bold tracking-tighter\" data-kid=\"1-3-1-2-2-1-2\" data-name=\"align sublabel\">\n                            Audit & Setup\n                        </span>\n                    </div>\n                    <div class=\"col-span-7 p-4 flex items-center relative\" data-kid=\"1-3-1-2-2-2\" data-name=\"align phase timeline area\">\n                        <!-- Bar -->\n                        <div class=\"gantt-bar h-10 bg-[#FF6636] rounded-sm w-[25%] absolute left-6 flex items-center px-4 shadow-sm hover:bg-[#FF6636]/90 cursor-pointer\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"align timeline bar\">\n                            <span class=\"text-[10px] text-white font-bold uppercase truncate\" data-kid=\"1-3-1-2-2-2-1-1\" data-name=\"align bar label\">\n                                Systems Audit & Discovery\n                            </span>\n                        </div>\n                        <!-- Milestone -->\n                        <div class=\"absolute left-[33%] flex flex-col items-center\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"align milestone\">\n                            <div class=\"w-3 h-3 rounded-full bg-[#2A2A29] border-2 border-white shadow-sm mb-1\" data-kid=\"1-3-1-2-2-2-2-1\" data-name=\"align milestone dot\">\n                            </div>\n                            <span class=\"text-[10px] font-bold text-[#2A2A29]/60 uppercase tracking-tighter\" data-kid=\"1-3-1-2-2-2-2-2\" data-name=\"align milestone label\">\n                                Brief Approval\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Phase: Explore -->\n                <div class=\"grid grid-cols-[200px_repeat(7,1fr)] border-b border-[#2A2A29]/10 relative min-h-[80px]\" data-kid=\"1-3-1-2-3\" data-name=\"explore phase row\">\n                    <div class=\"p-4 border-r border-[#2A2A29]/10 flex flex-col justify-center bg-[#F2F4F8]/10\" data-kid=\"1-3-1-2-3-1\" data-name=\"explore phase label box\">\n                        <span class=\"text-lg font-extrabold text-[#2A2A29]\" data-kid=\"1-3-1-2-3-1-1\" data-name=\"explore title\">\n                            02. Explore\n                        </span>\n                        <span class=\"text-[10px] text-[#2A2A29]/40 uppercase font-bold tracking-tighter\" data-kid=\"1-3-1-2-3-1-2\" data-name=\"explore sublabel\">\n                            Strategy & UX\n                        </span>\n                    </div>\n                    <div class=\"col-span-7 p-4 flex items-center relative\" data-kid=\"1-3-1-2-3-2\" data-name=\"explore phase timeline area\">\n                        <div class=\"gantt-bar h-10 bg-[#FF6636]/10 border border-[#FF6636]/30 rounded-sm w-[40%] absolute left-[22%] flex items-center px-4 hover:bg-[#FF6636]/20 cursor-pointer\" data-kid=\"1-3-1-2-3-2-1\" data-name=\"explore timeline bar\">\n                            <span class=\"text-[10px] text-[#FF6636] font-bold uppercase truncate\" data-kid=\"1-3-1-2-3-2-1-1\" data-name=\"explore bar label\">\n                                Architecture & Prototyping\n                            </span>\n                        </div>\n                        <div class=\"absolute left-[65%] flex flex-col items-center\" data-kid=\"1-3-1-2-3-2-2\" data-name=\"explore milestone\">\n                            <div class=\"w-3 h-3 rounded-full bg-[#2A2A29] border-2 border-white shadow-sm mb-1\" data-kid=\"1-3-1-2-3-2-2-1\" data-name=\"explore milestone dot\">\n                            </div>\n                            <span class=\"text-[10px] font-bold text-[#2A2A29]/60 uppercase tracking-tighter\" data-kid=\"1-3-1-2-3-2-2-2\" data-name=\"explore milestone label\">\n                                User Logic Check\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Phase: Build -->\n                <div class=\"grid grid-cols-[200px_repeat(7,1fr)] border-b border-[#2A2A29]/10 relative min-h-[80px]\" data-kid=\"1-3-1-2-4\" data-name=\"build phase row\">\n                    <div class=\"p-4 border-r border-[#2A2A29]/10 flex flex-col justify-center bg-[#F2F4F8]/10\" data-kid=\"1-3-1-2-4-1\" data-name=\"build phase label box\">\n                        <span class=\"text-lg font-extrabold text-[#2A2A29]\" data-kid=\"1-3-1-2-4-1-1\" data-name=\"build title\">\n                            03. Build\n                        </span>\n                        <span class=\"text-[10px] text-[#2A2A29]/40 uppercase font-bold tracking-tighter\" data-kid=\"1-3-1-2-4-1-2\" data-name=\"build sublabel\">\n                            Design & System\n                        </span>\n                    </div>\n                    <div class=\"col-span-7 p-4 flex items-center relative\" data-kid=\"1-3-1-2-4-2\" data-name=\"build phase timeline area\">\n                        <div class=\"gantt-bar h-10 bg-[#FF6636] rounded-sm w-[40%] absolute left-[50%] flex items-center px-4 shadow-sm hover:bg-[#FF6636]/90 cursor-pointer\" data-kid=\"1-3-1-2-4-2-1\" data-name=\"build timeline bar\">\n                            <span class=\"text-[10px] text-white font-bold uppercase truncate\" data-kid=\"1-3-1-2-4-2-1-1\" data-name=\"build bar label\">\n                                High-Fidelity Interface\n                            </span>\n                        </div>\n                        <div class=\"absolute left-[96%] flex flex-col items-center\" data-kid=\"1-3-1-2-4-2-2\" data-name=\"build milestone\">\n                            <div class=\"w-3 h-3 rounded-full bg-[#FF6636] border-2 border-white shadow-sm mb-1\" data-kid=\"1-3-1-2-4-2-2-1\" data-name=\"build milestone dot\">\n                            </div>\n                            <span class=\"text-[10px] font-bold text-[#FF6636] uppercase tracking-tighter\" data-kid=\"1-3-1-2-4-2-2-2\" data-name=\"build milestone label\">\n                                Final Review\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Phase: Launch -->\n                <div class=\"grid grid-cols-[200px_repeat(7,1fr)] relative min-h-[80px]\" data-kid=\"1-3-1-2-5\" data-name=\"launch phase row\">\n                    <div class=\"p-4 border-r border-[#2A2A29]/10 flex flex-col justify-center bg-[#F2F4F8]/10\" data-kid=\"1-3-1-2-5-1\" data-name=\"launch phase label box\">\n                        <span class=\"text-lg font-extrabold text-[#2A2A29]\" data-kid=\"1-3-1-2-5-1-1\" data-name=\"launch title\">\n                            04. Launch\n                        </span>\n                        <span class=\"text-[10px] text-[#2A2A29]/40 uppercase font-bold tracking-tighter\" data-kid=\"1-3-1-2-5-1-2\" data-name=\"launch sublabel\">\n                            Delivery\n                        </span>\n                    </div>\n                    <div class=\"col-span-7 p-4 flex items-center relative\" data-kid=\"1-3-1-2-5-2\" data-name=\"launch phase timeline area\">\n                        <div class=\"gantt-bar h-10 bg-[#2A2A29] rounded-sm w-[15%] absolute left-[84%] flex items-center px-4 shadow-sm hover:bg-black cursor-pointer\" data-kid=\"1-3-1-2-5-2-1\" data-name=\"launch timeline bar\">\n                            <span class=\"text-[10px] text-white font-bold uppercase truncate\" data-kid=\"1-3-1-2-5-2-1-1\" data-name=\"launch bar label\">\n                                Handover Kit\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Mobile Timeline (Vertical) -->\n            <div class=\"lg:hidden space-y-4\" data-kid=\"1-3-1-3\" data-name=\"mobile timeline list\">\n                <div class=\"bg-white p-6 rounded-xl border border-[#2A2A29]/5 shadow-sm\" data-kid=\"1-3-1-3-1\" data-name=\"align phase card\">\n                    <div class=\"flex items-center justify-between mb-4\" data-kid=\"1-3-1-3-1-1\" data-name=\"align card header\">\n                        <span class=\"text-sm font-bold text-[#2A2A29]\" data-kid=\"1-3-1-3-1-1-1\" data-name=\"align card title\">\n                            01. Align\n                        </span>\n                        <span class=\"text-[10px] px-2 py-1 bg-[#FF6636]/10 text-[#FF6636] font-bold rounded\" data-kid=\"1-3-1-3-1-1-2\" data-name=\"align card status badge\">\n                            Completed\n                        </span>\n                    </div>\n                    <p class=\"text-xs text-[#2A2A29]/50 mb-4\" data-kid=\"1-3-1-3-1-2\" data-name=\"align card description\">\n                        Systems Audit, Discovery Workshop, Infrastructure Setup.\n                    </p>\n                    <div class=\"h-2 w-full bg-[#F2F4F8] rounded-full overflow-hidden\" data-kid=\"1-3-1-3-1-3\" data-name=\"align progress track\">\n                        <div class=\"h-full bg-[#FF6636] w-full\" data-kid=\"1-3-1-3-1-3-1\" data-name=\"align progress fill\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl border border-[#2A2A29]/5 shadow-sm\" data-kid=\"1-3-1-3-2\" data-name=\"explore phase card\">\n                    <div class=\"flex items-center justify-between mb-4\" data-kid=\"1-3-1-3-2-1\" data-name=\"explore card header\">\n                        <span class=\"text-sm font-bold text-[#2A2A29]\" data-kid=\"1-3-1-3-2-1-1\" data-name=\"explore card title\">\n                            02. Explore\n                        </span>\n                        <span class=\"text-[10px] px-2 py-1 bg-[#2A2A29]/5 text-[#2A2A29]/40 font-bold rounded\" data-kid=\"1-3-1-3-2-1-2\" data-name=\"explore card status badge\">\n                            Active\n                        </span>\n                    </div>\n                    <p class=\"text-xs text-[#2A2A29]/50 mb-4\" data-kid=\"1-3-1-3-2-2\" data-name=\"explore card description\">\n                        User Architecture, Lo-Fi Prototyping, Strategy Validation.\n                    </p>\n                    <div class=\"h-2 w-full bg-[#F2F4F8] rounded-full overflow-hidden\" data-kid=\"1-3-1-3-2-3\" data-name=\"explore progress track\">\n                        <div class=\"h-full bg-[#FF6636] w-[45%]\" data-kid=\"1-3-1-3-2-3-1\" data-name=\"explore progress fill\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl border border-[#2A2A29]/5 shadow-sm opacity-50\" data-kid=\"1-3-1-3-3\" data-name=\"build phase card\">\n                    <div class=\"flex items-center justify-between mb-4\" data-kid=\"1-3-1-3-3-1\" data-name=\"build card header\">\n                        <span class=\"text-sm font-bold text-[#2A2A29]\" data-kid=\"1-3-1-3-3-1-1\" data-name=\"build card title\">\n                            03. Build\n                        </span>\n                        <span class=\"text-[10px] px-2 py-1 bg-[#2A2A29]/5 text-[#2A2A29]/40 font-bold rounded\" data-kid=\"1-3-1-3-3-1-2\" data-name=\"build card status badge\">\n                            Upcoming\n                        </span>\n                    </div>\n                    <p class=\"text-xs text-[#2A2A29]/50\" data-kid=\"1-3-1-3-3-2\" data-name=\"build card description\">\n                        High-Fi Interface, Motion Design, Documentation.\n                    </p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl border border-[#2A2A29]/5 shadow-sm opacity-50\" data-kid=\"1-3-1-3-4\" data-name=\"launch phase card\">\n                    <div class=\"flex items-center justify-between mb-4\" data-kid=\"1-3-1-3-4-1\" data-name=\"launch card header\">\n                        <span class=\"text-sm font-bold text-[#2A2A29]\" data-kid=\"1-3-1-3-4-1-1\" data-name=\"launch card title\">\n                            04. Launch\n                        </span>\n                        <span class=\"text-[10px] px-2 py-1 bg-[#2A2A29]/5 text-[#2A2A29]/40 font-bold rounded\" data-kid=\"1-3-1-3-4-1-2\" data-name=\"launch card status badge\">\n                            Final\n                        </span>\n                    </div>\n                    <p class=\"text-xs text-[#2A2A29]/50\" data-kid=\"1-3-1-3-4-2\" data-name=\"launch card description\">\n                        Asset Export, Developer Handoff, Support Cycle.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Checklist & Outcomes Section -->\n    <section class=\"py-24 px-6 bg-white\" data-kid=\"1-4\" data-name=\"transparency section\">\n        <div class=\"max-w-7xl mx-auto grid lg:grid-cols-2 gap-20 items-center\" data-kid=\"1-4-1\" data-name=\"transparency layout grid\">\n            <!-- Left: Checklist -->\n            <div class=\"fade-up\" data-kid=\"1-4-1-1\" data-name=\"transparency checklist block\">\n                <span class=\"text-[10px] font-bold tracking-[0.3em] text-[#FF6636] uppercase mb-6 block\" data-kid=\"1-4-1-1-1\" data-name=\"checklist label\">\n                    Transparency Matrix\n                </span>\n                <h3 class=\"text-4xl font-extrabold text-[#2A2A29] mb-8 leading-tight\" data-kid=\"1-4-1-1-2\" data-name=\"checklist title\">\n                    What you’ll see\n                    <br data-kid=\"1-4-1-1-2-1\" data-name=\"checklist title break\"/>\n                    every single week\n                </h3>\n                <div class=\"space-y-8\" data-kid=\"1-4-1-1-3\" data-name=\"checklist item list\">\n                    <div class=\"flex gap-5 group\" data-kid=\"1-4-1-1-3-1\" data-name=\"async video item\">\n                        <div class=\"shrink-0 w-10 h-10 rounded-xl bg-[#F2F4F8] border border-[#2A2A29]/5 flex items-center justify-center text-[#FF6636] group-hover:bg-[#FF6636] group-hover:text-white transition-all\" data-kid=\"1-4-1-1-3-1-1\" data-name=\"async video icon box\">\n                            <i class=\"ri-video-chat-line text-lg\" data-kid=\"1-4-1-1-3-1-1-1\" data-name=\"async video icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-4-1-1-3-1-2\" data-name=\"async video text\">\n                            <h4 class=\"text-base font-bold text-[#2A2A29] mb-1\" data-kid=\"1-4-1-1-3-1-2-1\" data-name=\"async video title\">\n                                Async Video Recaps\n                            </h4>\n                            <p class=\"text-sm text-[#2A2A29]/50 leading-relaxed\" data-kid=\"1-4-1-1-3-1-2-2\" data-name=\"async video description\">\n                                Weekly 10-minute Loom recordings walking through everything we built, why we built it, and what's next.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-5 group\" data-kid=\"1-4-1-1-3-2\" data-name=\"live playground item\">\n                        <div class=\"shrink-0 w-10 h-10 rounded-lg bg-[#F2F4F8] border border-[#2A2A29]/15 flex items-center justify-center text-[#FF6636] group-hover:bg-[#FF6636] group-hover:text-white transition-all\" data-kid=\"1-4-1-1-3-2-1\" data-name=\"live playground icon box\">\n                            <i class=\"ri-layout-grid-line text-lg\" data-kid=\"1-4-1-1-3-2-1-1\" data-name=\"live playground icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-4-1-1-3-2-2\" data-name=\"live playground text\">\n                            <h4 class=\"text-base font-bold text-[#2A2A29] mb-1\" data-kid=\"1-4-1-1-3-2-2-1\" data-name=\"live playground title\">\n                                Live System Playground\n                            </h4>\n                            <p class=\"text-sm text-[#2A2A29]/50 leading-relaxed\" data-kid=\"1-4-1-1-3-2-2-2\" data-name=\"live playground description\">\n                                Open access to our design boards. Comment, watch, and collaborate as the architecture evolves in real-time.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-5 group\" data-kid=\"1-4-1-1-3-3\" data-name=\"task log item\">\n                        <div class=\"shrink-0 w-10 h-10 rounded-xl bg-[#F2F4F8] border border-[#2A2A29]/5 flex items-center justify-center text-[#FF6636] group-hover:bg-[#FF6636] group-hover:text-white transition-all\" data-kid=\"1-4-1-1-3-3-1\" data-name=\"task log icon box\">\n                            <i class=\"ri-checkbox-circle-line text-lg\" data-kid=\"1-4-1-1-3-3-1-1\" data-name=\"task log icon\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-4-1-1-3-3-2\" data-name=\"task log text\">\n                            <h4 class=\"text-base font-bold text-[#2A2A29] mb-1\" data-kid=\"1-4-1-1-3-3-2-1\" data-name=\"task log title\">\n                                Weekly Task Logs\n                            </h4>\n                            <p class=\"text-sm text-[#2A2A29]/50 leading-relaxed\" data-kid=\"1-4-1-1-3-3-2-2\" data-name=\"task log description\">\n                                A scannable breakdown of completed tasks versus pending items, delivered every Friday at 4 PM.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Right: Outcomes & Testimonial -->\n            <div class=\"bg-[#F2F4F8] p-8 md:p-12 rounded-2xl border border-[#2A2A29]/5 relative fade-up\" data-kid=\"1-4-1-2\" data-name=\"outcome proof container\">\n                <div class=\"absolute -left-4 top-1/2 -translate-y-1/2 w-8 h-32 bg-[#FF6636] rounded-full blur-2xl opacity-10 hidden lg:block\" data-kid=\"1-4-1-2-1\" data-name=\"outcome decorative blur\">\n                </div>\n                <h4 class=\"text-[10px] font-bold tracking-[0.2em] text-[#2A2A29]/40 uppercase mb-10\" data-kid=\"1-4-1-2-2\" data-name=\"outcome header label\">\n                    Outcome Proof Points\n                </h4>\n                <div class=\"space-y-10 mb-16\" data-kid=\"1-4-1-2-3\" data-name=\"outcome metric list\">\n                    <div data-kid=\"1-4-1-2-3-1\" data-name=\"release frequency metric\">\n                        <div class=\"flex justify-between items-end mb-3\" data-kid=\"1-4-1-2-3-1-1\" data-name=\"release frequency header\">\n                            <span class=\"text-xs font-bold text-[#2A2A29]\" data-kid=\"1-4-1-2-3-1-1-1\" data-name=\"release frequency label\">\n                                Release Frequency\n                            </span>\n                            <span class=\"text-xs font-bold text-[#FF6636]\" data-kid=\"1-4-1-2-3-1-1-2\" data-name=\"release frequency value\">\n                                2.5x Faster\n                            </span>\n                        </div>\n                        <div class=\"h-2 w-full bg-white rounded-full overflow-hidden\" data-kid=\"1-4-1-2-3-1-2\" data-name=\"release frequency track\">\n                            <div class=\"outcome-bar h-full bg-[#FF6636] w-[90%] rounded-full\" data-kid=\"1-4-1-2-3-1-2-1\" data-name=\"release frequency bar\">\n                            </div>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-4-1-2-3-2\" data-name=\"friction reduction metric\">\n                        <div class=\"flex justify-between items-end mb-3\" data-kid=\"1-4-1-2-3-2-1\" data-name=\"friction reduction header\">\n                            <span class=\"text-xs font-bold text-[#2A2A29]\" data-kid=\"1-4-1-2-3-2-1-1\" data-name=\"friction reduction label\">\n                                Engineering Friction\n                            </span>\n                            <span class=\"text-xs font-bold text-[#2A2A29]/40\" data-kid=\"1-4-1-2-3-2-1-2\" data-name=\"friction reduction value\">\n                                -68% Reduction\n                            </span>\n                        </div>\n                        <div class=\"h-2 w-full bg-white rounded-full overflow-hidden\" data-kid=\"1-4-1-2-3-2-2\" data-name=\"friction reduction track\">\n                            <div class=\"outcome-bar h-full bg-[#2A2A29] w-[75%] rounded-full\" data-kid=\"1-4-1-2-3-2-2-1\" data-name=\"friction reduction bar\">\n                            </div>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-4-1-2-3-3\" data-name=\"integrity score metric\">\n                        <div class=\"flex justify-between items-end mb-3\" data-kid=\"1-4-1-2-3-3-1\" data-name=\"integrity score header\">\n                            <span class=\"text-xs font-bold text-[#2A2A29]\" data-kid=\"1-4-1-2-3-3-1-1\" data-name=\"integrity score label\">\n                                Design Integrity Score\n                            </span>\n                            <span class=\"text-xs font-bold text-[#FF6636]\" data-kid=\"1-4-1-2-3-3-1-2\" data-name=\"integrity score value\">\n                                100% Perfect\n                            </span>\n                        </div>\n                        <div class=\"h-2 w-full bg-white rounded-full overflow-hidden\" data-kid=\"1-4-1-2-3-3-2\" data-name=\"integrity score track\">\n                            <div class=\"outcome-bar h-full bg-[#FF6636] w-full rounded-full\" data-kid=\"1-4-1-2-3-3-2-1\" data-name=\"integrity score bar\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Testimonial Anchored -->\n                <div class=\"bg-white p-6 rounded-xl border border-[#2A2A29]/10 shadow-lg mt-8 border-l-4 border-l-[#FF6636]\" data-kid=\"1-4-1-2-4\" data-name=\"testimonial card\">\n                    <p class=\"text-sm leading-relaxed italic text-[#2A2A29]/80 mb-6\" data-kid=\"1-4-1-2-4-1\" data-name=\"testimonial text\">\n                        \"DS-Graphix didn't just give us designs; they gave us a delivery engine. Our time-to-market dropped by weeks because their handoff specs are essentially developer-ready code structures.\"\n                    </p>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-2-4-2\" data-name=\"author profile block\">\n                        <img alt=\"Marcus\" class=\"w-10 h-10 rounded-full bg-gray-200\" data-kid=\"1-4-1-2-4-2-1\" data-name=\"author avatar\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/100?u=marcus\"/>\n                        <div data-kid=\"1-4-1-2-4-2-2\" data-name=\"author details\">\n                            <p class=\"text-[11px] font-bold text-[#2A2A29]\" data-kid=\"1-4-1-2-4-2-2-1\" data-name=\"author name\">\n                                Marcus Thorne\n                            </p>\n                            <p class=\"text-[10px] text-[#2A2A29]/50 uppercase font-bold tracking-tighter\" data-kid=\"1-4-1-2-4-2-2-2\" data-name=\"author title\">\n                                Director of Product, Nexus Lab\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Consultation CTA Section -->\n    <section class=\"py-32 px-6 bg-[#F2F4F8]\" data-kid=\"1-5\" data-name=\"consultation section\">\n        <div class=\"max-w-7xl mx-auto bg-[#2A2A29] rounded-2xl p-12 md:p-20 overflow-hidden relative fade-up\" data-kid=\"1-5-1\" data-name=\"consultation callout card\">\n            <div class=\"absolute -right-20 -bottom-20 w-96 h-96 bg-[#FF6636]/10 rounded-full blur-3xl\" data-kid=\"1-5-1-1\" data-name=\"consultation decorative blur\">\n            </div>\n            <div class=\"grid lg:grid-cols-2 gap-12 items-center relative z-10\" data-kid=\"1-5-1-2\" data-name=\"consultation content grid\">\n                <div data-kid=\"1-5-1-2-1\" data-name=\"consultation headline block\">\n                    <h2 class=\"text-4xl md:text-6xl font-extrabold text-white mb-8 leading-[0.9] tracking-tighter\" data-kid=\"1-5-1-2-1-1\" data-name=\"consultation main title\">\n                        Ready to switch\n                        <br data-kid=\"1-5-1-2-1-1-1\" data-name=\"title break 1\"/>\n                        to a system that\n                        <br data-kid=\"1-5-1-2-1-1-2\" data-name=\"title break 2\"/>\n                        <span class=\"text-[#FF6636]\" data-kid=\"1-5-1-2-1-1-3\" data-name=\"highlighted text\">\n                            actually works?\n                        </span>\n                    </h2>\n                    <p class=\"text-white/50 text-lg mb-10 max-w-sm\" data-kid=\"1-5-1-2-1-2\" data-name=\"consultation description\">\n                        Stop managing vendors and start scaling with a partner. We have limited slots for Q4-2026.\n                    </p>\n                </div>\n                <div class=\"bg-white/5 backdrop-blur-md border border-white/10 p-8 rounded-xl\" data-kid=\"1-5-1-2-2\" data-name=\"booking action card\">\n                    <h4 class=\"text-white text-sm font-bold mb-6 flex items-center gap-2\" data-kid=\"1-5-1-2-2-1\" data-name=\"booking card header\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#FF6636]\" data-kid=\"1-5-1-2-2-1-1\" data-name=\"booking indicator dot\">\n                        </span>\n                        Instant Booking Portal\n                    </h4>\n                    <div class=\"space-y-4\" data-kid=\"1-5-1-2-2-2\" data-name=\"booking link group\">\n                        <a class=\"block bg-[#FF6636] text-white text-center py-4 rounded-lg font-bold hover:bg-[#FF6636]/90 transition-all\" data-kid=\"1-5-1-2-2-2-1\" data-name=\"book call button\" href=\"#\">\n                            Book Discovery Call\n                        </a>\n                        <a class=\"block bg-white text-[#2A2A29] text-center py-4 rounded-lg font-bold hover:bg-gray-100 transition-all\" data-kid=\"1-5-1-2-2-2-2\" data-name=\"download deck button\" href=\"#\">\n                            Download Process Deck\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"bg-white pt-24 pb-12 px-6 border-t border-[#2A2A29]/5\" data-kid=\"1-6\" data-name=\"footer bar\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-6-1\" data-name=\"footer content container\">\n            <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-12 mb-20\" data-kid=\"1-6-1-1\" data-name=\"footer grid\">\n                <div class=\"col-span-2 lg:col-span-2\" data-kid=\"1-6-1-1-1\" data-name=\"footer branding block\">\n                    <a class=\"text-2xl font-extrabold tracking-tighter text-[#2A2A29] mb-6 block\" data-kid=\"1-6-1-1-1-1\" data-name=\"footer brand link\" href=\"#\">\n                        DS\n                        <span class=\"text-[#FF6636]\" data-kid=\"1-6-1-1-1-1-1\" data-name=\"footer brand dot\">\n                            .\n                        </span>\n                        GRAPHIX\n                    </a>\n                    <p class=\"text-[#2A2A29]/50 text-xs max-w-xs leading-relaxed mb-8\" data-kid=\"1-6-1-1-1-2\" data-name=\"footer description\">\n                        The creative agency built for scale. Systems-led design for startups, SMEs, and growth enterprises globally.\n                    </p>\n                    <div class=\"flex gap-4\" data-kid=\"1-6-1-1-1-3\" data-name=\"social media link group\">\n                        <a class=\"w-8 h-8 rounded-lg bg-[#F2F4F8] flex items-center justify-center text-[#2A2A29]/40 hover:text-[#FF6636] transition-colors\" data-kid=\"1-6-1-1-1-3-1\" data-name=\"linkedin link\" href=\"#\">\n                            <i class=\"ri-linkedin-fill\" data-kid=\"1-6-1-1-1-3-1-1\" data-name=\"linkedin icon\">\n                            </i>\n                        </a>\n                        <a class=\"w-8 h-8 rounded-lg bg-[#F2F4F8] flex items-center justify-center text-[#2A2A29]/40 hover:text-[#FF6636] transition-colors\" data-kid=\"1-6-1-1-1-3-2\" data-name=\"twitter link\" href=\"#\">\n                            <i class=\"ri-twitter-x-fill\" data-kid=\"1-6-1-1-1-3-2-1\" data-name=\"twitter icon\">\n                            </i>\n                        </a>\n                        <a class=\"w-8 h-8 rounded-lg bg-[#F2F4F8] flex items-center justify-center text-[#2A2A29]/40 hover:text-[#FF6636] transition-colors\" data-kid=\"1-6-1-1-1-3-3\" data-name=\"instagram link\" href=\"#\">\n                            <i class=\"ri-instagram-line\" data-kid=\"1-6-1-1-1-3-3-1\" data-name=\"instagram icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-6-1-1-2\" data-name=\"services column\">\n                    <h5 class=\"text-[10px] font-bold text-[#2A2A29] uppercase mb-6 tracking-widest\" data-kid=\"1-6-1-1-2-1\" data-name=\"services column title\">\n                        Services\n                    </h5>\n                    <ul class=\"space-y-4 text-xs text-[#2A2A29]/50 font-medium\" data-kid=\"1-6-1-1-2-2\" data-name=\"services list\">\n                        <li data-kid=\"1-6-1-1-2-2-1\" data-name=\"service link 1\">\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-6-1-1-2-2-1-1\" data-name=\"service link 1 text\" href=\"#\">\n                                UI/UX Design\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-1-1-2-2-2\" data-name=\"service link 2\">\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-6-1-1-2-2-2-1\" data-name=\"service link 2 text\" href=\"#\">\n                                Brand Identity\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-1-1-2-2-3\" data-name=\"service link 3\">\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-6-1-1-2-2-3-1\" data-name=\"service link 3 text\" href=\"#\">\n                                Motion Design\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-1-1-2-2-4\" data-name=\"service link 4\">\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-6-1-1-2-2-4-1\" data-name=\"service link 4 text\" href=\"#\">\n                                Graphic Solutions\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-1-1-3\" data-name=\"agency column\">\n                    <h5 class=\"text-[10px] font-bold text-[#2A2A29] uppercase mb-6 tracking-widest\" data-kid=\"1-6-1-1-3-1\" data-name=\"agency column title\">\n                        Agency\n                    </h5>\n                    <ul class=\"space-y-4 text-xs text-[#2A2A29]/50 font-medium\" data-kid=\"1-6-1-1-3-2\" data-name=\"agency list\">\n                        <li data-kid=\"1-6-1-1-3-2-1\" data-name=\"agency link 1\">\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-6-1-1-3-2-1-1\" data-name=\"agency link 1 text\" href=\"#\">\n                                Our Work\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-1-1-3-2-2\" data-name=\"agency link 2\">\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-6-1-1-3-2-2-1\" data-name=\"agency link 2 text\" href=\"#\">\n                                Process\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-1-1-3-2-3\" data-name=\"agency link 3\">\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-6-1-1-3-2-3-1\" data-name=\"agency link 3 text\" href=\"#\">\n                                Insights\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-1-1-3-2-4\" data-name=\"agency link 4\">\n                            <a class=\"hover:text-[#FF6636]\" data-kid=\"1-6-1-1-3-2-4-1\" data-name=\"agency link 4 text\" href=\"#\">\n                                Contact\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-1-1-4\" data-name=\"office column\">\n                    <h5 class=\"text-[10px] font-bold text-[#2A2A29] uppercase mb-6 tracking-widest\" data-kid=\"1-6-1-1-4-1\" data-name=\"office column title\">\n                        Office\n                    </h5>\n                    <p class=\"text-xs text-[#2A2A29]/50 font-medium leading-relaxed\" data-kid=\"1-6-1-1-4-2\" data-name=\"office address text\">\n                        Pune, India\n                        <br data-kid=\"1-6-1-1-4-2-1\" data-name=\"address break 1\"/>\n                        Baner Road, 411007\n                        <br data-kid=\"1-6-1-1-4-2-2\" data-name=\"address break 2\"/>\n                        hello@ds-graphix.com\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex flex-col md:flex-row justify-between items-center pt-8 border-t border-[#2A2A29]/5 gap-6\" data-kid=\"1-6-1-2\" data-name=\"footer bottom bar\">\n                <p class=\"text-[10px] text-[#2A2A29]/40 font-bold uppercase tracking-widest\" data-kid=\"1-6-1-2-1\" data-name=\"copyright text\">\n                    © 2026 DS-Graphix. All Rights Reserved.\n                </p>\n                <div class=\"flex gap-8 text-[10px] text-[#2A2A29]/40 font-bold uppercase tracking-widest\" data-kid=\"1-6-1-2-2\" data-name=\"legal link group\">\n                    <a class=\"hover:text-[#2A2A29]\" data-kid=\"1-6-1-2-2-1\" data-name=\"privacy policy link\" href=\"#\">\n                        Privacy Policy\n                    </a>\n                    <a class=\"hover:text-[#2A2A29]\" data-kid=\"1-6-1-2-2-2\" data-name=\"terms of service link\" href=\"#\">\n                        Terms of Service\n                    </a>\n                    <a class=\"hover:text-[#2A2A29]\" data-kid=\"1-6-1-2-2-3\" data-name=\"cookie policy link\" href=\"#\">\n                        Cookie Policy\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n    <!-- Floating WhatsApp -->\n    <a class=\"fixed bottom-8 right-8 w-14 h-14 bg-[#25D366] text-white rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform z-50\" data-kid=\"1-7\" data-name=\"whatsapp floating button\" href=\"https://wa.me/#\">\n        <i class=\"ri-whatsapp-line text-3xl\" data-kid=\"1-7-1\" data-name=\"whatsapp icon\">\n        </i>\n    </a>\n</div>\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n    document.addEventListener('DOMContentLoaded', () => {\n        // Entrance animations\n        gsap.utils.toArray('.fade-up').forEach((el) => {\n            gsap.from(el, {\n                y: 40,\n                opacity: 0,\n                duration: 1,\n                ease: 'power3.out',\n                scrollTrigger: {\n                    trigger: el,\n                    start: 'top 85%',\n                    toggleActions: 'play none none none'\n                }\n            });\n        });\n\n        // Gantt bars expansion\n        gsap.utils.toArray('.gantt-bar').forEach((bar) => {\n            gsap.from(bar, {\n                scaleX: 0,\n                transformOrigin: 'left center',\n                duration: 1.5,\n                ease: 'expo.out',\n                scrollTrigger: {\n                    trigger: bar,\n                    start: 'top 90%',\n                    toggleActions: 'play none none none'\n                }\n            });\n        });\n\n        // Outcome bars expansion\n        gsap.utils.toArray('.outcome-bar').forEach((bar) => {\n            gsap.from(bar, {\n                width: 0,\n                duration: 2,\n                ease: 'power4.out',\n                scrollTrigger: {\n                    trigger: bar,\n                    start: 'top 90%',\n                    toggleActions: 'play none none none'\n                }\n            });\n        });\n    });\n</script>\n<!-- Icon Library -->\n<link data-kid=\"2\" data-name=\"icon library stylesheet\" href=\"https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n    \n    body {\n        margin: 0;\n        padding: 0;\n    }\n\n    /* Restrained Fade-up classes handled by GSAP */\n    .fade-up {\n        will-change: transform, opacity;\n    }\n\n    /* Custom scrollbar for desktop */\n    @media (min-width: 1024px) {\n        ::-webkit-scrollbar {\n            width: 8px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #F2F4F8;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #2A2A29/20;\n            border-radius: 4px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: #FF6636/40;\n        }\n    }\n</style>\n",
