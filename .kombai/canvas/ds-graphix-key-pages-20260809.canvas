      "rect": {
        "x": 6900,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<body class=\"bg-[#2A2A29] text-white font-['Source_Sans_3'] antialiased overflow-x-clip selection:bg-[#FF6636] selection:text-white\">\n    <!-- Google Fonts & Icons -->\n    <link data-kid=\"1\" data-name=\"google fonts and icons stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@200;400;700;800&family=Source+Sans+3:wght@200;400;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n        .grain-overlay {\n            background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n        }\n\n        @keyframes marquee {\n            0% { transform: translateX(0); }\n            100% { transform: translateX(-50%); }\n        }\n        .animate-marquee {\n            animation: marquee 20s linear infinite;\n        }\n\n        .brutalist-input {\n            background: transparent;\n            border: none;\n            border-bottom: 3px solid #2A2A29;\n            padding: 1.5rem 0;\n            width: 100%;\n            font-size: 2rem;\n            font-weight: 800;\n            text-transform: uppercase;\n            color: #2A2A29;\n            outline: none;\n            transition: border-color 0.3s ease;\n        }\n        .brutalist-input:focus {\n            border-bottom-color: white;\n        }\n        .brutalist-input::placeholder {\n            color: rgba(42, 42, 41, 0.3);\n        }\n\n        .lenis.lenis-smooth {\n            height: auto;\n        }\n        .lenis.lenis-smooth [data-lenis-prevent] {\n            overscroll-behavior: contain;\n        }\n        .lenis.lenis-stopped {\n            overflow: hidden;\n        }\n\n        .sticky-whatsapp {\n            writing-mode: vertical-rl;\n            transform: rotate(180deg);\n        }\n    </style>\n    <!-- Grain Texture Overlay (fixed) -->\n    <div class=\"fixed inset-0 pointer-events-none opacity-[0.04] mix-blend-overlay z-[9999] grain-overlay\" data-kid=\"2\" data-name=\"grain texture overlay\">\n    </div>\n    <!-- Sticky Header -->\n    <header class=\"fixed top-0 w-full z-[100] bg-[#2A2A29] border-b-2 border-white px-6 md:px-12 py-4 flex justify-between items-center\" data-kid=\"3\" data-name=\"sticky header\">\n        <div class=\"text-2xl md:text-3xl font-black tracking-tighter uppercase font-['Bricolage_Grotesque'] hover:text-[#FF6636] transition-colors cursor-pointer\" data-kid=\"3-1\" data-name=\"brand name logo text\">\n            DS-Graphix\n        </div>\n        <nav class=\"hidden lg:flex gap-10 uppercase text-sm tracking-widest font-bold\" data-kid=\"3-2\" data-name=\"main navigation bar\">\n            <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"3-2-1\" data-name=\"work navigation link\" href=\"#\">\n                Work\n            </a>\n            <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"3-2-2\" data-name=\"services navigation link\" href=\"#\">\n                Services\n            </a>\n            <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"3-2-3\" data-name=\"process navigation link\" href=\"#\">\n                Process\n            </a>\n            <a class=\"hover:text-[#FF6636] transition-colors\" data-kid=\"3-2-4\" data-name=\"about navigation link\" href=\"#\">\n                About\n            </a>\n        </nav>\n        <div class=\"flex items-center gap-4 md:gap-8\" data-kid=\"3-3\" data-name=\"header right-side interaction group\">\n            <button class=\"text-white hover:text-[#FF6636] transition-colors\" data-kid=\"3-3-1\" data-name=\"search button\">\n                <i class=\"ti ti-search text-2xl\" data-kid=\"3-3-1-1\" data-name=\"search magnifying glass icon\">\n                </i>\n            </button>\n            <button class=\"bg-white text-[#2A2A29] px-6 py-2.5 font-black uppercase text-sm tracking-tight hover:bg-[#FF6636] hover:text-white transition-all border-2 border-transparent active:scale-95\" data-kid=\"3-3-2\" data-name=\"primary call-to-action button\">\n                Start a project\n            </button>\n        </div>\n    </header>\n    <!-- Main Content Wrapper for Lenis -->\n    <main data-kid=\"4\" data-name=\"main content area\" data-scroll-container=\"\">\n        <!-- Hero Section -->\n        <section class=\"min-h-screen relative flex flex-col justify-center px-6 md:px-12 pt-40 pb-20 overflow-hidden\" data-kid=\"4-1\" data-name=\"hero section\" id=\"hero\">\n            <div class=\"relative z-10 pointer-events-none\" data-kid=\"4-1-1\" data-name=\"hero headline container\">\n                <h1 class=\"text-[14vw] md:text-[12vw] leading-[0.82] font-black uppercase font-['Bricolage_Grotesque'] text-[#FF6636] tracking-tighter reveal-text\" data-kid=\"4-1-1-1\" data-name=\"hero headline text\">\n                    Design\n                    <br data-kid=\"4-1-1-1-1\" data-name=\"line break\"/>\n                    That Drives\n                    <br data-kid=\"4-1-1-1-2\" data-name=\"line break\"/>\n                    Business.\n                </h1>\n            </div>\n            <!-- Microcopy & CTA -->\n            <div class=\"relative z-20 mt-12 md:mt-16 md:ml-[10vw] max-w-md border-l-4 border-[#FF6636] pl-8 py-6 bg-[#2A2A29]/80 backdrop-blur-md\" data-kid=\"4-1-2\" data-name=\"microcopy and cta group\">\n                <p class=\"text-xl md:text-2xl font-light uppercase tracking-tight leading-[1.1] text-white\" data-kid=\"4-1-2-1\" data-name=\"hero description text\">\n                    We don't just design interfaces. We architect high-growth digital ecosystems for the enterprise of 2026.\n                </p>\n                <div class=\"flex flex-wrap gap-4 mt-8\" data-kid=\"4-1-2-2\" data-name=\"cta buttons group\">\n                    <button class=\"bg-[#FF6636] text-white px-8 py-4 font-black uppercase text-sm tracking-widest hover:bg-white hover:text-[#2A2A29] cursor-pointer flex items-center gap-3\" data-kid=\"4-1-2-2-1\" data-name=\"start a project button\">\n                        Start a project\n                        <i class=\"ti ti-arrow-right\" data-kid=\"4-1-2-2-1-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </button>\n                    <button class=\"border-2 border-white text-white px-8 py-4 font-black uppercase text-sm tracking-widest hover:bg-white hover:text-[#2A2A29] cursor-pointer\" data-kid=\"4-1-2-2-2\" data-name=\"the playbook button\">\n                        The Playbook\n                    </button>\n                </div>\n            </div>\n            <!-- Video Window Cutout (Parallax) - \"Cutting through\" -->\n            <div class=\"absolute top-[10%] right-[5%] md:right-[12%] w-[65vw] md:w-[45vw] h-[40vw] md:h-[30vw] border-2 border-white z-0 overflow-hidden transform -rotate-3 shadow-2xl\" data-kid=\"4-1-3\" data-name=\"video window parallax container\" data-scroll=\"\" data-scroll-speed=\"-1.2\">\n                <video alt=\"Coverr on Pexels\" autoplay=\"\" class=\"w-full h-full object-cover scale-110 grayscale brightness-75 hover:grayscale-0 hover:brightness-100\" data-kid=\"4-1-3-1\" data-name=\"hero background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/853870/free-video-853870.jpg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/853870/853870-hd_1280_720_25fps.mp4\">\n                </video>\n                <div class=\"absolute inset-0 bg-[#FF6636]/5 pointer-events-none\" data-kid=\"4-1-3-2\" data-name=\"video overlay color filter\">\n                </div>\n            </div>\n        </section>\n        <!-- Service Ticker Strip -->\n        <div class=\"relative z-20 overflow-hidden bg-[#FF6636] py-8 border-y-2 border-white -rotate-1 md:-rotate-2 scale-105 my-24\" data-kid=\"4-2\" data-name=\"service ticker strip\">\n            <div class=\"flex whitespace-nowrap animate-marquee\" data-kid=\"4-2-1\" data-name=\"marquee movement container\">\n                <div class=\"flex items-center\" data-kid=\"4-2-1-1\" data-name=\"marquee repeating text group 1\">\n                    <span class=\"text-4xl md:text-6xl font-black uppercase font-['Bricolage_Grotesque'] mx-8 flex items-center gap-6 text-[#2A2A29]\" data-kid=\"4-2-1-1-1\" data-name=\"ui ux design text\">\n                        UI/UX DESIGN •\n                    </span>\n                    <span class=\"text-4xl md:text-6xl font-black uppercase font-['Bricolage_Grotesque'] mx-8 flex items-center gap-6 text-[#2A2A29]\" data-kid=\"4-2-1-1-2\" data-name=\"branding text\">\n                        BRANDING •\n                    </span>\n                    <span class=\"text-4xl md:text-6xl font-black uppercase font-['Bricolage_Grotesque'] mx-8 flex items-center gap-6 text-[#2A2A29]\" data-kid=\"4-2-1-1-3\" data-name=\"graphics text\">\n                        GRAPHICS •\n                    </span>\n                    <span class=\"text-4xl md:text-6xl font-black uppercase font-['Bricolage_Grotesque'] mx-8 flex items-center gap-6 text-[#2A2A29]\" data-kid=\"4-2-1-1-4\" data-name=\"video text\">\n                        VIDEO •\n                    </span>\n                </div>\n                <div class=\"flex items-center\" data-kid=\"4-2-1-2\" data-name=\"marquee repeating text group 2\">\n                    <span class=\"text-4xl md:text-6xl font-black uppercase font-['Bricolage_Grotesque'] mx-8 flex items-center gap-6 text-[#2A2A29]\" data-kid=\"4-2-1-2-1\" data-name=\"ui ux design text\">\n                        UI/UX DESIGN •\n                    </span>\n                    <span class=\"text-4xl md:text-6xl font-black uppercase font-['Bricolage_Grotesque'] mx-8 flex items-center gap-6 text-[#2A2A29]\" data-kid=\"4-2-1-2-2\" data-name=\"branding text\">\n                        BRANDING •\n                    </span>\n                    <span class=\"text-4xl md:text-6xl font-black uppercase font-['Bricolage_Grotesque'] mx-8 flex items-center gap-6 text-[#2A2A29]\" data-kid=\"4-2-1-2-3\" data-name=\"graphics text\">\n                        GRAPHICS •\n                    </span>\n                    <span class=\"text-4xl md:text-6xl font-black uppercase font-['Bricolage_Grotesque'] mx-8 flex items-center gap-6 text-[#2A2A29]\" data-kid=\"4-2-1-2-4\" data-name=\"video text\">\n                        VIDEO •\n                    </span>\n                </div>\n            </div>\n        </div>\n        <!-- Asymmetric Service Cluster -->\n        <section class=\"px-6 md:px-12 py-24\" data-kid=\"4-3\" data-name=\"asymmetric service cluster section\">\n            <div class=\"grid grid-cols-1 md:grid-cols-12 border-2 border-white\" data-kid=\"4-3-1\" data-name=\"services grid layout\">\n                <!-- Giant Featured Tile -->\n                <div class=\"col-span-1 md:col-span-8 border-b-2 md:border-b-0 md:border-r-2 border-white p-8 md:p-16 bg-[#2A2A29] group relative overflow-hidden min-h-[500px]\" data-kid=\"4-3-1-1\" data-name=\"featured service tile\">\n                    <div class=\"absolute inset-0 opacity-10 group-hover:opacity-30 transition-all duration-700\" data-kid=\"4-3-1-1-1\" data-name=\"featured tile video background container\">\n                        <video autoplay=\"\" class=\"w-full h-full object-cover\" data-kid=\"4-3-1-1-1-1\" data-name=\"featured tile background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/17599626/3d-arcadian-cgi-digital-17599626.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/17599626/17599626-sd_960_540_30fps.mp4\">\n                        </video>\n                    </div>\n                    <div class=\"relative z-10 h-full flex flex-col justify-between\" data-kid=\"4-3-1-1-2\" data-name=\"featured tile content container\">\n                        <div data-kid=\"4-3-1-1-2-1\" data-name=\"featured tile label container\">\n                            <span class=\"text-[#FF6636] font-black uppercase tracking-widest text-sm mb-4 block\" data-kid=\"4-3-1-1-2-1-1\" data-name=\"featured tile label text\">\n                                Core Expertise\n                            </span>\n                            <h3 class=\"text-6xl md:text-8xl font-black uppercase font-['Bricolage_Grotesque'] text-white leading-[0.9]\" data-kid=\"4-3-1-1-2-1-2\" data-name=\"featured tile heading\">\n                                Digital\n                                <br data-kid=\"4-3-1-1-2-1-2-1\" data-name=\"line break\"/>\n                                Transformation\n                            </h3>\n                        </div>\n                        <div class=\"max-w-md mt-12 md:mt-0\" data-kid=\"4-3-1-1-2-2\" data-name=\"featured tile description group\">\n                            <p class=\"text-xl md:text-2xl font-light leading-relaxed\" data-kid=\"4-3-1-1-2-2-1\" data-name=\"featured tile body text\">\n                                We solve complex enterprise problems through high-fidelity design thinking and brutal engineering efficiency.\n                            </p>\n                            <a class=\"inline-block mt-8 text-[#FF6636] font-black uppercase tracking-tighter border-b-2 border-[#FF6636] pb-1 hover:text-white hover:border-white transition-all\" data-kid=\"4-3-1-1-2-2-2\" data-name=\"view all services link\" href=\"#\">\n                                View all services\n                            </a>\n                        </div>\n                    </div>\n                </div>\n                <!-- Small Tiles Cluster -->\n                <div class=\"col-span-1 md:col-span-4 grid grid-cols-2\" data-kid=\"4-3-1-2\" data-name=\"small services grid\">\n                    <div class=\"border-b-2 border-r-2 border-white p-8 aspect-square flex flex-col justify-between hover:bg-[#FF6636] group transition-all duration-500\" data-kid=\"4-3-1-2-1\" data-name=\"branding service tile\">\n                        <i class=\"ti ti-brand-framer text-5xl text-[#FF6636] group-hover:text-white transition-colors\" data-kid=\"4-3-1-2-1-1\" data-name=\"framer icon\">\n                        </i>\n                        <h4 class=\"font-black uppercase tracking-tight text-lg text-white group-hover:text-[#2A2A29]\" data-kid=\"4-3-1-2-1-2\" data-name=\"branding service heading\">\n                            Branding\n                        </h4>\n                    </div>\n                    <div class=\"border-b-2 border-white p-8 aspect-square flex flex-col justify-between hover:bg-[#FF6636] group transition-all duration-500\" data-kid=\"4-3-1-2-2\" data-name=\"ui ux audit service tile\">\n                        <i class=\"ti ti-layout-dashboard text-5xl text-[#FF6636] group-hover:text-white transition-colors\" data-kid=\"4-3-1-2-2-1\" data-name=\"dashboard icon\">\n                        </i>\n                        <h4 class=\"font-black uppercase tracking-tight text-lg text-white group-hover:text-[#2A2A29]\" data-kid=\"4-3-1-2-2-2\" data-name=\"ui ux audit service heading\">\n                            UI/UX Audit\n                        </h4>\n                    </div>\n                    <div class=\"border-r-2 border-white p-8 aspect-square flex flex-col justify-between hover:bg-[#FF6636] group transition-all duration-500\" data-kid=\"4-3-1-2-3\" data-name=\"video ads service tile\">\n                        <i class=\"ti ti-player-play text-5xl text-[#FF6636] group-hover:text-white transition-colors\" data-kid=\"4-3-1-2-3-1\" data-name=\"play icon\">\n                        </i>\n                        <h4 class=\"font-black uppercase tracking-tight text-lg text-white group-hover:text-[#2A2A29]\" data-kid=\"4-3-1-2-3-2\" data-name=\"video ads service heading\">\n                            Video Ads\n                        </h4>\n                    </div>\n                    <div class=\"p-8 aspect-square flex flex-col justify-between hover:bg-[#FF6636] group transition-all duration-500\" data-kid=\"4-3-1-2-4\" data-name=\"consulting service tile\">\n                        <i class=\"ti ti-users text-5xl text-[#FF6636] group-hover:text-white transition-colors\" data-kid=\"4-3-1-2-4-1\" data-name=\"users icon\">\n                        </i>\n                        <h4 class=\"font-black uppercase tracking-tight text-lg text-white group-hover:text-[#2A2A29]\" data-kid=\"4-3-1-2-4-2\" data-name=\"consulting service heading\">\n                            Consulting\n                        </h4>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Irregular Portfolio Collage -->\n        <section class=\"px-6 md:px-12 py-32 bg-[#F2F4F8] text-[#2A2A29] relative z-20\" data-kid=\"4-4\" data-name=\"portfolio gallery section\">\n            <div class=\"flex flex-col md:flex-row justify-between items-end mb-32 border-b-4 border-[#2A2A29] pb-8\" data-kid=\"4-4-1\" data-name=\"gallery header area\">\n                <h2 class=\"text-7xl md:text-9xl font-black uppercase font-['Bricolage_Grotesque'] leading-[0.85] tracking-tighter\" data-kid=\"4-4-1-1\" data-name=\"gallery heading text\">\n                    The\n                    <br data-kid=\"4-4-1-1-1\" data-name=\"line break\"/>\n                    Gallery.\n                </h2>\n                <div class=\"max-w-xs mt-8 md:mt-0 text-right\" data-kid=\"4-4-1-2\" data-name=\"gallery info group\">\n                    <p class=\"font-bold text-lg uppercase tracking-widest text-[#FF6636]\" data-kid=\"4-4-1-2-1\" data-name=\"featured work label\">\n                        Featured Work\n                    </p>\n                    <p class=\"text-sm opacity-70 mt-2\" data-kid=\"4-4-1-2-2\" data-name=\"gallery description text\">\n                        A rebellious collection of high-impact visual systems.\n                    </p>\n                </div>\n            </div>\n            <div class=\"relative min-h-[1600px] md:min-h-[1800px]\" data-kid=\"4-4-2\" data-name=\"gallery items container\">\n                <!-- Item 1 -->\n                <div class=\"absolute top-0 left-0 w-full md:w-[480px] border-4 border-[#2A2A29] bg-white transform rotate-[-4deg] z-10 group\" data-kid=\"4-4-2-1\" data-name=\"first portfolio item card\" data-scroll=\"\" data-scroll-speed=\"1.2\">\n                    <div class=\"overflow-hidden aspect-[4/3] border-b-4 border-[#2A2A29]\" data-kid=\"4-4-2-1-1\" data-name=\"portfolio image container\">\n                        <img alt=\"Branding Project\" class=\"w-full h-full object-cover\" data-kid=\"4-4-2-1-1-1\" data-name=\"portfolio image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1561070791-2526d30994b5?auto=format&w=800&q=80&fit=crop\"/>\n                    </div>\n                    <div class=\"p-8\" data-kid=\"4-4-2-1-2\" data-name=\"portfolio item content\">\n                        <div class=\"flex justify-between items-start\" data-kid=\"4-4-2-1-2-1\" data-name=\"portfolio item info group\">\n                            <div data-kid=\"4-4-2-1-2-1-1\" data-name=\"portfolio item category container\">\n                                <span class=\"text-xs font-black uppercase tracking-widest text-[#FF6636]\" data-kid=\"4-4-2-1-2-1-1-1\" data-name=\"portfolio category text\">\n                                    Branding\n                                </span>\n                                <h3 class=\"text-3xl font-black uppercase mt-1\" data-kid=\"4-4-2-1-2-1-1-2\" data-name=\"portfolio item title\">\n                                    Ethos Digital\n                                </h3>\n                            </div>\n                            <div class=\"text-right\" data-kid=\"4-4-2-1-2-1-2\" data-name=\"portfolio sprint duration group\">\n                                <span class=\"text-4xl font-black text-[#2A2A29] block\" data-kid=\"4-4-2-1-2-1-2-1\" data-name=\"sprint duration text\">\n                                    18-Day\n                                </span>\n                                <span class=\"text-[10px] font-black uppercase opacity-50\" data-kid=\"4-4-2-1-2-1-2-2\" data-name=\"sprint duration label\">\n                                    Sprint\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Item 2 -->\n                <div class=\"absolute top-[200px] right-0 w-full md:w-[550px] border-4 border-[#2A2A29] bg-[#FF6636] transform rotate-[3deg] z-20 group\" data-kid=\"4-4-2-2\" data-name=\"second portfolio item card\" data-scroll=\"\" data-scroll-speed=\"-0.8\">\n                    <div class=\"overflow-hidden aspect-video border-b-4 border-[#2A2A29] relative\" data-kid=\"4-4-2-2-1\" data-name=\"portfolio video container\">\n                        <video alt=\"Oniri Production on Pexels\" autoplay=\"\" class=\"w-full h-full object-cover\" data-kid=\"4-4-2-2-1-1\" data-name=\"portfolio background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/33362112/pexels-photo-33362112.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" src=\"https://videos.pexels.com/video-files/33362112/14204953_640_360_25fps.mp4\">\n                        </video>\n                    </div>\n                    <div class=\"p-8 text-white\" data-kid=\"4-4-2-2-2\" data-name=\"portfolio item content\">\n                        <span class=\"text-xs font-black uppercase tracking-widest text-[#2A2A29]\" data-kid=\"4-4-2-2-2-1\" data-name=\"portfolio category text\">\n                            Identity\n                        </span>\n                        <h3 class=\"text-4xl font-black uppercase mt-1\" data-kid=\"4-4-2-2-2-2\" data-name=\"portfolio item title\">\n                            Lumina Reels\n                        </h3>\n                        <div class=\"mt-8 flex gap-12 border-t-2 border-white/30 pt-4\" data-kid=\"4-4-2-2-2-3\" data-name=\"portfolio stats container\">\n                            <div data-kid=\"4-4-2-2-2-3-1\" data-name=\"portfolio stat value container\">\n                                <span class=\"text-3xl font-black\" data-kid=\"4-4-2-2-2-3-1-1\" data-name=\"portfolio stat value\">\n                                    40%\n                                </span>\n                                <p class=\"text-[10px] font-bold uppercase opacity-70\" data-kid=\"4-4-2-2-2-3-1-2\" data-name=\"portfolio stat label\">\n                                    CTR Increase\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Item 3 -->\n                <div class=\"absolute top-[600px] left-[15%] w-full md:w-[650px] border-4 border-[#2A2A29] bg-white transform rotate-[-2deg] z-30 group\" data-kid=\"4-4-2-3\" data-name=\"third portfolio item card\" data-scroll=\"\" data-scroll-speed=\"0.4\">\n                    <div class=\"flex flex-col md:flex-row\" data-kid=\"4-4-2-3-1\" data-name=\"portfolio card layout\">\n                        <div class=\"md:w-1/2 border-b-4 md:border-b-0 md:border-r-4 border-[#2A2A29] overflow-hidden aspect-square\" data-kid=\"4-4-2-3-1-1\" data-name=\"portfolio image container\">\n                            <img alt=\"UI/UX Case\" class