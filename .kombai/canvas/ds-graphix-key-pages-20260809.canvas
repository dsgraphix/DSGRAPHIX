 rounded-full\" data-kid=\"1-2-6-1-1-2-2-2-1-1\" data-name=\"track fill\">\n                                    </div>\n                                    <!-- Tick Marks -->\n                                    <div class=\"absolute inset-0 flex justify-between pointer-events-none\" data-kid=\"1-2-6-1-1-2-2-2-1-2\" data-name=\"tick marks container\">\n                                        <div class=\"w-0.5 h-full bg-black/10\" data-kid=\"1-2-6-1-1-2-2-2-1-2-1\" data-name=\"tick mark\">\n                                        </div>\n                                        <div class=\"w-0.5 h-full bg-black/10\" data-kid=\"1-2-6-1-1-2-2-2-1-2-2\" data-name=\"tick mark\">\n                                        </div>\n                                        <div class=\"w-0.5 h-full bg-black/10\" data-kid=\"1-2-6-1-1-2-2-2-1-2-3\" data-name=\"tick mark\">\n                                        </div>\n                                        <div class=\"w-0.5 h-full bg-black/10\" data-kid=\"1-2-6-1-1-2-2-2-1-2-4\" data-name=\"tick mark\">\n                                        </div>\n                                        <div class=\"w-0.5 h-full bg-black/10\" data-kid=\"1-2-6-1-1-2-2-2-1-2-5\" data-name=\"tick mark\">\n                                        </div>\n                                    </div>\n                                    <!-- Handle -->\n                                    <div class=\"absolute top-1/2 left-[40%] -translate-y-1/2 w-8 h-8 bg-white border-[6px] border-[var(--color-text)] rounded-full cursor-pointer shadow-xl z-10 hover:scale-110 transition-transform\" data-kid=\"1-2-6-1-1-2-2-2-1-3\" data-name=\"slider handle\">\n                                    </div>\n                                </div>\n                                <div class=\"flex justify-between text-[10px] font-black opacity-40 tracking-widest\" data-kid=\"1-2-6-1-1-2-2-2-2\" data-name=\"slider label container\">\n                                    <span data-kid=\"1-2-6-1-1-2-2-2-2-1\" data-name=\"min scale label\">\n                                        STARTER (10K)\n                                    </span>\n                                    <span data-kid=\"1-2-6-1-1-2-2-2-2-2\" data-name=\"low scale label\">\n                                        GROWTH (25K)\n                                    </span>\n                                    <span data-kid=\"1-2-6-1-1-2-2-2-2-3\" data-name=\"high scale label\">\n                                        SCALE (50K)\n                                    </span>\n                                    <span data-kid=\"1-2-6-1-1-2-2-2-2-4\" data-name=\"max scale label\">\n                                        MAX (100K+)\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"pt-8\" data-kid=\"1-2-6-1-1-3\" data-name=\"submit action container\">\n                        <button class=\"w-full lg:w-fit bg-[var(--color-text)] text-white px-12 py-6 rounded-lg font-black uppercase tracking-[0.3em] hover:bg-black transition-all border-none cursor-pointer flex items-center justify-center gap-6 group\" data-kid=\"1-2-6-1-1-3-1\" data-name=\"generate proposal button\">\n                            Generate System Proposal\n                            <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"1-2-6-1-1-3-1-1\" data-name=\"arrow icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"w-full lg:w-[450px] bg-[var(--color-text)] text-white p-12 lg:p-20 flex flex-col justify-between relative group\" data-kid=\"1-2-6-1-2\" data-name=\"side card column\">\n                    <div class=\"space-y-8\" data-kid=\"1-2-6-1-2-1\" data-name=\"card content\">\n                        <h3 class=\"text-3xl font-black tracking-tighter\" data-kid=\"1-2-6-1-2-1-1\" data-name=\"emergency header\">\n                            Emergency Handoff?\n                        </h3>\n                        <p class=\"text-white/40 leading-relaxed\" data-kid=\"1-2-6-1-2-1-2\" data-name=\"emergency description\">\n                            For high-priority deployments, our WhatsApp speed-dial ensures a strategist response within 120 minutes.\n                        </p>\n                        <a class=\"flex items-center gap-6 bg-white/5 border border-white/10 hover:bg-white/10 p-6 rounded-xl transition-all group/wa no-underline text-white\" data-kid=\"1-2-6-1-2-1-3\" data-name=\"whatsapp button\" href=\"https://wa.me/919890388405\" target=\"_blank\">\n                            <div class=\"w-14 h-14 bg-[#25D366] rounded-lg flex items-center justify-center text-3xl shrink-0 group-hover/wa:scale-110 transition-transform\" data-kid=\"1-2-6-1-2-1-3-1\" data-name=\"whatsapp icon container\">\n                                <i class=\"ti ti-brand-whatsapp\" data-kid=\"1-2-6-1-2-1-3-1-1\" data-name=\"whatsapp icon\">\n                                </i>\n                            </div>\n                            <div class=\"space-y-1\" data-kid=\"1-2-6-1-2-1-3-2\" data-name=\"whatsapp text container\">\n                                <span class=\"block text-[10px] font-black uppercase tracking-widest opacity-40\" data-kid=\"1-2-6-1-2-1-3-2-1\" data-name=\"whatsapp access label\">\n                                    Direct Access\n                                </span>\n                                <span class=\"block text-lg font-bold\" data-kid=\"1-2-6-1-2-1-3-2-2\" data-name=\"whatsapp button text\">\n                                    Start Secure Chat\n                                </span>\n                            </div>\n                        </a>\n                    </div>\n                    <div class=\"pt-12 text-[10px] font-black opacity-20 uppercase tracking-[0.3em]\" data-kid=\"1-2-6-1-2-2\" data-name=\"version footer text\">\n                        DS-GRAPHIX CORE V2.0\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <!-- Footer -->\n    <footer class=\"bg-white border-t border-[var(--color-text)]/10 pt-32 pb-16\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"max-w-[1520px] mx-auto px-8\" data-kid=\"1-3-1\" data-name=\"footer container\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-20 mb-32\" data-kid=\"1-3-1-1\" data-name=\"footer links grid\">\n                <div class=\"lg:col-span-2 space-y-8\" data-kid=\"1-3-1-1-1\" data-name=\"footer brand column\">\n                    <a class=\"flex items-center gap-3 no-underline text-[var(--color-text)]\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer wordmark\" href=\"#\">\n                        <div class=\"w-10 h-10 bg-[var(--color-text)] rounded-sm flex items-center justify-center\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"footer logo container\">\n                            <span class=\"text-white font-black text-2xl\" data-kid=\"1-3-1-1-1-1-1-1\" data-name=\"footer logo text\">\n                                D\n                            </span>\n                        </div>\n                        <span class=\"font-black text-3xl tracking-tighter\" data-kid=\"1-3-1-1-1-1-2\" data-name=\"footer brand name\">\n                            DS-GRAPHIX\n                        </span>\n                    </a>\n                    <p class=\"text-lg text-[var(--color-text)]/40 max-w-sm leading-relaxed\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer brand description\">\n                        A systems-led design studio architecting the digital infrastructures of tomorrow, today.\n                    </p>\n                </div>\n                <div class=\"space-y-8\" data-kid=\"1-3-1-1-2\" data-name=\"products link column\">\n                    <h4 class=\"text-[10px] font-black uppercase tracking-widest opacity-30\" data-kid=\"1-3-1-1-2-1\" data-name=\"link category header\">\n                        Products\n                    </h4>\n                    <ul class=\"list-none p-0 m-0 space-y-6 text-sm font-bold opacity-60\" data-kid=\"1-3-1-1-2-2\" data-name=\"footer list\">\n                        <li data-kid=\"1-3-1-1-2-2-1\" data-name=\"footer list item\">\n                            <a class=\"hover:text-[var(--color-accent)] transition-colors no-underline text-[var(--color-text)]\" data-kid=\"1-3-1-1-2-2-1-1\" data-name=\"ui architecture link\" href=\"#\">\n                                UI Architecture\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-2\" data-name=\"footer list item\">\n                            <a class=\"hover:text-[var(--color-accent)] transition-colors no-underline text-[var(--color-text)]\" data-kid=\"1-3-1-1-2-2-2-1\" data-name=\"brand os link\" href=\"#\">\n                                Brand OS\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"space-y-8\" data-kid=\"1-3-1-1-3\" data-name=\"agency link column\">\n                    <h4 class=\"text-[10px] font-black uppercase tracking-widest opacity-30\" data-kid=\"1-3-1-1-3-1\" data-name=\"link category header\">\n                        Agency\n                    </h4>\n                    <ul class=\"list-none p-0 m-0 space-y-6 text-sm font-bold opacity-60\" data-kid=\"1-3-1-1-3-2\" data-name=\"footer list\">\n                        <li data-kid=\"1-3-1-1-3-2-1\" data-name=\"footer list item\">\n                            <a class=\"hover:text-[var(--color-accent)] transition-colors no-underline text-[var(--color-text)]\" data-kid=\"1-3-1-1-3-2-1-1\" data-name=\"inventory link\" href=\"#\">\n                                Inventory\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-3-2-2\" data-name=\"footer list item\">\n                            <a class=\"hover:text-[var(--color-accent)] transition-colors no-underline text-[var(--color-text)]\" data-kid=\"1-3-1-1-3-2-2-1\" data-name=\"process lab link\" href=\"#\">\n                                Process Lab\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"space-y-8\" data-kid=\"1-3-1-1-4\" data-name=\"contact link column\">\n                    <h4 class=\"text-[10px] font-black uppercase tracking-widest opacity-30\" data-kid=\"1-3-1-1-4-1\" data-name=\"link category header\">\n                        Initialize\n                    </h4>\n                    <ul class=\"list-none p-0 m-0 space-y-6 text-sm font-bold opacity-60\" data-kid=\"1-3-1-1-4-2\" data-name=\"footer list\">\n                        <li data-kid=\"1-3-1-1-4-2-1\" data-name=\"footer list item\">\n                            <a class=\"hover:text-[var(--color-accent)] transition-colors no-underline text-[var(--color-text)]\" data-kid=\"1-3-1-1-4-2-1-1\" data-name=\"email link\" href=\"mailto:hello@dsgraphix.com\">\n                                hello@dsgraphix.com\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-4-2-2\" data-name=\"footer list item\">\n                            <span class=\"block\" data-kid=\"1-3-1-1-4-2-2-1\" data-name=\"phone number\">\n                                +91 98903 88405\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"flex flex-col md:flex-row justify-between items-center gap-8 pt-12 border-t border-[var(--color-text)]/5\" data-kid=\"1-3-1-2\" data-name=\"footer bottom row\">\n                <p class=\"text-[10px] font-black uppercase tracking-[0.4em] opacity-40\" data-kid=\"1-3-1-2-1\" data-name=\"copyright text\">\n                    © 2026 DS-GRAPHIX SYSTEM SOLUTIONS. INC.\n                </p>\n                <div class=\"flex gap-12 text-[10px] font-black uppercase tracking-[0.2em] opacity-40\" data-kid=\"1-3-1-2-2\" data-name=\"legal link container\">\n                    <a class=\"hover:text-[var(--color-accent)] transition-colors no-underline text-[var(--color-text)]\" data-kid=\"1-3-1-2-2-1\" data-name=\"privacy link\" href=\"#\">\n                        Privacy Node\n                    </a>\n                    <a class=\"hover:text-[var(--color-accent)] transition-colors no-underline text-[var(--color-text)]\" data-kid=\"1-3-1-2-2-2\" data-name=\"security link\" href=\"#\">\n                        Security Protocol\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n    <!-- FAB -->\n    <button class=\"fixed bottom-10 right-10 z-[60] w-16 h-16 rounded-lg bg-[var(--color-accent)] text-white shadow-2xl flex items-center justify-center text-3xl hover:scale-110 active:scale-95 transition-all border-none cursor-pointer\" data-kid=\"1-4\" data-name=\"floating action button\">\n        <i class=\"ti ti-brand-hipchat\" data-kid=\"1-4-1\" data-name=\"chat icon\">\n        </i>\n    </button>\n</div>\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Initialize Lenis\n    const lenis = new Lenis()\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Purposeful Entrance Animations\n    gsap.from('.gantt-bar', {\n        scaleX: 0,\n        transformOrigin: \"left\",\n        duration: 1.5,\n        stagger: 0.15,\n        ease: \"expo.out\",\n        scrollTrigger: {\n            trigger: '.gantt-bar',\n            start: \"top 90%\"\n        }\n    });\n\n    // Portfolio Detail Interaction\n    const portfolioItems = document.querySelectorAll('.portfolio-item');\n    const detailTitle = document.getElementById('detail-title');\n    const detailDesc = document.getElementById('detail-desc');\n    const stats = [\n        document.getElementById('detail-stat-1'),\n        document.getElementById('detail-stat-2'),\n        document.getElementById('detail-stat-3')\n    ];\n\n    const projects = {\n        fintech: {\n            title: \"Optimizing Data Density for Global Fintech.\",\n            desc: \"Re-architected the terminal experience for high-stakes decision makers, resulting in a 30% reduction in cognitive switch time.\",\n            stats: [\"+42.8%\", \"-2.4s\", \"3.5x\"]\n        },\n        ecoflow: {\n            title: \"Global Energy Branding at Scale.\",\n            desc: \"Designed a multi-market identity system for EcoFlow, unifying their global product presence across 24 countries.\",\n            stats: [\"+65.2%\", \"24 Reg\", \"5.0x\"]\n        }\n    };\n\n    portfolioItems.forEach(item => {\n        item.addEventListener('click', () => {\n            portfolioItems.forEach(i => {\n                i.classList.remove('bg-[var(--color-accent)]', 'text-white');\n                i.querySelector('span')?.classList.remove('opacity-60');\n                i.querySelector('span')?.classList.add('opacity-30');\n            });\n            item.classList.add('bg-[var(--color-accent)]', 'text-white');\n            item.querySelector('span')?.classList.add('opacity-60');\n            item.querySelector('span')?.classList.remove('opacity-30');\n\n            const data = projects[item.getAttribute('data-project')];\n            \n            gsap.to('#project-detail', {\n                opacity: 0,\n                y: 10,\n                duration: 0.2,\n                onComplete: () => {\n                    detailTitle.innerText = data.title;\n                    detailDesc.innerText = data.desc;\n                    stats[0].innerText = data.stats[0];\n                    stats[1].innerText = data.stats[1];\n                    stats[2].innerText = data.stats[2];\n                    gsap.to('#project-detail', { opacity: 1, y: 0, duration: 0.4, ease: \"power2.out\" });\n                }\n            });\n        });\n    });\n</script>\n",
      "comments": [],
      "created": "2026-08-09T11:39:40.363554+00:00",
