      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n\n    :root {\n        --color-orange: #FF6636;\n        --color-dark: #2A2A29;\n        --color-white: #FFFFFF;\n        --color-bg: #F2F4F8;\n    }\n\n    body {\n        font-family: 'Plus Jakarta Sans', sans-serif;\n        background-color: var(--color-bg);\n        color: var(--color-dark);\n        margin: 0;\n        -webkit-font-smoothing: antialiased;\n    }\n\n    .custom-scrollbar::-webkit-scrollbar { width: 4px; }\n    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }\n    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 10px; }\n\n    .hide-scrollbar::-webkit-scrollbar { display: none; }\n    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n    /* For smooth sticky */\n    .sticky-top {\n        position: sticky;\n        top: 2rem;\n    }\n</style>\n<link data-kid=\"1\" data-name=\"lenis smooth scroll library css\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen\" data-kid=\"2\" data-name=\"page wrapper\">\n    <!-- Shared Navbar -->\n    <nav class=\"bg-white/90 backdrop-blur-md border-b border-black/5 sticky top-0 z-50\" data-kid=\"2-1\" data-name=\"sticky site navigation bar\">\n        <div class=\"max-w-[1440px] mx-auto px-6 h-16 flex items-center justify-between\" data-kid=\"2-1-1\" data-name=\"navigation container\">\n            <!-- Logo -->\n            <div class=\"flex items-center gap-10\" data-kid=\"2-1-1-1\" data-name=\"logo and nav links container\">\n                <a class=\"flex items-center gap-2 shrink-0\" data-kid=\"2-1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n                    <div class=\"w-7 h-7 bg-[var(--color-dark)] rounded-xs flex items-center justify-center\" data-kid=\"2-1-1-1-1-1\" data-name=\"logo icon container\">\n                        <span class=\"text-white font-black text-sm italic\" data-kid=\"2-1-1-1-1-1-1\" data-name=\"logo text\">\n                            DS\n                        </span>\n                    </div>\n                    <span class=\"font-bold text-base tracking-tight text-[var(--color-dark)]\" data-kid=\"2-1-1-1-1-2\" data-name=\"company name text\">\n                        Graphix\n                    </span>\n                </a>\n                <!-- Nav Links -->\n                <div class=\"hidden lg:flex items-center gap-6\" data-kid=\"2-1-1-1-2\" data-name=\"navigation links container\">\n                    <a class=\"text-[10px] font-bold uppercase tracking-widest text-black/40 hover:text-[var(--color-orange)] transition-colors\" data-kid=\"2-1-1-1-2-1\" data-name=\"services link\" href=\"#\">\n                        Services\n                    </a>\n                    <a class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--color-orange)] transition-colors\" data-kid=\"2-1-1-1-2-2\" data-name=\"portfolio link\" href=\"#\">\n                        Portfolio\n                    </a>\n                    <a class=\"text-[10px] font-bold uppercase tracking-widest text-black/40 hover:text-[var(--color-orange)] transition-colors\" data-kid=\"2-1-1-1-2-3\" data-name=\"process link\" href=\"#\">\n                        Process\n                    </a>\n                </div>\n            </div>\n            <!-- Compact Search & Action -->\n            <div class=\"flex items-center gap-6\" data-kid=\"2-1-1-2\" data-name=\"search and cta container\">\n                <div class=\"relative hidden sm:block\" data-kid=\"2-1-1-2-1\" data-name=\"search input container\">\n                    <div class=\"absolute inset-y-0 left-3 flex items-center pointer-events-none\" data-kid=\"2-1-1-2-1-1\" data-name=\"search icon wrapper\">\n                        <svg class=\"w-3.5 h-3.5 text-black/20\" data-kid=\"2-1-1-2-1-1-1\" data-name=\"magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                            </path>\n                        </svg>\n                    </div>\n                    <input class=\"w-48 lg:w-64 bg-[var(--color-bg)] border-none rounded-lg py-1.5 pl-9 pr-4 text-xs focus:ring-1 focus:ring-[var(--color-orange)] outline-hidden transition-all\" data-kid=\"2-1-1-2-1-2\" data-name=\"search input field\" placeholder=\"Search...\" type=\"text\"/>\n                </div>\n                <button class=\"bg-[var(--color-orange)] text-white text-[10px] font-bold uppercase tracking-widest px-5 py-2 rounded-lg hover:brightness-110 transition-all\" data-kid=\"2-1-1-2-2\" data-name=\"get quote button\">\n                    Get Quote\n                </button>\n            </div>\n        </div>\n    </nav>\n    <main class=\"max-w-[1440px] mx-auto px-6 py-12\" data-kid=\"2-2\" data-name=\"main content area\">\n        <!-- Structured Hero Section -->\n        <header class=\"mb-20 reveal grid grid-cols-1 lg:grid-cols-12 gap-12 items-end border-b border-black/5 pb-16\" data-kid=\"2-2-1\" data-name=\"hero section\">\n            <div class=\"lg:col-span-8\" data-kid=\"2-2-1-1\" data-name=\"hero text content container\">\n                <div class=\"text-[10px] font-bold text-[var(--color-orange)] uppercase tracking-[0.2em] mb-6\" data-kid=\"2-2-1-1-1\" data-name=\"hero label text\">\n                    Systems-Led Design Studio\n                </div>\n                <h1 class=\"text-6xl lg:text-8xl font-extrabold tracking-tighter text-[var(--color-dark)] leading-[0.9] mb-8\" data-kid=\"2-2-1-1-2\" data-name=\"hero headline\">\n                    Portfolio built\n                    <br data-kid=\"2-2-1-1-2-1\" data-name=\"line break\"/>\n                    for decisions.\n                </h1>\n                <p class=\"text-xl text-[var(--color-dark)]/50 max-w-xl leading-relaxed\" data-kid=\"2-2-1-1-3\" data-name=\"hero subheadline description\">\n                    We architect outcomes by combining technical rigour with business logic. No generic patterns, just measured performance.\n                </p>\n            </div>\n            <div class=\"lg:col-span-4 hidden lg:block\" data-kid=\"2-2-1-2\" data-name=\"hero data visualization container\">\n                <div class=\"bg-white border border-black/5 p-6 rounded-2xl shadow-sm\" data-kid=\"2-2-1-2-1\" data-name=\"data card\">\n                    <div class=\"flex justify-between items-center mb-6\" data-kid=\"2-2-1-2-1-1\" data-name=\"data header\">\n                        <span class=\"text-[10px] font-bold uppercase tracking-widest text-black/30\" data-kid=\"2-2-1-2-1-1-1\" data-name=\"data title text\">\n                            Total Impact 2026\n                        </span>\n                        <span class=\"text-[10px] font-bold text-green-500 uppercase\" data-kid=\"2-2-1-2-1-1-2\" data-name=\"live data indicator text\">\n                            Live Data\n                        </span>\n                    </div>\n                    <div class=\"space-y-4\" data-kid=\"2-2-1-2-1-2\" data-name=\"data metrics container\">\n                        <div class=\"flex justify-between items-end\" data-kid=\"2-2-1-2-1-2-1\" data-name=\"data conversion rate\">\n                            <span class=\"text-2xl font-black text-[var(--color-dark)]\" data-kid=\"2-2-1-2-1-2-1-1\" data-name=\"conversion percentage text\">\n                                +14.2%\n                            </span>\n                            <span class=\"text-[9px] font-bold text-black/40 uppercase\" data-kid=\"2-2-1-2-1-2-1-2\" data-name=\"conversion label text\">\n                                Avg. Conversion\n                            </span>\n                        </div>\n                        <div class=\"h-1 w-full bg-gray-100 rounded-full overflow-hidden\" data-kid=\"2-2-1-2-1-2-2\" data-name=\"progress bar track\">\n                            <div class=\"h-full bg-[var(--color-orange)] w-3/4\" data-kid=\"2-2-1-2-1-2-2-1\" data-name=\"progress bar fill\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <section class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 mb-32\" data-kid=\"2-2-2\" data-name=\"projects section\">\n            <!-- Left: Sidebar Project List -->\n            <div class=\"lg:col-span-5 flex flex-col gap-8\" data-kid=\"2-2-2-1\" data-name=\"project list sidebar\">\n                <!-- Filters -->\n                <div class=\"flex gap-6 overflow-x-auto pb-2 hide-scrollbar lg:flex-wrap\" data-kid=\"2-2-2-1-1\" data-name=\"project filters\">\n                    <button class=\"filter-btn active text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--color-orange)] border-b-2 border-[var(--color-orange)] pb-2 transition-all\" data-kid=\"2-2-2-1-1-1\" data-name=\"all work filter button\">\n                        All Work\n                    </button>\n                    <button class=\"filter-btn text-[10px] font-bold uppercase tracking-[0.2em] text-black/30 hover:text-black pb-2 transition-all\" data-kid=\"2-2-2-1-1-2\" data-name=\"ui/ux filter button\">\n                        UI/UX\n                    </button>\n                    <button class=\"filter-btn text-[10px] font-bold uppercase tracking-[0.2em] text-black/30 hover:text-black pb-2 transition-all\" data-kid=\"2-2-2-1-1-3\" data-name=\"branding filter button\">\n                        Branding\n                    </button>\n                    <button class=\"filter-btn text-[10px] font-bold uppercase tracking-[0.2em] text-black/30 hover:text-black pb-2 transition-all\" data-kid=\"2-2-2-1-1-4\" data-name=\"video filter button\">\n                        Video\n                    </button>\n                </div>\n                <!-- List -->\n                <div class=\"space-y-4 max-h-[calc(100vh-250px)] overflow-y-auto pr-2 custom-scrollbar\" data-kid=\"2-2-2-1-2\" data-name=\"project items list\" id=\"project-list\">\n                    <!-- Project Item 1 (Active) -->\n                    <div class=\"project-row active p-6 rounded-2xl bg-white border border-[var(--color-orange)] shadow-sm cursor-pointer transition-all\" data-kid=\"2-2-2-1-2-1\" data-name=\"project row one\">\n                        <div class=\"flex justify-between items-start mb-6\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"project summary\">\n                            <div data-kid=\"2-2-2-1-2-1-1-1\" data-name=\"project title header\">\n                                <h3 class=\"font-extrabold text-xl text-[var(--color-dark)] mb-1\" data-kid=\"2-2-2-1-2-1-1-1-1\" data-name=\"project title text\">\n                                    FinStream Pro\n                                </h3>\n                                <div class=\"flex items-center gap-2\" data-kid=\"2-2-2-1-2-1-1-1-2\" data-name=\"project category container\">\n                                    <span class=\"w-1.5 h-1.5 rounded-full bg-green-500\" data-kid=\"2-2-2-1-2-1-1-1-2-1\" data-name=\"status indicator dot\">\n                                    </span>\n                                    <p class=\"text-[9px] text-black/40 font-bold uppercase tracking-widest\" data-kid=\"2-2-2-1-2-1-1-1-2-2\" data-name=\"category label text\">\n                                        Financial SaaS\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-8 pt-6 border-t border-black/5\" data-kid=\"2-2-2-1-2-1-2\" data-name=\"project metrics grid\">\n                            <div data-kid=\"2-2-2-1-2-1-2-1\" data-name=\"discipline field\">\n                                <p class=\"text-[9px] font-bold text-black/30 uppercase tracking-[0.2em] mb-2\" data-kid=\"2-2-2-1-2-1-2-1-1\" data-name=\"discipline label\">\n                                    Discipline\n                                </p>\n                                <p class=\"text-xs font-bold\" data-kid=\"2-2-2-1-2-1-2-1-2\" data-name=\"discipline value\">\n                                    End-to-end UI/UX\n                                </p>\n                            </div>\n                            <div data-kid=\"2-2-2-1-2-1-2-2\" data-name=\"outcome field\">\n                                <p class=\"text-[9px] font-bold text-black/30 uppercase tracking-[0.2em] mb-2\" data-kid=\"2-2-2-1-2-1-2-2-1\" data-name=\"outcome label\">\n                                    Outcome\n                                </p>\n                                <p class=\"text-xs font-bold text-[var(--color-orange)]\" data-kid=\"2-2-2-1-2-1-2-2-2\" data-name=\"outcome value\">\n                                    +42% Conversion\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Project Item 2 -->\n                    <div class=\"project-row p-6 rounded-2xl bg-white border border-black/5 hover:border-[var(--color-orange)]/30 shadow-sm cursor-pointer transition-all\" data-kid=\"2-2-2-1-2-2\" data-name=\"project row two\">\n                        <div class=\"flex justify-between items-start mb-4\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"project header\">\n                            <div data-kid=\"2-2-2-1-2-2-1-1\" data-name=\"project title container\">\n                                <h3 class=\"font-extrabold text-lg text-[var(--color-dark)]\" data-kid=\"2-2-2-1-2-2-1-1-1\" data-name=\"project title text\">\n                                    Lumina Brand\n                                </h3>\n    