    },
    "var_ea6dd40b381c": {
      "type": "variant",
      "label": "Expressive — Portfolio",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=Source+Sans+3:wght@400;600;700&display=swap');\n\n  :root {\n    --color-dark: #2A2A29;\n    --color-orange: #FF6636;\n    --color-gray: #F2F4F8;\n    --color-white: #FFFFFF;\n  }\n\n  body {\n    background-color: var(--color-dark);\n    color: var(--color-white);\n    font-family: 'Source+Sans+3', sans-serif;\n    overflow-x: clip;\n  }\n\n  h1, h2, h3, h4, .font-heading {\n    font-family: 'Bricolage Grotesque', sans-serif;\n  }\n\n  .no-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .no-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  .noise-bg::after {\n    content: \"\";\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    background: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3%3Ffilter id='noiseFilter'%3E%3FfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    opacity: 0.04;\n    z-index: 9999;\n  }\n\n  .brutalist-border {\n    border: 2px solid var(--color-white);\n  }\n\n  .parallax-item {\n    will-change: transform;\n  }\n</style>\n<link data-kid=\"1\" data-name=\"smooth scroll stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<div class=\"noise-bg min-h-screen\" data-kid=\"2\" data-name=\"main page layout container\">\n    <!-- Sticky Header -->\n    <header class=\"fixed top-0 left-0 w-full z-[100] border-b-2 border-white/10 bg-[#2A2A29]/80 backdrop-blur-md\" data-kid=\"2-1\" data-name=\"sticky navigation header\">\n        <div class=\"max-w-[1440px] mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"2-1-1\" data-name=\"navigation bar container\">\n            <div class=\"flex items-center gap-2\" data-kid=\"2-1-1-1\" data-name=\"brand logo container\">\n                <span class=\"text-[#FF6636] font-black text-2xl tracking-tighter\" data-kid=\"2-1-1-1-1\" data-name=\"brand logo text\">\n                    DS-GRAPHIX\n                </span>\n            </div>\n            <nav class=\"hidden md:flex items-center gap-10\" data-kid=\"2-1-1-2\" data-name=\"navigation links list\">\n                <a class=\"font-bold uppercase text-sm tracking-widest hover:text-[#FF6636] transition-colors\" data-kid=\"2-1-1-2-1\" data-name=\"work navigation link\" href=\"#\">\n                    Work\n                </a>\n                <a class=\"font-bold uppercase text-sm tracking-widest hover:text-[#FF6636] transition-colors\" data-kid=\"2-1-1-2-2\" data-name=\"services navigation link\" href=\"#\">\n                    Services\n                </a>\n                <a class=\"font-bold uppercase text-sm tracking-widest hover:text-[#FF6636] transition-colors\" data-kid=\"2-1-1-2-3\" data-name=\"agency navigation link\" href=\"#\">\n                    Agency\n                </a>\n                <a class=\"font-bold uppercase text-sm tracking-widest hover:text-[#FF6636] transition-colors\" data-kid=\"2-1-1-2-4\" data-name=\"contact navigation link\" href=\"#\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-6\" data-kid=\"2-1-1-3\" data-name=\"header right-side actions container\">\n                <button class=\"flex items-center gap-2 text-white/40 hover:text-[#FF6636] transition-colors border-l border-white/10 pl-6 h-full py-4\" data-kid=\"2-1-1-3-1\" data-name=\"discovery search button\">\n                    <svg class=\"w-4 h-4\" data-kid=\"2-1-1-3-1-1\" data-name=\"magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\">\n                        </path>\n                    </svg>\n                    <span class=\"text-[10px] font-black uppercase tracking-[0.2em] hidden sm:inline\" data-kid=\"2-1-1-3-1-2\" data-name=\"discovery search label text\">\n                        Discovery\n                    </span>\n                </button>\n                <a class=\"bg-[#FF6636] text-black px-6 py-2 font-black uppercase text-xs tracking-widest hover:bg-white transition-colors border-2 border-[#FF6636]\" data-kid=\"2-1-1-3-2\" data-name=\"start project call-to-action button\" href=\"#\">\n                    Start Project\n                </a>\n            </div>\n        </div>\n    </header>\n    <main class=\"pt-32\" data-kid=\"2-2\" data-name=\"main content area\">\n        <!-- Hero Section -->\n        <section class=\"max-w-[1440px] mx-auto px-6 py-20 relative overflow-hidden\" data-kid=\"2-2-1\" data-name=\"hero section container\">\n            <div class=\"relative z-10\" data-kid=\"2-2-1-1\" data-name=\"hero text content wrapper\">\n                <h1 class=\"text-[clamp(4rem,12vw,12rem)] font-black uppercase leading-[0.85] tracking-tighter\" data-kid=\"2-2-1-1-1\" data-name=\"hero headline text\" id=\"hero-text\">\n                    Proof, in\n                    <br data-kid=\"2-2-1-1-1-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#FF6636]\" data-kid=\"2-2-1-1-1-2\" data-name=\"hero headline accent text\">\n                        the work.\n                    </span>\n                </h1>\n                <div class=\"mt-12 flex flex-col sm:flex-row sm:items-end gap-6 sm:gap-12\" data-kid=\"2-2-1-1-2\" data-name=\"hero stats and description wrapper\" id=\"hero-count\">\n                    <div class=\"flex items-end gap-4\" data-kid=\"2-2-1-1-2-1\" data-name=\"hero stat counter container\">\n                        <span class=\"text-8xl sm:text-[12rem] font-black leading-none text-[#FF6636]\" data-kid=\"2-2-1-1-2-1-1\" data-name=\"hero stat number text\">\n                            48\n                        </span>\n                        <div class=\"mb-4 sm:mb-8\" data-kid=\"2-2-1-1-2-1-2\" data-name=\"hero stat label container\">\n                            <span class=\"block text-xl sm:text-3xl font-black uppercase leading-tight\" data-kid=\"2-2-1-1-2-1-2-1\" data-name=\"hero stat description text\">\n                                Launches\n                                <br data-kid=\"2-2-1-1-2-1-2-1-1\" data-name=\"stat description line break\"/>\n                                Executed\n                            </span>\n                        </div>\n                    </div>\n                    <p class=\"max-w-md text-white/50 text-lg sm:text-xl font-medium mb-4 sm:mb-8 leading-relaxed\" data-kid=\"2-2-1-1-2-2\" data-name=\"hero descriptive paragraph\">\n                        From architecture to algorithms. We build digital ecosystems that don't just look pretty—they dominate.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <!-- Filter Chips -->\n        <section class=\"max-w-[1440px] mx-auto px-6 mb-40\" data-kid=\"2-2-2\" data-name=\"work filter chips section\">\n            <div class=\"flex gap-4 overflow-x-auto pb-6 no-scrollbar\" data-kid=\"2-2-2-1\" data-name=\"filter chips list container\" id=\"filters\">\n                <button class=\"px-10 py-4 bg-[#FF6636] text-black font-black uppercase shrink-0 brutalist-border border-white tracking-widest text-xs\" data-kid=\"2-2-2-1-1\" data-name=\"all work filter button\">\n                    All Work\n                </button>\n                <button class=\"px-10 py-4 brutalist-border border-white/20 text-white/40 font-black uppercase shrink-0 transition-all hover:border-white hover:text-white text-xs tracking-widest\" data-kid=\"2-2-2-1-2\" data-name=\"ui/ux filter button\">\n                    UI/UX\n                </button>\n                <button class=\"px-10 py-4 brutalist-border border-white/20 text-white/40 font-black uppercase shrink-0 transition-all hover:border-white hover:text-white text-xs tracking-widest\" data-kid=\"2-2-2-1-3\" data-name=\"branding filter button\">\n                    Branding\n                </button>\n                <button class=\"px-10 py-4 brutalist-border border-white/20 text-white/40 font-black uppercase shrink-0 transition-all hover:border-white hover:text-white text-xs tracking-widest\" data-kid=\"2-2-2-1-4\" data-name=\"graphics filter button\">\n                    Graphics\n                </button>\n                <button class=\"px-10 py-4 brutalist-border border-white/20 text-white/40 font-black uppercase shrink-0 transition-all hover:border-white hover:text-white text-xs tracking-widest\" data-kid=\"2-2-2-1-5\" data-name=\"social filter button\">\n                    Social\n                </button>\n                <button class=\"px-10 py-4 brutalist-border border-white/20 text-white/40 font-black uppercase shrink-0 transition-all hover:border-white hover:text-white text-xs tracking-widest\" data-kid=\"2-2-2-1-6\" data-name=\"video filter button\">\n                    Video\n                </button>\n            </div>\n        </section>\n        <!-- Collage Section -->\n        <section class=\"relative min-h-[140vh] px-6 py-20\" data-kid=\"2-2-3\" data-name=\"portfolio collage section\" id=\"collage-container\">\n            <div class=\"max-w-[1440px] mx-auto relative h-full flex flex-col gap-24 lg:block\" data-kid=\"2-2-3-1\" data-name=\"collage items container\">\n                <!-- Frame 1: Editorial Architecture -->\n                <div class=\"collage-item parallax-item lg:absolute top-0 left-0 w-full lg:w-[46%] brutalist-border bg-[#2A2A29] z-10 rotate-[-2deg] group\" data-kid=\"2-2-3-1-1\" data-name=\"editorial architecture card\" data-speed=\"0.1\">\n                    <img alt=\"Architecture Editorial\" class=\"w-full aspect-[16/10] object-cover grayscale group-hover:grayscale-0 transition-all duration-700\" data-kid=\"2-2-3-1-1-1\" data-name=\"editorial architecture project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&w=1200&q=80&fit=crop\"/>\n                    <div class=\"p-8\" data-kid=\"2-2-3-1-1-2\" data-name=\"editorial architecture card content wrapper\">\n                        <div class=\"flex justify-between items-start mb-6\" data-kid=\"2-2-3-1-1-2-1\" data-name=\"editorial architecture header wrapper\">\n                            <div data-kid=\"2-2-3-1-1-2-1-1\" data-name=\"editorial architecture category and title wrapper\">\n                                <span class=\"text-[#FF6636] font-black uppercase text-xs tracking-widest\" data-kid=\"2-2-3-1-1-2-1-1-1\" data-name=\"editorial architecture category label\">\n                                    Editorial / Architecture\n                                </span>\n                                <h3 class=\"text-4xl font-black uppercase mt-2\" data-kid=\"2-2-3-1-1-2-1-1-2\" data-name=\"editorial architecture project title\">\n                                    Skyline Nexus\n                                </h3>\n                            </div>\n                            <div class=\"w-12 h-12 brutalist-border flex items-center justify-center group-hover:bg-[#FF6636] transition-colors\" data-kid=\"2-2-3-1-1-2-1-2\" data-name=\"editorial architecture arrow button\">\n                                <svg class=\"w-6 h-6 group-hover:text-black\" data-kid=\"2-2-3-1-1-2-1-2-1\" data-name=\"arrow icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M14 5l7 7m0 0l-7 7m7-7H3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                                    </path>\n                                </svg>\n                            