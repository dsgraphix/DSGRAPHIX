nfigurator section\">\n            <div class=\"bg-white rounded-xl thin-border soft-elevation flex flex-col lg:flex-row overflow-hidden\" data-kid=\"1-2-6-1\" data-name=\"configurator container\">\n                <div class=\"flex-1 p-12 lg:p-20 space-y-16\" data-kid=\"1-2-6-1-1\" data-name=\"wizard column\">\n                    <div class=\"space-y-6\" data-kid=\"1-2-6-1-1-1\" data-name=\"header area\">\n                        <h2 class=\"text-5xl lg:text-7xl font-black tracking-tighter leading-none\" data-kid=\"1-2-6-1-1-1-1\" data-name=\"wizard title\">\n                            Map your system.\n                        </h2>\n                        <p class=\"text-xl text-[var(--color-text)]/50\" data-kid=\"1-2-6-1-1-1-2\" data-name=\"wizard description\">\n                            Initialize your project parameters to receive a formal system audit proposal.\n                        </p>\n                    </div>\n                    <div class=\"space-y-12\" data-kid=\"1-2-6-1-1-2\" data-name=\"steps container\">\n                        <!-- Step 01 -->\n                        <div class=\"grid grid-cols-1 md:grid-cols-4 gap-8\" data-kid=\"1-2-6-1-1-2-1\" data-name=\"objective step row\">\n                            <div class=\"md:col-span-1\" data-kid=\"1-2-6-1-1-2-1-1\" data-name=\"step title container\">\n                                <span class=\"text-[10px] font-black uppercase tracking-widest opacity-30\" data-kid=\"1-2-6-1-1-2-1-1-1\" data-name=\"step title\">\n                                    01 / Objective\n                                </span>\n                            </div>\n                            <div class=\"md:col-span-3 flex flex-wrap gap-3\" data-kid=\"1-2-6-1-1-2-1-2\" data-name=\"step choice container\">\n                                <button class=\"bg-[var(--color-accent)] text-white px-6 py-2 rounded-lg text-xs font-black uppercase tracking-widest border-none cursor-pointer\" data-kid=\"1-2-6-1-1-2-1-2-1\